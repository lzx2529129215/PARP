    "max_downgrade_tiers": [1],
    "special_native_protect_mutable": false,
    "strong_native_tier_protect_mutable": false
  },
  "experiment_groups": [
    { "id": "A", "mode": "OFF", "execution": "PLAN_ONLY", "requires_explicit_authorization": true },
    { "id": "B", "mode": "SHADOW_EFFECTIVE_TIER", "execution": "PLAN_ONLY", "requires_explicit_authorization": true },
    { "id": "C", "mode": "APPLY_PROTECT_ONLY", "execution": "PLAN_ONLY", "requires_explicit_authorization": true },
    { "id": "D", "mode": "APPLY_BIDIRECTIONAL", "execution": "PLAN_ONLY", "requires_explicit_authorization": true },
    { "id": "E", "mode": "APPLY_RANDOM_MATCHED", "execution": "PLAN_ONLY", "requires_explicit_authorization": true },
    { "id": "F", "mode": "APPLY_RECENCY_BASELINE", "execution": "PLAN_ONLY", "requires_explicit_authorization": true },
    { "id": "G", "mode": "PRODUCT_ABLATION", "execution": "PLAN_ONLY", "requires_explicit_authorization": true },
    { "id": "H", "mode": "ORACLE_OFFLINE_ONLY", "execution": "PLAN_ONLY", "requires_explicit_authorization": false }
  ],
  "comparisons": [
    { "left": "C", "right": "A", "question": "Does protect-only beat Native?" },
    { "left": "D", "right": "C", "question": "Does conservative downgrade improve reclaim without extra mistakes?" },
    { "left": "D", "right": "E", "question": "Does the model beat matched random decisions?" },
    { "left": "D", "right": "F", "question": "Does the full model beat recency?" },
    { "left": "D", "right": "G", "question": "Does additive effective tier beat calibrated product gating?" }
  ],
  "pressure_levels": [
    { "id": "P0", "purpose": "near-zero reclaim; plan only", "formal_benefit_run": false },
    { "id": "P1", "purpose": "light reclaim; plan only", "formal_benefit_run": false },
    { "id": "P2", "purpose": "stable reclaim; plan only", "formal_benefit_run": true },
    { "id": "P3", "purpose": "sustained controlled reclaim; plan only", "formal_benefit_run": true },
    { "id": "P4", "purpose": "stop-boundary discovery only; plan only", "formal_benefit_run": false }
  ],
  "workloads": ["WPS", "FILES", "QQ"],
  "repetitions": {
    "minimum": 5,
    "recommended": 10,
    "paired": true,
    "randomized_or_interleaved": true,
    "same_kernel_script_initial_state_cgroup_pressure_time_seed": true,
    "restore_stable_state_between_runs": true
  },
  "gates": {
    "protect_only": [
      "at least four complete SHADOW sessions per App",
      "trace_lost measured and acceptable",
      "upgrade hit rate exceeds KEEP_RECLAIM reuse rate",
      "not weaker than Recent+Frequency",
      "lru_lock and direct-reclaim tails acceptable",
      "runtime KUnit passed"
