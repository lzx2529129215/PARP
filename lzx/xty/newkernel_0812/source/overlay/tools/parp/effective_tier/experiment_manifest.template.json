    "bidirectional": [
      "protect-only gate passed",
      "enough native-protected boundary candidates",
      "downgrade reuse below KEEP_PROTECT across sessions",
      "cold threshold not dominated by one App",
      "downgrade mistake confidence interval acceptable",
      "zero special-native-protect overrides"
    ]
  },
  "stop_conditions": [
    "OOM or oom_kill",
    "severe PSI or no-progress regression",
    "unexpected cgroup or mode state",
    "trace-loss or tier-gate coverage failure",
    "special native protection override",
    "App failure, timeout, or unacceptable P95/P99 regression"
