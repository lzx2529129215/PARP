-static int mglru_dual_handle_runtime_mode(int argc, char **argv)
-{
-	enum mglru_markov_runtime_mode mode;
-
-	if (argc != 1)
-		return -EINVAL;
-	if (!strcmp(argv[0], "disabled"))
-		mode = MGLRU_MARKOV_RUNTIME_DISABLED;
-	else if (!strcmp(argv[0], "legacy"))
-		mode = MGLRU_MARKOV_RUNTIME_LEGACY;
-	else if (!strcmp(argv[0], "dual"))
-		mode = MGLRU_MARKOV_RUNTIME_DUAL;
-	else if (!strcmp(argv[0], "both_observe"))
-		mode = MGLRU_MARKOV_RUNTIME_BOTH_OBSERVE;
-	else
-		return -EINVAL;
-
-	spin_lock(&mglru_workload_markov_lock);
-	mglru_markov_runtime_mode = mode;
-	spin_unlock(&mglru_workload_markov_lock);
-	return 0;
-}
