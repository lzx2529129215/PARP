-void tier2_wmark_update_ewma(struct pglist_data *pgdat)
-{
-	int nid = pgdat->node_id;
-	unsigned long free_pages, prev_ewma;
-
-	if (!tier2_wmark_enabled() || !tier2_wmark_nodes)
