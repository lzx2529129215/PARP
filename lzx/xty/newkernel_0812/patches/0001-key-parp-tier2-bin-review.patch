-static unsigned long mglru_lstm_ttl_remaining_ms(unsigned long updated_at,
-						 unsigned long ttl_ms)
-{
-	unsigned long expires = updated_at + msecs_to_jiffies(ttl_ms);
-
-	return time_after(expires, jiffies) ?
-		jiffies_to_msecs(expires - jiffies) : 0;
-}
