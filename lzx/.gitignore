# Python and locally built helpers
__pycache__/
*.py[cod]
runtime_monitor/tools/parp_memory_ballast

# Runtime captures, generated reports, caches, and downloaded application bundles
/outputs/
/cache_ext/
/tools/
/mem/
/samples/
/local_runtime_assets/

# Training data, checkpoints, and generated model results are reproducible assets,
# not Git source.  Keep model/training code under operation_predictor/ tracked.
operation_predictor/data/
operation_predictor/outputs/

# Linux 6.17.13 is obtained separately.  Version the PARP patch, build manifest,
# configuration, tests, and wrapper tooling, but never the source tarball/build tree.
v4.1-parp/kernel/downloads/
v4.1-parp/kernel/build/
v4.1-parp/kernel/src/
v4.1-parp/outputs/

# Legacy local kernel trees are retained only in the old workspace during migration.
/MGLRU-test/

# Relocated user-space workspace payloads.
/tool/outputs/
/tool/mem/
/tool/operation_predictor/data/
/tool/operation_predictor/outputs/

# Kernel source trees and generated build outputs stay local.  Versioned
# releases under kernel/his and kernel/v4.2 contain patches/configs only.  # lzx-note
/kernel/src/
/kernel/build/

# Runtime-monitor service captures are generated on the running machine.  # lzx-note
/service/outputs/
