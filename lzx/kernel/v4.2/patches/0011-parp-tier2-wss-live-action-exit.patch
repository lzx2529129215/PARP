diff --git a/mm/parp/core/watermark.c b/mm/parp/core/watermark.c
index 3211f1b53..70785f62c 100644
--- a/mm/parp/core/watermark.c
+++ b/mm/parp/core/watermark.c
@@ -412,6 +412,29 @@ enum parp_tier2_wss_action parp_tier2_workingset_guard_action(
 	return action;
 } /* lzx-note */
 
+enum parp_tier2_wss_action parp_tier2_workingset_effective_action(
+		enum parp_tier2_wss_action policy_action,
+		enum parp_tier2_wss_action live_action,
+		u64 headroom_bytes, u64 demote_wmark_bytes)
+{
+	/*
+	 * Two prediction generations are still required to enter RELAX or
+	 * STRENGTHEN, but a confirmed action must not become sticky while live
+	 * headroom changes. Exit either exceptional action immediately when the
+	 * same prediction no longer justifies it. NORMAL cannot become more
+	 * aggressive without a new generation passing hysteresis. lzx-note
+	 */
+	if (policy_action == PARP_TIER2_WSS_STRENGTHEN &&
+	    live_action != PARP_TIER2_WSS_STRENGTHEN)
+		policy_action = PARP_TIER2_WSS_NORMAL;
+	else if (policy_action == PARP_TIER2_WSS_RELAX &&
+		 live_action != PARP_TIER2_WSS_RELAX)
+		policy_action = PARP_TIER2_WSS_NORMAL;
+
+	return parp_tier2_workingset_guard_action(policy_action,
+			headroom_bytes, demote_wmark_bytes);
+} /* lzx-note */
+
 u64 parp_tier2_workingset_demote_wmark(u64 limit_bytes,
 		u64 alloc_wmark_bytes, u64 demote_wmark_bytes,
 		u64 predicted_workingset_bytes, u64 predicted_resident_bytes,
@@ -468,6 +491,7 @@ static void parp_tier2_workingset_update_locked(
 		state->workingset_prediction_generation = 0;
 		state->workingset_confidence_q15 = 0;
 		state->workingset_raw_action = PARP_TIER2_WSS_FALLBACK;
+		state->workingset_policy_action = PARP_TIER2_WSS_FALLBACK;
 		state->workingset_action = PARP_TIER2_WSS_FALLBACK;
 		state->workingset_action_streak = 0;
 		return;
@@ -497,7 +521,7 @@ static void parp_tier2_workingset_update_locked(
 			action = PARP_TIER2_WSS_NORMAL;
 			atomic64_inc(&state->workingset_hysteresis_holds);
 		}
-		state->workingset_action = action;
+		state->workingset_policy_action = action; /* lzx-note */
 		if (action == PARP_TIER2_WSS_STRENGTHEN)
 			atomic64_inc(&state->workingset_strengthen);
 		else if (action == PARP_TIER2_WSS_RELAX)
@@ -515,18 +539,21 @@ static void parp_tier2_workingset_update_locked(
 	state->predicted_growth_bytes = prediction->predicted_workingset_bytes -
 		prediction->predicted_resident_bytes;
 	state->workingset_confidence_q15 = prediction->confidence_q15;
+	action = parp_tier2_workingset_effective_action(
+		state->workingset_policy_action, raw, headroom, demote); /* lzx-note */
+	if (action != state->workingset_action) {
+		if (action != state->workingset_policy_action)
+			atomic64_inc(&state->workingset_safety_overrides);
+		else if (!new_generation && state->workingset_action !=
+			 state->workingset_policy_action)
+			atomic64_inc(&state->workingset_live_restores);
+		state->workingset_action = action; /* lzx-note */
+	}
 	state->effective_demote_wmark_bytes =
 		parp_tier2_workingset_demote_wmark(limit, alloc, demote,
 			prediction->predicted_workingset_bytes,
 			prediction->predicted_resident_bytes,
 			state->workingset_action);
-	action = parp_tier2_workingset_guard_action(
-		state->workingset_action, headroom, demote); /* lzx-note */
-	if (action != state->workingset_action) {
-		state->workingset_action = action; /* lzx-note */
-		state->effective_demote_wmark_bytes = demote; /* lzx-note */
-		atomic64_inc(&state->workingset_safety_overrides); /* lzx-note */
-	}
 } /* lzx-note */
 #endif /* CONFIG_PARP_TIER2_WSS_PREDICT */
 
