+static void parp_atomic_prediction_state_test(struct kunit *test) /* lzx-note */
+{
+	u64 now = ktime_get_mono_fast_ns();
+	struct parp_app_prior_batch batch = {
+		.schema_version = PARP_APP_PRIOR_BATCH_SCHEMA,
+		.model_version = 401,
+		.prediction_generation = 300,
+		.timestamp_ns = now,
+		.horizon_ns = 180 * NSEC_PER_SEC,
+		.expiry_ns = now + 180 * NSEC_PER_SEC,
+		.nr_entries = 2,
+		.entries = {
+			{ .app_id = 1, .use_score_q15 = PARP_Q15_ONE, .rank = 1,
+			  .foreground = true, .valid = true },
+			{ .app_id = 3, .use_score_q15 = 12000, .rank = 2,
+			  .valid = true },
+		},
+	};
+	struct parp_binding bindings[2] = {
+		{
+			.domain_id = 1001, .app_id = 1, .bind_generation = 300,
+			.updated_ns = now, .expires_ns = batch.expiry_ns,
+			.epoch_id = 77, .model_version = 401, .active = true,
+		},
+		{
+			.domain_id = 1002, .app_id = 3, .bind_generation = 300,
+			.updated_ns = now, .expires_ns = batch.expiry_ns,
+			.epoch_id = 77, .model_version = 401, .active = true,
+		},
+	};
+	const struct parp_snapshot *snapshot;
+
+	KUNIT_ASSERT_EQ(test,
+		parp_snapshot_replace_state(&batch, bindings, 2), 0);
+	snapshot = parp_snapshot_acquire();
+	KUNIT_ASSERT_NOT_NULL(test, snapshot);
+	KUNIT_EXPECT_EQ(test, snapshot->prediction_generation, 300U);
+	KUNIT_EXPECT_EQ(test, snapshot->nr_priors, 2U);
+	KUNIT_EXPECT_EQ(test, snapshot->nr_bindings, 2U);
+	KUNIT_EXPECT_EQ(test, snapshot->bindings[1].app_id, 3U);
+	parp_snapshot_release();
+
+	bindings[1].domain_id = bindings[0].domain_id;
+	batch.prediction_generation++;
+	KUNIT_EXPECT_EQ(test,
+		parp_snapshot_replace_state(&batch, bindings, 2), -EINVAL);
+	snapshot = parp_snapshot_acquire();
+	KUNIT_ASSERT_NOT_NULL(test, snapshot);
+	KUNIT_EXPECT_EQ(test, snapshot->prediction_generation, 300U);
+	parp_snapshot_release();
+}
