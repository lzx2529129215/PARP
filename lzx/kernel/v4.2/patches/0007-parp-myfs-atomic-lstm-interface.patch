@@ -0,0 +1,212 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/compat.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/overflow.h>
+#include <linux/parp_predict.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include "../internal.h"
+
+static int parp_predict_validate_header(const struct parp_predict_state_v1 *state)
+{
+	unsigned int i;
+
+	if (state->abi_version != PARP_PREDICT_ABI_VERSION ||
+	    state->struct_size != sizeof(*state) || state->flags ||
+	    state->schema_version != PARP_APP_PRIOR_BATCH_SCHEMA ||
+	    !state->model_version || !state->generation ||
+	    !state->nr_predictions ||
+	    state->nr_predictions > PARP_PREDICT_MAX_APPS ||
+	    state->nr_bindings > PARP_PREDICT_MAX_BINDINGS ||
+	    !state->timestamp_ns || !state->horizon_ns || !state->ttl_ns)
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(state->reserved); i++)
+		if (state->reserved[i])
+			return -EINVAL;
+	if (state->ttl_ns > PARP_APP_PRIOR_MAX_TTL_NS ||
+	    state->horizon_ns > PARP_APP_PRIOR_MAX_HORIZON_NS)
+		return -ERANGE;
+	return 0;
+}
+
+/* lzx-note: Translate the stable UAPI into the internal immutable snapshot. */
+static int parp_predict_set_state(void __user *argp)
+{
+	struct parp_predict_state_v1 *state;
+	struct parp_app_prior_batch *batch;
+	struct parp_binding *bindings;
+	u64 expiry_ns;
+	unsigned int i;
+	int error;
+
+	state = memdup_user(argp, sizeof(*state));
+	if (IS_ERR(state))
+		return PTR_ERR(state);
+	error = parp_predict_validate_header(state);
+	if (error)
+		goto out_state;
+	if (check_add_overflow(state->timestamp_ns, state->ttl_ns, &expiry_ns)) {
+		error = -EOVERFLOW;
+		goto out_state;
+	}
+
+	batch = kzalloc(sizeof(*batch), GFP_KERNEL);
+	bindings = kcalloc(state->nr_bindings, sizeof(*bindings), GFP_KERNEL);
+	if (!batch || (state->nr_bindings && !bindings)) {
+		error = -ENOMEM;
+		goto out_alloc;
+	}
+	batch->schema_version = state->schema_version;
+	batch->model_version = state->model_version;
+	batch->prediction_generation = state->generation;
+	batch->timestamp_ns = state->timestamp_ns;
+	batch->horizon_ns = state->horizon_ns;
+	batch->expiry_ns = expiry_ns;
+	batch->nr_entries = state->nr_predictions;
+	for (i = 0; i < state->nr_predictions; i++) {
+		const struct parp_predict_entry_v1 *source =
+			&state->predictions[i];
+
+		if (source->reserved ||
+		    source->flags & ~PARP_PREDICT_ENTRY_FOREGROUND) {
+			error = -EINVAL;
+			goto out_alloc;
+		}
+		batch->entries[i].app_id = source->app_id;
+		batch->entries[i].use_score_q15 = source->score_q15;
+		batch->entries[i].rank = source->rank;
+		batch->entries[i].foreground =
+			!!(source->flags & PARP_PREDICT_ENTRY_FOREGROUND);
+		batch->entries[i].valid = true;
+	}
+	for (i = 0; i < state->nr_bindings; i++) {
+		const struct parp_predict_binding_v1 *source =
+			&state->bindings[i];
+
+		if (source->reserved ||
+		    source->flags != PARP_PREDICT_BINDING_ACTIVE) {
+			error = -EINVAL;
+			goto out_alloc;
+		}
+		bindings[i] = (struct parp_binding) {
+			.domain_id = source->domain_id,
+			.app_id = source->app_id,
+			.bind_generation = state->generation,
+			.updated_ns = state->timestamp_ns,
+			.expires_ns = expiry_ns,
+			.epoch_id = source->epoch_id,
+			.model_version = state->model_version,
+			.active = true,
+		};
+	}
+	error = parp_snapshot_replace_state(batch, bindings,
+					    state->nr_bindings);
+out_alloc:
+	kfree(bindings);
+	kfree(batch);
+out_state:
+	kfree(state);
+	return error;
+}
+
+static int parp_predict_get_state(void __user *argp)
+{
+	const struct parp_snapshot *snapshot;
+	struct parp_predict_state_v1 *state;
+	unsigned int i;
+	int error = 0;
+
+	state = kzalloc(sizeof(*state), GFP_KERNEL);
+	if (!state)
+		return -ENOMEM;
+	state->abi_version = PARP_PREDICT_ABI_VERSION;
+	state->struct_size = sizeof(*state);
+
+	snapshot = parp_snapshot_acquire();
+	if (snapshot) {
+		state->schema_version = snapshot->prediction_schema_version;
+		state->model_version = snapshot->prediction_model_version;
+		state->generation = snapshot->prediction_generation;
+		state->timestamp_ns = snapshot->prediction_timestamp_ns;
+		state->horizon_ns = snapshot->prediction_horizon_ns;
+		if (snapshot->prediction_expiry_ns >
+		    snapshot->prediction_timestamp_ns)
+			state->ttl_ns = snapshot->prediction_expiry_ns -
+				snapshot->prediction_timestamp_ns;
+		state->nr_predictions = min_t(u32, snapshot->nr_priors,
+						 PARP_PREDICT_MAX_APPS);
+		state->nr_bindings = min_t(u32, snapshot->nr_bindings,
+					      PARP_PREDICT_MAX_BINDINGS);
+		for (i = 0; i < state->nr_predictions; i++) {
+			state->predictions[i].app_id = snapshot->priors[i].app_id;
+			state->predictions[i].score_q15 =
+				snapshot->priors[i].use_score_q15;
+			state->predictions[i].rank = snapshot->priors[i].rank;
+			if (snapshot->priors[i].foreground)
+				state->predictions[i].flags =
+					PARP_PREDICT_ENTRY_FOREGROUND;
+		}
+		for (i = 0; i < state->nr_bindings; i++) {
+			state->bindings[i].domain_id =
+				snapshot->bindings[i].domain_id;
+			state->bindings[i].app_id = snapshot->bindings[i].app_id;
+			state->bindings[i].epoch_id = snapshot->bindings[i].epoch_id;
+			if (snapshot->bindings[i].active)
+				state->bindings[i].flags =
+					PARP_PREDICT_BINDING_ACTIVE;
+		}
+	}
+	parp_snapshot_release();
+
+	if (copy_to_user(argp, state, sizeof(*state)))
+		error = -EFAULT;
+	kfree(state);
+	return error;
+}
+
+static long parp_predict_ioctl(struct file *file, unsigned int cmd,
+			       unsigned long arg)
+{
+	void __user *argp = (void __user *)arg;
+
+	switch (cmd) {
+	case PARP_PREDICT_SET_STATE:
+		return parp_predict_set_state(argp);
+	case PARP_PREDICT_GET_STATE:
+		return parp_predict_get_state(argp);
+	default:
+		return -ENOTTY;
+	}
+}
+
+static const struct file_operations parp_predict_fops = {
+	.owner = THIS_MODULE,
+	.open = nonseekable_open,
+	.unlocked_ioctl = parp_predict_ioctl,
+	.compat_ioctl = compat_ptr_ioctl,
+	.llseek = noop_llseek,
+};
+
+static struct miscdevice parp_predict_device = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "myfs",
+	.fops = &parp_predict_fops,
+	.mode = 0660,
+};
+
+static int __init parp_predict_dev_init(void)
+{
+	int error = misc_register(&parp_predict_device);
+
+	if (error)
+		pr_err("PARP: failed to register /dev/myfs: %d\n", error);
+	else
+		pr_info("PARP: /dev/myfs prediction interface ABI v%u ready\n",
+			PARP_PREDICT_ABI_VERSION);
+	return error;
+}
+device_initcall(parp_predict_dev_init); /* lzx-note: misc class must exist first. */
diff --git a/tools/parp/test_prediction_interfaces.sh b/tools/parp/test_prediction_interfaces.sh
new file mode 100755
index 000000000..5c95d0dd0
--- /dev/null
+++ b/tools/parp/test_prediction_interfaces.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+kernel_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+temp_root="$(mktemp -d --tmpdir parp-uapi.XXXXXX)"
+binary="$temp_root/uapi-layout"
+trap 'case "$temp_root" in /tmp/parp-uapi.*) rm -rf -- "$temp_root" ;; esac' EXIT
+
+# lzx-note: Prediction writes must be exposed only through parp/myfs.
+make -s -C "$kernel_root" O="$temp_root/build" headers_install \
+  INSTALL_HDR_PATH="$temp_root/headers"
+cc -Wall -Wextra -Werror -I"$temp_root/headers/include" \
+  "$kernel_root/tools/parp/uapi_layout_check.c" -o "$binary"
+"$binary"
+
+debugfs_root="${PARP_DEBUGFS_ROOT:-/sys/kernel/debug/parp}"
+for legacy in app_prior app_prior_batch app_bind; do
+  if [[ -e "$debugfs_root/$legacy" ]]; then
+    echo "FAIL: legacy writable prediction node still exists: $debugfs_root/$legacy" >&2
+    exit 1
+  fi
+done
+
+if [[ -e /dev/myfs ]]; then
+  test -c /dev/myfs
+  echo "PASS: /dev/myfs is a character device"
+else
+  echo "SKIP: /dev/myfs is not present on the running (pre-update) kernel"
+fi
diff --git a/tools/parp/uapi_layout_check.c b/tools/parp/uapi_layout_check.c
new file mode 100644
index 000000000..3a76cce74
--- /dev/null
+++ b/tools/parp/uapi_layout_check.c
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <stddef.h>
+#include <stdio.h>
+#include <linux/parp_predict.h>
+
+/* lzx-note: Compile-time/userspace guard for Python ctypes ABI parity. */
+_Static_assert(sizeof(struct parp_predict_entry_v1) == 16, "entry ABI drift");
+_Static_assert(sizeof(struct parp_predict_binding_v1) == 32, "binding ABI drift");
+_Static_assert(sizeof(struct parp_predict_state_v1) == 2656, "state ABI drift");
+_Static_assert(offsetof(struct parp_predict_state_v1, predictions) == 96,
+	       "prediction offset drift");
+_Static_assert(offsetof(struct parp_predict_state_v1, bindings) == 608,
+	       "binding offset drift");
+
+int main(void)
+{
+	printf("abi=%u entry=%zu binding=%zu state=%zu set=0x%lx get=0x%lx\n",
+	       PARP_PREDICT_ABI_VERSION,
+	       sizeof(struct parp_predict_entry_v1),
+	       sizeof(struct parp_predict_binding_v1),
+	       sizeof(struct parp_predict_state_v1),
+	       (unsigned long)PARP_PREDICT_SET_STATE,
+	       (unsigned long)PARP_PREDICT_GET_STATE);
+	return 0;
+}
