diff --git a/Documentation/admin-guide/mm/parp-myfs.rst b/Documentation/admin-guide/mm/parp-myfs.rst
new file mode 100644
index 000000000..9ab9bf617
--- /dev/null
+++ b/Documentation/admin-guide/mm/parp-myfs.rst
@@ -0,0 +1,26 @@
+.. SPDX-License-Identifier: GPL-2.0
+
+PARP ``/dev/myfs`` prediction interface
+=========================================
+
+``CONFIG_PARP_MYFS`` creates the ``myfs`` misc character device.  It is the
+only supported userspace interface for application LSTM priors and cgroup
+bindings; PARP does not create the former writable ``app_prior``,
+``app_prior_batch`` or ``app_bind`` debugfs files.  Read-only debugfs counters
+remain available for experiment diagnosis.  ``lzx-note``
+
+The version-1 ABI is declared in ``include/uapi/linux/parp_predict.h``.  The
+``PARP_PREDICT_SET_STATE`` ioctl accepts a fixed-size, pointer-free structure
+containing up to 32 predictions and 64 cgroup bindings.  One ioctl validates
+the complete message and performs one RCU publication, so reclaim cannot see
+new probabilities paired with old ownership metadata.
+
+All timestamps use ``CLOCK_MONOTONIC`` nanoseconds.  Generations must increase,
+scores use unsigned Q15, ranks and application IDs must be unique, and every
+binding must refer to an application in the same prediction batch.  Invalid,
+expired, duplicate or stale updates fail without changing the active snapshot.
+
+``PARP_PREDICT_GET_STATE`` returns the current generation and state for service
+restart synchronization and diagnostics.  The recommended udev rule applies
+``TAG+=\"uaccess\"`` to give the active desktop user access without making the
+device world-writable.
diff --git a/include/uapi/linux/parp_predict.h b/include/uapi/linux/parp_predict.h
new file mode 100644
index 000000000..fc32048f3
--- /dev/null
+++ b/include/uapi/linux/parp_predict.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_LINUX_PARP_PREDICT_H
+#define _UAPI_LINUX_PARP_PREDICT_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+/* lzx-note: Versioned, pointer-free ABI for the /dev/myfs prediction sink. */
+#define PARP_PREDICT_ABI_VERSION	1U
+#define PARP_PREDICT_MAX_APPS	32U
+#define PARP_PREDICT_MAX_BINDINGS	64U
+
+#define PARP_PREDICT_ENTRY_FOREGROUND	(1U << 0)
+#define PARP_PREDICT_BINDING_ACTIVE	(1U << 0)
+
+struct parp_predict_entry_v1 {
+	__u32 app_id;
+	__u16 score_q15;
+	__u16 rank;
+	__u32 flags;
+	__u32 reserved;
+};
+
+struct parp_predict_binding_v1 {
+	__u64 domain_id;
+	__u32 app_id;
+	__u32 flags;
+	__u64 epoch_id;
+	__u64 reserved;
+};
+
+/*
+ * SET_STATE replaces predictions and bindings in one RCU publication.  All
+ * time values use CLOCK_MONOTONIC nanoseconds.  ttl_ns is relative to
+ * timestamp_ns; generation must increase for every accepted update.
+ */
+struct parp_predict_state_v1 {
+	__u32 abi_version;
+	__u32 struct_size;
+	__u32 schema_version;
+	__u32 model_version;
+	__u32 generation;
+	__u32 nr_predictions;
+	__u32 nr_bindings;
+	__u32 flags;
+	__u64 timestamp_ns;
+	__u64 horizon_ns;
+	__u64 ttl_ns;
+	__u64 reserved[5];
+	struct parp_predict_entry_v1 predictions[PARP_PREDICT_MAX_APPS];
+	struct parp_predict_binding_v1 bindings[PARP_PREDICT_MAX_BINDINGS];
+};
+
+#define PARP_PREDICT_IOC_MAGIC	0xb7
+#define PARP_PREDICT_SET_STATE	_IOW(PARP_PREDICT_IOC_MAGIC, 1, \
+				     struct parp_predict_state_v1)
+#define PARP_PREDICT_GET_STATE	_IOR(PARP_PREDICT_IOC_MAGIC, 2, \
+				     struct parp_predict_state_v1)
+
+#endif /* _UAPI_LINUX_PARP_PREDICT_H */
