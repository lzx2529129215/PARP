+enum parp_tier2_wss_action parp_tier2_workingset_apply_policy(
+		enum parp_tier2_wss_action policy_action,
+		bool strengthen_enabled)
+{
+	/* Keep STRENGTHEN observable as a prediction decision, but do not let an
+	 * unvalidated page selector raise the reclaim watermark unless its own
+	 * APPLY switch is explicitly enabled. lzx-note
+	 */
+	if (policy_action == PARP_TIER2_WSS_STRENGTHEN &&
+	    !strengthen_enabled)
+		return PARP_TIER2_WSS_NORMAL;
+
+	return policy_action;
