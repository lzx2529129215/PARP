+u64 parp_tier2_scaled_wmark(u64 limit_bytes, u32 scale, u64 floor)
+{
+	u64 scaled;
+
+	if (!limit_bytes || !scale)
+		return 0;
+
+	scaled = mul_u64_u32_div(limit_bytes, scale,
+				 PARP_TIER2_SCALE_BASE);
+	return max(scaled, floor);
+}
+
+u64 parp_tier2_ewma_next(u64 previous, u64 sample)
+{
+	u64 quotient;
+	u64 remainder;
+
+	/* Exact floor((previous * 15 + sample) / 16), without overflow. */
+	quotient = (previous >> 4) * 15 + (sample >> 4);
+	remainder = (previous & 15) * 15 + (sample & 15);
+	return quotient + (remainder >> 4);
+}
+
+s64 parp_tier2_predict_ms(u64 previous_ewma, u64 ewma, u64 headroom,
+			  u64 demote_wmark, u64 elapsed_ms)
+{
+	u64 delta, remaining, predicted;
+
+	if (headroom <= demote_wmark)
+		return 0;
+	if (!elapsed_ms || ewma >= previous_ewma)
+		return -1;
+
+	delta = previous_ewma - ewma;
+	remaining = headroom - demote_wmark;
+	predicted = mul_u64_u64_div_u64(remaining, elapsed_ms, delta);
+	return min_t(u64, predicted, S64_MAX);
+}
+
+static u64 parp_tier2_limit_bytes(struct mem_cgroup *memcg)
+{
+	u64 pages = READ_ONCE(memcg->memory.max);
+
+	if (pages == PAGE_COUNTER_MAX || pages > (U64_MAX >> PAGE_SHIFT))
+		return U64_MAX;
+	return pages << PAGE_SHIFT;
+}
+
+static u64 parp_tier2_usage_bytes(struct mem_cgroup *memcg)
+{
+	u64 pages = page_counter_read(&memcg->memory);
+
+	if (pages > (U64_MAX >> PAGE_SHIFT))
+		return U64_MAX;
+	return pages << PAGE_SHIFT;
+}
+
+static u64 parp_tier2_headroom(u64 limit, u64 usage)
+{
+	if (limit == U64_MAX)
+		return U64_MAX;
+	return usage >= limit ? 0 : limit - usage;
+}
+
+static void parp_tier2_watermarks(u64 limit, u32 alloc_scale,
+				  u32 demote_scale, u64 *alloc, u64 *demote)
+{
+	if (!limit || limit == U64_MAX) {
+		*alloc = 0;
+		*demote = 0;
+		return;
+	}
+
+	*alloc = parp_tier2_scaled_wmark(limit, alloc_scale, PAGE_SIZE);
+	*demote = max(*alloc, parp_tier2_scaled_wmark(limit, demote_scale,
+						      PAGE_SIZE));
+}
+
+enum parp_tier2_wss_action parp_tier2_workingset_action(u64 limit_bytes,
+		u64 alloc_wmark_bytes, u64 demote_wmark_bytes,
+		u64 headroom_bytes,
+		u64 predicted_workingset_bytes, u64 predicted_resident_bytes,
+		u16 confidence_q15)
+{
+	u64 predicted_headroom;
+	u64 predicted_growth;
+	u64 usage_wmark;
+
+	if (!limit_bytes || limit_bytes == U64_MAX ||
+	    !alloc_wmark_bytes || !demote_wmark_bytes ||
+	    headroom_bytes == U64_MAX ||
+	    !predicted_workingset_bytes ||
+	    predicted_resident_bytes > predicted_workingset_bytes ||
+	    confidence_q15 < PARP_TIER2_WSS_MIN_CONFIDENCE_Q15)
+		return PARP_TIER2_WSS_FALLBACK;
+
+	predicted_growth = predicted_workingset_bytes -
+		predicted_resident_bytes;
+	usage_wmark = limit_bytes > demote_wmark_bytes ?
+		limit_bytes - demote_wmark_bytes : 0;
+
+	/* Strengthen only if the projected allocation would consume the hard
+	 * reserve.  Comparing growth only with the static demote watermark caused
+	 * false strengthening even with several GiB of live headroom. lzx-note
+	 */
+	if (predicted_workingset_bytes > usage_wmark ||
+	    headroom_bytes <= alloc_wmark_bytes ||
+	    predicted_growth >= headroom_bytes - alloc_wmark_bytes)
+		return PARP_TIER2_WSS_STRENGTHEN;
+	predicted_headroom = headroom_bytes - predicted_growth; /* lzx-note */
+
+	/* When the future working set is already resident and needs at most the
+	 * hard allocation reserve, relax only if the projected headroom still
+	 * stays above the configured proactive line. lzx-note
+	 */
+	if (predicted_growth <= alloc_wmark_bytes &&
+	    predicted_headroom >= demote_wmark_bytes)
+		return PARP_TIER2_WSS_RELAX;
+
+	return PARP_TIER2_WSS_NORMAL;
+} /* lzx-note */
+
+enum parp_tier2_wss_action parp_tier2_workingset_guard_action(
+		enum parp_tier2_wss_action action, u64 headroom_bytes,
+		u64 demote_wmark_bytes)
+{
+	/* RELAX may suppress speculative work while headroom is comfortable,
+	 * but it must not move reclaim from Tier2 into the allocating task after
+	 * the original proactive line has already been crossed. lzx-note
+	 */
+	if (action == PARP_TIER2_WSS_RELAX && demote_wmark_bytes &&
+	    headroom_bytes <= demote_wmark_bytes)
+		return PARP_TIER2_WSS_NORMAL;
+
+	return action;
+} /* lzx-note */
+
+enum parp_tier2_wss_action parp_tier2_workingset_effective_action(
+		enum parp_tier2_wss_action policy_action,
+		enum parp_tier2_wss_action live_action,
+		u64 headroom_bytes, u64 demote_wmark_bytes)
+{
+	/*
+	 * Two prediction generations are still required to enter RELAX or
+	 * STRENGTHEN, but a confirmed action must not become sticky while live
+	 * headroom changes. Exit either exceptional action immediately when the
+	 * same prediction no longer justifies it. NORMAL cannot become more
+	 * aggressive without a new generation passing hysteresis. lzx-note
+	 */
+	if (policy_action == PARP_TIER2_WSS_STRENGTHEN &&
+	    live_action != PARP_TIER2_WSS_STRENGTHEN)
+		policy_action = PARP_TIER2_WSS_NORMAL;
+	else if (policy_action == PARP_TIER2_WSS_RELAX &&
+		 live_action != PARP_TIER2_WSS_RELAX)
+		policy_action = PARP_TIER2_WSS_NORMAL;
+
+	return parp_tier2_workingset_guard_action(policy_action,
+			headroom_bytes, demote_wmark_bytes);
+} /* lzx-note */
+
+enum parp_tier2_wss_action parp_tier2_workingset_apply_policy(
+		enum parp_tier2_wss_action policy_action,
+		bool strengthen_enabled)
+{
+	/* Keep STRENGTHEN observable as a prediction decision, but do not let an
+	 * unvalidated page selector raise the reclaim watermark unless its own
+	 * APPLY switch is explicitly enabled. lzx-note
+	 */
+	if (policy_action == PARP_TIER2_WSS_STRENGTHEN &&
+	    !strengthen_enabled)
+		return PARP_TIER2_WSS_NORMAL;
+
+	return policy_action;
+} /* lzx-note */
+
+u64 parp_tier2_workingset_demote_wmark(u64 limit_bytes,
+		u64 alloc_wmark_bytes, u64 demote_wmark_bytes,
+		u64 predicted_workingset_bytes, u64 predicted_resident_bytes,
+		enum parp_tier2_wss_action action)
+{
+	u64 predicted_growth;
+	u64 usage_wmark;
+	u64 overflow = 0;
+	u64 cap;
+	u64 target;
+
+	if (action == PARP_TIER2_WSS_RELAX)
+		return alloc_wmark_bytes;
+	if (action != PARP_TIER2_WSS_STRENGTHEN ||
+	    !limit_bytes || limit_bytes == U64_MAX ||
+	    predicted_resident_bytes > predicted_workingset_bytes)
+		return demote_wmark_bytes;
+
+	predicted_growth = predicted_workingset_bytes -
+		predicted_resident_bytes;
+	usage_wmark = limit_bytes > demote_wmark_bytes ?
+		limit_bytes - demote_wmark_bytes : 0;
+	if (predicted_workingset_bytes > usage_wmark)
+		overflow = predicted_workingset_bytes - usage_wmark;
+	cap = parp_tier2_scaled_wmark(limit_bytes,
+		PARP_TIER2_WSS_STRONG_MAX_SCALE, demote_wmark_bytes);
+	target = max(demote_wmark_bytes, predicted_growth);
+	if (overflow >= cap - min(cap, demote_wmark_bytes))
+		target = cap;
+	else
+		target = max(target, demote_wmark_bytes + overflow);
+	return clamp_t(u64, target, alloc_wmark_bytes, cap);
+} /* lzx-note */
+
+#ifdef CONFIG_PARP_TIER2_WSS_PREDICT
+static void parp_tier2_workingset_update_locked(
+		struct parp_tier2_memcg *state, u64 limit, u64 alloc,
+		u64 demote, u64 headroom,
+		const struct parp_workingset_prediction *prediction,
+		bool prediction_valid)
+{
+	enum parp_tier2_wss_action raw;
+	enum parp_tier2_wss_action action;
+	enum parp_tier2_wss_action apply_policy_action; /* lzx-note */
+	bool new_generation;
+
+	if (!READ_ONCE(sysctl_tier2_wss_predict_enabled) ||
+	    !prediction_valid) {
+		if (state->workingset_prediction_generation)
+			atomic64_inc(&state->workingset_fallbacks);
+		state->effective_demote_wmark_bytes = demote;
+		state->predicted_workingset_bytes = 0;
+		state->predicted_resident_bytes = 0;
+		state->predicted_growth_bytes = 0;
+		state->workingset_prediction_generation = 0;
+		state->workingset_confidence_q15 = 0;
+		state->workingset_raw_action = PARP_TIER2_WSS_FALLBACK;
+		state->workingset_policy_action = PARP_TIER2_WSS_FALLBACK;
+		state->workingset_action = PARP_TIER2_WSS_FALLBACK;
+		state->workingset_action_streak = 0;
+		return;
+	}
+
+	new_generation = prediction->generation !=
+		state->workingset_prediction_generation;
+	raw = parp_tier2_workingset_action(limit, alloc, demote, headroom,
+		prediction->predicted_workingset_bytes,
+		prediction->predicted_resident_bytes,
+		prediction->confidence_q15);
+	if (new_generation) {
+		atomic64_inc(&state->workingset_predictions);
+		if (raw == state->workingset_raw_action &&
+		    state->workingset_action_streak < U8_MAX)
+			state->workingset_action_streak++;
+		else
+			state->workingset_action_streak = 1;
+		state->workingset_raw_action = raw;
+		if (raw == PARP_TIER2_WSS_NORMAL ||
+		    raw == PARP_TIER2_WSS_FALLBACK) {
+			action = raw;
+		} else if (state->workingset_action_streak >=
+			   PARP_TIER2_WSS_ACTION_STREAK) {
+			action = raw;
+		} else {
+			action = PARP_TIER2_WSS_NORMAL;
+			atomic64_inc(&state->workingset_hysteresis_holds);
+		}
+		state->workingset_policy_action = action; /* lzx-note */
+		if (action == PARP_TIER2_WSS_STRENGTHEN)
+			atomic64_inc(&state->workingset_strengthen);
+		else if (action == PARP_TIER2_WSS_RELAX)
+			atomic64_inc(&state->workingset_relax);
+		else if (action == PARP_TIER2_WSS_NORMAL)
+			atomic64_inc(&state->workingset_normal);
+		else
+			atomic64_inc(&state->workingset_fallbacks);
+	}
+
+	state->workingset_prediction_generation = prediction->generation;
+	state->predicted_workingset_bytes =
+		prediction->predicted_workingset_bytes;
+	state->predicted_resident_bytes = prediction->predicted_resident_bytes;
+	state->predicted_growth_bytes = prediction->predicted_workingset_bytes -
+		prediction->predicted_resident_bytes;
+	state->workingset_confidence_q15 = prediction->confidence_q15;
+	apply_policy_action = parp_tier2_workingset_apply_policy(
+		state->workingset_policy_action,
+		READ_ONCE(sysctl_tier2_wss_strengthen_enabled)); /* lzx-note */
+	action = parp_tier2_workingset_effective_action(
+		apply_policy_action, raw, headroom, demote); /* lzx-note */
+	if (action != state->workingset_action) {
+		if (action != apply_policy_action)
+			atomic64_inc(&state->workingset_safety_overrides);
+		else if (!new_generation && state->workingset_action !=
+			 apply_policy_action)
+			atomic64_inc(&state->workingset_live_restores);
+		state->workingset_action = action; /* lzx-note */
+	}
+	state->effective_demote_wmark_bytes =
+		parp_tier2_workingset_demote_wmark(limit, alloc, demote,
+			prediction->predicted_workingset_bytes,
+			prediction->predicted_resident_bytes,
+			state->workingset_action);
+} /* lzx-note */
+#endif /* CONFIG_PARP_TIER2_WSS_PREDICT */
+
+static unsigned long parp_tier2_reclaim(struct mem_cgroup *memcg,
+					unsigned long nr_pages)
+{
+	unsigned int options = MEMCG_RECLAIM_MAY_SWAP |
+			       MEMCG_RECLAIM_PROACTIVE;
+
+	return try_to_free_mem_cgroup_pages(memcg, nr_pages, GFP_KERNEL,
+					     options, NULL);
+}
+
+static void parp_tier2_workingset_state_reset(
+		struct parp_tier2_memcg *state) /* lzx-note */
+{
+	state->effective_demote_wmark_bytes = 0;
+	state->predicted_workingset_bytes = 0;
+	state->predicted_resident_bytes = 0;
+	state->predicted_growth_bytes = 0;
+	state->workingset_prediction_generation = 0;
+	state->workingset_confidence_q15 = 0;
+	state->workingset_raw_action = PARP_TIER2_WSS_FALLBACK;
+	state->workingset_policy_action = PARP_TIER2_WSS_FALLBACK;
+	state->workingset_action = PARP_TIER2_WSS_FALLBACK;
+	state->workingset_action_streak = 0;
+} /* lzx-note */
+
+static void parp_tier2_predict_work(struct work_struct *work)
+{
+	struct parp_tier2_memcg *state = container_of(to_delayed_work(work),
+			struct parp_tier2_memcg, predict_work);
+	struct mem_cgroup *memcg = state->memcg;
+	unsigned long flags;
+	unsigned long nr_to_reclaim;
+	unsigned long reclaimed;
+	u64 limit, usage, headroom, alloc, demote, gap, now, cooldown_until; /* lzx-note */
+	s64 predicted;
+	bool active;
+#ifdef CONFIG_PARP_TIER2_WSS_PREDICT
+	struct parp_workingset_prediction workingset;
+	bool workingset_valid;
+#endif
+
+	now = ktime_get_mono_fast_ns(); /* lzx-note */
+	spin_lock_irqsave(&state->lock, flags);
+	state->scheduled_for_ns = 0;
+	active = state->online && state->enabled &&
+		 parp_tier2_runtime_enabled(); /* lzx-note */
+	predicted = state->predicted_ms;
+	cooldown_until = state->reclaim_cooldown_until_ns; /* lzx-note */
+	spin_unlock_irqrestore(&state->lock, flags);
+
+	if (!active || mem_cgroup_is_root(memcg) || !mem_cgroup_online(memcg))
+		return;
+	if (cooldown_until && now < cooldown_until) { /* lzx-note */
+		atomic64_inc(&state->reclaim_cooldown_skips); /* lzx-note */
+		return;
+	} /* lzx-note */
+
+	atomic64_inc(&state->predict_executed);
+	limit = parp_tier2_limit_bytes(memcg);
+	usage = parp_tier2_usage_bytes(memcg);
+	headroom = parp_tier2_headroom(limit, usage);
+	alloc = READ_ONCE(state->alloc_wmark_bytes);
+	demote = READ_ONCE(state->demote_wmark_bytes);
+	if (!demote || headroom == U64_MAX)
+		return;
+
+#ifdef CONFIG_PARP_TIER2_WSS_PREDICT
+	workingset_valid = parp_workingset_prediction_lookup(
+		(u64)cgroup_ino(memcg->css.cgroup), now, &workingset);
+	spin_lock_irqsave(&state->lock, flags);
+	parp_tier2_workingset_update_locked(state, limit, alloc, demote, headroom,
+		&workingset, workingset_valid);
+	demote = state->effective_demote_wmark_bytes;
+	predicted = state->predicted_ms;
+	if (state->workingset_action == PARP_TIER2_WSS_RELAX &&
+	    headroom > demote) {
+		atomic64_inc(&state->workingset_reclaim_skips);
+		spin_unlock_irqrestore(&state->lock, flags);
+		return;
+	}
+	spin_unlock_irqrestore(&state->lock, flags);
+#endif /* CONFIG_PARP_TIER2_WSS_PREDICT */
+
+	/* A recovered workload must not be reclaimed because of a stale timer. */
+	if (headroom > demote &&
+	    (predicted < 0 || headroom > READ_ONCE(state->ewma_headroom_bytes)))
+		return;
+
+	gap = headroom < demote ? demote - headroom : 0;
+	nr_to_reclaim = gap ? DIV_ROUND_UP_ULL(gap, PAGE_SIZE) :
+		SWAP_CLUSTER_MAX;
+	nr_to_reclaim = clamp_t(unsigned long, nr_to_reclaim,
+				SWAP_CLUSTER_MAX, PARP_TIER2_MAX_RECLAIM_PAGES);
+
+	reclaimed = parp_tier2_reclaim(memcg, nr_to_reclaim);
+	atomic64_inc(&state->reclaim_invocations);
+	atomic64_add(reclaimed, &state->reclaim_pages);
+	if (!reclaimed) /* lzx-note */
+		atomic64_inc(&state->reclaim_no_progress); /* lzx-note */
+
+	/*
+	 * One invocation is bounded, but immediately re-arming from the charge
+	 * hook can otherwise create an unbounded 1 ms reclaim loop while the
+	 * cgroup remains below its watermark.  Rate-limit successful work and
+	 * back off longer when reclaim made no progress.  A later charge after
+	 * the cooldown re-evaluates the EWMA and may schedule another bounded
+	 * attempt. lzx-note
+	 */
+	now = ktime_get_mono_fast_ns(); /* lzx-note */
+	spin_lock_irqsave(&state->lock, flags); /* lzx-note */
+	state->reclaim_cooldown_until_ns = now +
+		(u64)(reclaimed ? PARP_TIER2_RECLAIM_COOLDOWN_MS :
+		 PARP_TIER2_NO_PROGRESS_COOLDOWN_MS) * NSEC_PER_MSEC; /* lzx-note */
+	spin_unlock_irqrestore(&state->lock, flags); /* lzx-note */
+
+	/* Re-seed/cancel the next prediction from the post-reclaim headroom. */
+	parp_tier2_memcg_sample(memcg);
+}
+
+void parp_tier2_memcg_init(struct mem_cgroup *memcg)
+{
+	struct parp_tier2_memcg *state = &memcg->parp_tier2;
+
+	spin_lock_init(&state->lock);
+	INIT_DELAYED_WORK(&state->predict_work, parp_tier2_predict_work);
+	state->memcg = memcg;
+	state->online = true;
+	state->enabled = false;
+	state->alloc_scale = PARP_TIER2_DEFAULT_ALLOC_SCALE;
+	state->demote_scale = PARP_TIER2_DEFAULT_DEMOTE_SCALE;
+	state->predicted_ms = -1;
+	parp_tier2_workingset_state_reset(state); /* lzx-note */
+	atomic64_set(&state->samples, 0);
+	atomic64_set(&state->below_alloc, 0);
+	atomic64_set(&state->below_demote, 0);
+	atomic64_set(&state->predict_scheduled, 0);
+	atomic64_set(&state->predict_executed, 0);
+	atomic64_set(&state->predict_cancelled, 0);
+	atomic64_set(&state->reclaim_invocations, 0);
+	atomic64_set(&state->reclaim_pages, 0);
+	atomic64_set(&state->reclaim_cooldown_skips, 0); /* lzx-note */
+	atomic64_set(&state->reclaim_no_progress, 0); /* lzx-note */
+	atomic64_set(&state->workingset_predictions, 0);
+	atomic64_set(&state->workingset_fallbacks, 0);
+	atomic64_set(&state->workingset_normal, 0);
+	atomic64_set(&state->workingset_strengthen, 0);
+	atomic64_set(&state->workingset_relax, 0);
+	atomic64_set(&state->workingset_hysteresis_holds, 0);
+	atomic64_set(&state->workingset_reclaim_skips, 0);
+	atomic64_set(&state->workingset_safety_overrides, 0); /* lzx-note */
+	atomic64_set(&state->workingset_live_restores, 0); /* lzx-note */
+}
+
+void parp_tier2_memcg_online(struct mem_cgroup *memcg)
+{
+	struct parp_tier2_memcg *state = &memcg->parp_tier2;
+	unsigned long flags;
+
+	spin_lock_irqsave(&state->lock, flags);
+	state->online = true;
+	state->ewma_valid = false;
+	state->predicted_ms = -1;
+	state->reclaim_cooldown_until_ns = 0; /* lzx-note */
+	parp_tier2_workingset_state_reset(state); /* lzx-note */
+	spin_unlock_irqrestore(&state->lock, flags);
+}
+
+void parp_tier2_memcg_offline(struct mem_cgroup *memcg)
+{
+	struct parp_tier2_memcg *state = &memcg->parp_tier2;
+	unsigned long flags;
+
+	spin_lock_irqsave(&state->lock, flags);
+	state->online = false;
+	state->scheduled_for_ns = 0;
+	state->reclaim_cooldown_until_ns = 0; /* lzx-note */
+	parp_tier2_workingset_state_reset(state); /* lzx-note */
+	spin_unlock_irqrestore(&state->lock, flags);
+	cancel_delayed_work_sync(&state->predict_work);
+}
+
+void parp_tier2_memcg_reset(struct mem_cgroup *memcg)
+{
+	struct parp_tier2_memcg *state = &memcg->parp_tier2;
+	unsigned long flags;
+
+	spin_lock_irqsave(&state->lock, flags);
+	state->enabled = false;
+	state->ewma_valid = false;
+	state->predicted_ms = -1;
+	state->scheduled_for_ns = 0;
+	state->reclaim_cooldown_until_ns = 0; /* lzx-note */
+	parp_tier2_workingset_state_reset(state); /* lzx-note */
+	spin_unlock_irqrestore(&state->lock, flags);
+	cancel_delayed_work_sync(&state->predict_work);
+}
+
+void parp_tier2_memcg_destroy(struct mem_cgroup *memcg)
+{
+	cancel_delayed_work_sync(&memcg->parp_tier2.predict_work);
+}
+
+void parp_tier2_memcg_sample(struct mem_cgroup *memcg)
+{
+	struct parp_tier2_memcg *state;
+	unsigned long flags;
+	u64 limit, usage, headroom, alloc, demote, effective_demote;
+	u64 now, elapsed_ms, previous, ewma;
+	u64 threshold_ms, delay_ms = 0, due_ns = 0;
+	s64 predicted = -1;
+	u32 alloc_scale, demote_scale;
+	bool enabled, online, schedule = false, cancel = false;
+#ifdef CONFIG_PARP_TIER2_WSS_PREDICT
+	struct parp_workingset_prediction workingset;
+	bool workingset_valid;
+#endif
+
+	if (!memcg || mem_cgroup_is_root(memcg) ||
+	    !parp_tier2_runtime_enabled()) /* lzx-note */
+		return;
+
+	state = &memcg->parp_tier2;
+	enabled = READ_ONCE(state->enabled);
+	online = READ_ONCE(state->online);
+	if (!enabled || !online)
+		return;
+
+	limit = parp_tier2_limit_bytes(memcg);
+	usage = parp_tier2_usage_bytes(memcg);
+	headroom = parp_tier2_headroom(limit, usage);
+	now = ktime_get_mono_fast_ns();
+#ifdef CONFIG_PARP_TIER2_WSS_PREDICT
+	workingset_valid = parp_workingset_prediction_lookup(
+		(u64)cgroup_ino(memcg->css.cgroup), now, &workingset);
+#endif
+
+	spin_lock_irqsave(&state->lock, flags);
+	if (!state->enabled || !state->online)
+		goto unlock;
+
+	alloc_scale = state->alloc_scale;
+	demote_scale = state->demote_scale;
+	parp_tier2_watermarks(limit, alloc_scale, demote_scale,
+			      &alloc, &demote);
+	effective_demote = demote;
+#ifdef CONFIG_PARP_TIER2_WSS_PREDICT
+	parp_tier2_workingset_update_locked(state, limit, alloc, demote, headroom,
+		&workingset, workingset_valid);
+	effective_demote = state->effective_demote_wmark_bytes;
+#else
+	state->effective_demote_wmark_bytes = demote;
+#endif /* CONFIG_PARP_TIER2_WSS_PREDICT */
+	if (state->limit_bytes && state->limit_bytes != limit) {
+		state->ewma_valid = false;
+		state->predicted_ms = -1;
+		cancel = state->scheduled_for_ns != 0;
+		state->scheduled_for_ns = 0;
+	}
+	state->limit_bytes = limit;
+	state->alloc_wmark_bytes = alloc;
+	state->demote_wmark_bytes = demote;
+	state->headroom_bytes = headroom;
+
+	if (!effective_demote || headroom == U64_MAX) {
+		state->ewma_valid = false;
+		state->predicted_ms = -1;
+		cancel = state->scheduled_for_ns != 0;
+		state->scheduled_for_ns = 0;
+		goto unlock;
+	}
+
+	if (!state->ewma_valid) {
+		state->ewma_valid = true;
+		state->previous_ewma_headroom_bytes = headroom;
+		state->ewma_headroom_bytes = headroom;
+		state->last_sample_ns = now;
+		state->predicted_ms = headroom <= effective_demote ? 0 : -1;
+		atomic64_inc(&state->samples);
+		goto decide;
+	}
+
+	previous = state->ewma_headroom_bytes;
+	/* Charge hooks can run many times per millisecond; keep a real timebase. */
+	if (headroom > effective_demote &&
+	    now - state->last_sample_ns < NSEC_PER_MSEC)
+		goto unlock;
+
+	ewma = parp_tier2_ewma_next(previous, headroom);
+	elapsed_ms = div_u64(now - state->last_sample_ns, NSEC_PER_MSEC);
+	predicted = parp_tier2_predict_ms(previous, ewma, headroom,
+			effective_demote, elapsed_ms);
+	state->previous_ewma_headroom_bytes = previous;
+	state->ewma_headroom_bytes = ewma;
+	state->last_sample_ns = now;
+	state->predicted_ms = predicted;
+	atomic64_inc(&state->samples);
+
+decide:
+	if (headroom < alloc)
+		atomic64_inc(&state->below_alloc);
+	if (headroom < demote)
+		atomic64_inc(&state->below_demote);
+
+	predicted = state->predicted_ms;
+	/* Suppress charge-driven rearming until the bounded cooldown expires. */
+	if (state->reclaim_cooldown_until_ns) { /* lzx-note */
+		if (now < state->reclaim_cooldown_until_ns) { /* lzx-note */
+			if (state->scheduled_for_ns) { /* lzx-note */
+				state->scheduled_for_ns = 0; /* lzx-note */
+				cancel = true; /* lzx-note */
+				atomic64_inc(&state->predict_cancelled); /* lzx-note */
+			} /* lzx-note */
+			atomic64_inc(&state->reclaim_cooldown_skips); /* lzx-note */
+			goto unlock; /* lzx-note */
+		} /* lzx-note */
+		state->reclaim_cooldown_until_ns = 0; /* lzx-note */
+	} /* lzx-note */
+	threshold_ms = (u64)READ_ONCE(sysctl_tier2_predict_latency_ms) *
+		READ_ONCE(sysctl_tier2_predict_horizon_ratio);
+	if (predicted == 0) {
+		delay_ms = 1;
+		schedule = true;
+	} else if (predicted > 0 && predicted <= threshold_ms) {
+		delay_ms = predicted > READ_ONCE(sysctl_tier2_predict_latency_ms) ?
+			predicted - READ_ONCE(sysctl_tier2_predict_latency_ms) : 1;
+		schedule = true;
+	}
+
+	if (schedule) {
+		due_ns = now + delay_ms * NSEC_PER_MSEC;
+		/* Never postpone work that is already due sooner. */
+		if (!state->scheduled_for_ns || due_ns < state->scheduled_for_ns) {
+			state->scheduled_for_ns = due_ns;
+			atomic64_inc(&state->predict_scheduled);
+		} else {
+			schedule = false;
+		}
+	} else if (state->scheduled_for_ns) {
+		state->scheduled_for_ns = 0;
+		cancel = true;
+		atomic64_inc(&state->predict_cancelled);
+	}
+
+unlock:
+	spin_unlock_irqrestore(&state->lock, flags);
+	if (schedule)
+		mod_delayed_work(system_unbound_wq, &state->predict_work,
+				 msecs_to_jiffies(delay_ms));
+	else if (cancel)
+		cancel_delayed_work(&state->predict_work);
+}
+
+void parp_tier2_memcg_charge(struct mem_cgroup *memcg)
+{
+	struct mem_cgroup *iter;
+
+	if (!parp_tier2_runtime_enabled()) /* lzx-note */
+		return;
+
+	/* Hierarchical charging changes every non-root ancestor's headroom. */
+	for (iter = memcg; iter && !mem_cgroup_is_root(iter);
+	     iter = parent_mem_cgroup(iter))
+		parp_tier2_memcg_sample(iter);
+}
+
+static struct mem_cgroup *parp_tier2_memcg_from_seq(struct seq_file *m)
+{
+	return mem_cgroup_from_seq(m);
+}
+
+static struct mem_cgroup *parp_tier2_memcg_from_of(struct kernfs_open_file *of)
+{
+	return mem_cgroup_from_css(of_css(of));
+}
+
+int parp_tier2_enabled_show(struct seq_file *m, void *v)
+{
+	struct mem_cgroup *memcg = parp_tier2_memcg_from_seq(m);
+
+	seq_printf(m, "%u\n", READ_ONCE(memcg->parp_tier2.enabled));
+	return 0;
+}
+
+ssize_t parp_tier2_enabled_write(struct kernfs_open_file *of, char *buf,
+				 size_t nbytes, loff_t off)
+{
+	struct mem_cgroup *memcg = parp_tier2_memcg_from_of(of);
+	struct parp_tier2_memcg *state = &memcg->parp_tier2;
+	unsigned long flags;
+	bool enabled;
+	int ret;
+
+	ret = kstrtobool(strstrip(buf), &enabled);
+	if (ret)
+		return ret;
+
+	spin_lock_irqsave(&state->lock, flags);
+	state->enabled = enabled;
+	state->ewma_valid = false;
+	state->predicted_ms = -1;
+	state->scheduled_for_ns = 0;
+	state->reclaim_cooldown_until_ns = 0; /* lzx-note */
+	parp_tier2_workingset_state_reset(state); /* lzx-note */
+	spin_unlock_irqrestore(&state->lock, flags);
+	if (!enabled)
+		cancel_delayed_work_sync(&state->predict_work);
+	else
+		parp_tier2_memcg_sample(memcg);
+	return nbytes;
+}
+
+static int parp_tier2_scale_show(struct seq_file *m, bool demote)
+{
+	struct mem_cgroup *memcg = parp_tier2_memcg_from_seq(m);
+	struct parp_tier2_memcg *state = &memcg->parp_tier2;
+
+	seq_printf(m, "%u\n", demote ? READ_ONCE(state->demote_scale) :
+				       READ_ONCE(state->alloc_scale));
+	return 0;
+}
+
+int parp_tier2_alloc_scale_show(struct seq_file *m, void *v)
+{
+	return parp_tier2_scale_show(m, false);
+}
+
+int parp_tier2_demote_scale_show(struct seq_file *m, void *v)
+{
+	return parp_tier2_scale_show(m, true);
+}
+
+static ssize_t parp_tier2_scale_write(struct kernfs_open_file *of, char *buf,
+				      size_t nbytes, bool demote)
+{
+	struct mem_cgroup *memcg = parp_tier2_memcg_from_of(of);
+	struct parp_tier2_memcg *state = &memcg->parp_tier2;
+	unsigned long flags;
+	u32 scale;
+	int ret;
+
+	ret = kstrtou32(strstrip(buf), 0, &scale);
+	if (ret)
+		return ret;
+	if (scale > PARP_TIER2_SCALE_BASE)
+		return -ERANGE;
+
+	spin_lock_irqsave(&state->lock, flags);
+	if (demote)
+		state->demote_scale = scale;
+	else
+		state->alloc_scale = scale;
+	state->ewma_valid = false;
+	spin_unlock_irqrestore(&state->lock, flags);
+	parp_tier2_memcg_sample(memcg);
+	return nbytes;
+}
+
+ssize_t parp_tier2_alloc_scale_write(struct kernfs_open_file *of, char *buf,
+				     size_t nbytes, loff_t off)
+{
+	return parp_tier2_scale_write(of, buf, nbytes, false);
+}
+
+ssize_t parp_tier2_demote_scale_write(struct kernfs_open_file *of, char *buf,
+				      size_t nbytes, loff_t off)
+{
+	return parp_tier2_scale_write(of, buf, nbytes, true);
+}
+
+static void parp_tier2_live_values(struct mem_cgroup *memcg, u64 *limit,
+				   u64 *usage, u64 *headroom,
+				   u64 *alloc, u64 *demote)
+{
+	struct parp_tier2_memcg *state = &memcg->parp_tier2;
+	u32 alloc_scale = READ_ONCE(state->alloc_scale);
+	u32 demote_scale = READ_ONCE(state->demote_scale);
+
+	*limit = parp_tier2_limit_bytes(memcg);
+	*usage = parp_tier2_usage_bytes(memcg);
+	*headroom = parp_tier2_headroom(*limit, *usage);
+	parp_tier2_watermarks(*limit, alloc_scale, demote_scale, alloc, demote);
+}
+
+static int parp_tier2_value_show(struct seq_file *m, unsigned int which)
+{
+	struct mem_cgroup *memcg = parp_tier2_memcg_from_seq(m);
+	u64 limit, usage, headroom, alloc, demote, value;
+
+	parp_tier2_live_values(memcg, &limit, &usage, &headroom, &alloc, &demote);
+	value = which == 0 ? alloc : which == 1 ? demote : headroom;
+	seq_printf(m, "%llu\n", value == U64_MAX ? 0 : value);
+	return 0;
+}
+
+int parp_tier2_alloc_wmark_show(struct seq_file *m, void *v)
+{
+	return parp_tier2_value_show(m, 0);
+}
+
+int parp_tier2_demote_wmark_show(struct seq_file *m, void *v)
+{
+	return parp_tier2_value_show(m, 1);
+}
+
+int parp_tier2_headroom_show(struct seq_file *m, void *v)
+{
+	return parp_tier2_value_show(m, 2);
+}
+
+int parp_tier2_below_show(struct seq_file *m, void *v)
+{
+	struct mem_cgroup *memcg = parp_tier2_memcg_from_seq(m);
+	u64 limit, usage, headroom, alloc, demote;
+
+	parp_tier2_live_values(memcg, &limit, &usage, &headroom, &alloc, &demote);
+	seq_printf(m, "alloc=%u demote=%u\n",
+		   alloc && headroom < alloc, demote && headroom < demote);
+	return 0;
+}
+
+int parp_tier2_stats_show(struct seq_file *m, void *v)
+{
+	struct mem_cgroup *memcg = parp_tier2_memcg_from_seq(m);
+	struct parp_tier2_memcg *state = &memcg->parp_tier2;
+	u64 limit, usage, headroom, alloc, demote;
+	u64 effective_demote;
+	u8 workingset_action;
+#ifdef CONFIG_PARP_TIER2_WSS_PREDICT
+	int workingset_runtime_enabled =
+		READ_ONCE(sysctl_tier2_wss_predict_enabled);
+	int workingset_strengthen_apply_enabled =
+		READ_ONCE(sysctl_tier2_wss_strengthen_enabled); /* lzx-note */
+#else
+	int workingset_runtime_enabled = 0;
+	int workingset_strengthen_apply_enabled = 0; /* lzx-note */
+#endif
+
+	parp_tier2_live_values(memcg, &limit, &usage, &headroom, &alloc, &demote);
+	seq_printf(m, "enabled %u\n", READ_ONCE(state->enabled));
+	seq_printf(m, "domain_id %llu\n",
+		   (u64)cgroup_ino(memcg->css.cgroup));
+	seq_printf(m, "limit_bytes %llu\n", limit == U64_MAX ? 0 : limit);
+	seq_printf(m, "usage_bytes %llu\n", usage);
+	seq_printf(m, "headroom_bytes %llu\n", headroom == U64_MAX ? 0 : headroom);
+	seq_printf(m, "alloc_wmark_bytes %llu\n", alloc);
+	seq_printf(m, "demote_wmark_bytes %llu\n", demote);
+	effective_demote = READ_ONCE(state->effective_demote_wmark_bytes);
+	if (!effective_demote)
+		effective_demote = demote;
+	workingset_action = READ_ONCE(state->workingset_action);
+	seq_printf(m, "effective_demote_wmark_bytes %llu\n",
+		   effective_demote); /* lzx-note */
+	seq_printf(m, "effective_usage_wmark_bytes %llu\n",
+		   limit != U64_MAX && limit > effective_demote ?
+		   limit - effective_demote : 0); /* lzx-note */
+	seq_printf(m, "ewma_headroom_bytes %llu\n",
+		   READ_ONCE(state->ewma_headroom_bytes));
+	seq_printf(m, "predicted_ms %lld\n", READ_ONCE(state->predicted_ms));
+	seq_printf(m, "samples %lld\n", atomic64_read(&state->samples));
+	seq_printf(m, "below_alloc %lld\n", atomic64_read(&state->below_alloc));
+	seq_printf(m, "below_demote %lld\n", atomic64_read(&state->below_demote));
+	seq_printf(m, "predict_scheduled %lld\n",
+		   atomic64_read(&state->predict_scheduled));
+	seq_printf(m, "predict_executed %lld\n",
+		   atomic64_read(&state->predict_executed));
+	seq_printf(m, "predict_cancelled %lld\n",
+		   atomic64_read(&state->predict_cancelled));
+	seq_printf(m, "reclaim_invocations %lld\n",
+		   atomic64_read(&state->reclaim_invocations));
+	seq_printf(m, "reclaim_pages %lld\n", atomic64_read(&state->reclaim_pages));
+	seq_printf(m, "reclaim_cooldown_until_ns %llu\n",
+		   READ_ONCE(state->reclaim_cooldown_until_ns)); /* lzx-note */
+	seq_printf(m, "reclaim_cooldown_skips %lld\n",
+		   atomic64_read(&state->reclaim_cooldown_skips)); /* lzx-note */
+	seq_printf(m, "reclaim_no_progress %lld\n",
+		   atomic64_read(&state->reclaim_no_progress)); /* lzx-note */
+	seq_printf(m, "workingset_compiled %u\n",
+		   IS_ENABLED(CONFIG_PARP_TIER2_WSS_PREDICT));
+	seq_printf(m, "workingset_runtime_enabled %u\n",
+		   workingset_runtime_enabled);
+	seq_printf(m, "workingset_strengthen_apply_enabled %u\n",
+		   workingset_strengthen_apply_enabled); /* lzx-note */
+	seq_printf(m, "workingset_action %u\n", workingset_action);
+	seq_printf(m, "workingset_policy_action %u\n",
+		   READ_ONCE(state->workingset_policy_action)); /* lzx-note */
+	seq_printf(m, "workingset_raw_action %u\n",
+		   READ_ONCE(state->workingset_raw_action));
+	seq_printf(m, "workingset_action_streak %u\n",
+		   READ_ONCE(state->workingset_action_streak));
+	seq_printf(m, "workingset_prediction_generation %u\n",
+		   READ_ONCE(state->workingset_prediction_generation));
+	seq_printf(m, "workingset_confidence_q15 %u\n",
+		   READ_ONCE(state->workingset_confidence_q15));
+	seq_printf(m, "predicted_workingset_bytes %llu\n",
+		   READ_ONCE(state->predicted_workingset_bytes));
+	seq_printf(m, "predicted_resident_bytes %llu\n",
+		   READ_ONCE(state->predicted_resident_bytes));
+	seq_printf(m, "predicted_growth_bytes %llu\n",
+		   READ_ONCE(state->predicted_growth_bytes));
+	seq_printf(m, "workingset_predictions %lld\n",
+		   atomic64_read(&state->workingset_predictions));
+	seq_printf(m, "workingset_fallbacks %lld\n",
+		   atomic64_read(&state->workingset_fallbacks));
+	seq_printf(m, "workingset_normal %lld\n",
+		   atomic64_read(&state->workingset_normal));
+	seq_printf(m, "workingset_strengthen %lld\n",
+		   atomic64_read(&state->workingset_strengthen));
+	seq_printf(m, "workingset_relax %lld\n",
+		   atomic64_read(&state->workingset_relax));
+	seq_printf(m, "workingset_hysteresis_holds %lld\n",
+		   atomic64_read(&state->workingset_hysteresis_holds));
+	seq_printf(m, "workingset_reclaim_skips %lld\n",
+		   atomic64_read(&state->workingset_reclaim_skips));
+	seq_printf(m, "workingset_safety_overrides %lld\n",
+		   atomic64_read(&state->workingset_safety_overrides)); /* lzx-note */
+	seq_printf(m, "workingset_live_restores %lld\n",
+		   atomic64_read(&state->workingset_live_restores)); /* lzx-note */
+	return 0;
+}
