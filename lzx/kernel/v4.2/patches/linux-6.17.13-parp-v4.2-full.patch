+}; /* lzx-note */
+
+/* Reclaim-bin counters make APPLY coverage auditable across cgroup children. */
+struct parp_reclaim_bin_stats { /* lzx-note */
+	u64 lookups;
+	u64 policy_hits;
+	u64 inherited_hits;
