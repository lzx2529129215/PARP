+from kernel_operation_inference.provenance import hash_paths
+from kernel_operation_inference.taxonomy import (
+    OPERATION_TAXONOMY,
+    eligible_classes,
+)
+
+
+class LeakageContractTests(unittest.TestCase):
+    def test_operation_label_field_is_rejected(self):
+        with self.assertRaises(ValueError):
+            validate_feature_names(["dominant_operation"])
+
+    def test_automation_field_is_rejected(self):
+        with self.assertRaises(ValueError):
+            validate_feature_names(["automation_phase"])
+
+    def test_file_path_is_rejected(self):
+        with self.assertRaises(ValueError):
+            validate_feature_names(["absolute_file_path"])
+
+    def test_file_id_is_not_a_feature(self):
+        with self.assertRaises(ValueError):
+            validate_feature_names(["top1_file_id"])
+
+    def test_source_map_is_complete_and_kernel_only(self):
+        names = ["foreground_app_id", "top1_active_pages_log"]
+        source = {
+            "foreground_app_id": {"source_type": "UPPER_LAYER_APP_ID", "allowed_online": True},
+            "top1_active_pages_log": {"source_type": "PARP_FILE", "allowed_online": True},
+        }
+        self.assertTrue(validate_source_map(names, source))
+        del source["top1_active_pages_log"]
+        with self.assertRaises(ValueError):
+            validate_source_map(names, source)
+
+    def test_foreground_app_is_only_upper_layer_semantic_input(self):
+        payload = {
+            "schema_version": 1, "foreground_app_id": 1,
+            "kernel_features": {"anon_hot_ratio": .2},
+            "past_predictions": ["VIEW_IDLE"],
+        }
+        self.assertTrue(validate_online_payload(payload))
+        payload["current_operation"] = "EDIT"
+        with self.assertRaises(ValueError):
+            validate_online_payload(payload)
+
+
+class TopKTests(unittest.TestCase):
+    def setUp(self):
+        self.files = [
+            {"file_key": "b", "activity_score": .5, "weighted_pages": 2,
+             "active_pages": 3, "region_count": 2},
+            {"file_key": "a", "activity_score": .5, "weighted_pages": 2,
+             "active_pages": 3, "region_count": 1},
+            {"file_key": "c", "activity_score": .1, "weighted_pages": 1,
+             "active_pages": 2, "region_count": 4},
+        ]
+
+    def test_top3_selection_is_stable(self):
+        one = stable_top_files(self.files, 3)
+        two = stable_top_files(list(reversed(self.files)), 3)
+        self.assertEqual([row["file_key"] for row in one], ["a", "b", "c"])
+        self.assertEqual(one, two)
+
+    def test_other_summary_conserves_counts(self):
+        top = stable_top_files(self.files, 1)
+        other = aggregate_other(self.files, top)
+        self.assertEqual(other["other_file_count"] + len(top), len(self.files))
+        self.assertEqual(other["other_active_pages"] + sum(x["active_pages"] for x in top),
+                         sum(x["active_pages"] for x in self.files))
+
+
+class WindowAndHistoryTests(unittest.TestCase):
+    def test_window_history_never_crosses_session(self):
+        rows = [{"session_id": "a", "value": 1}, {"session_id": "a", "value": 2},
+                {"session_id": "b", "value": 3}]
+        self.assertEqual(causal_history(rows, 2, 3), [rows[2]])
+
+    def test_history_never_reads_future(self):
+        rows = [{"session_id": "a", "value": i} for i in range(5)]
+        self.assertEqual([x["value"] for x in causal_history(rows, 2, 3)], [0, 1, 2])
+
+    def test_pure_mixed_low_quality(self):
+        self.assertEqual(label_quality(.8), "PURE")
+        self.assertEqual(label_quality(.5), "MIXED")
+        self.assertEqual(label_quality(.49), "LOW_CONFIDENCE")
+
+
+class TrainSelectionTests(unittest.TestCase):
+    def test_scaler_is_fitted_on_train_only(self):
+        scaler = TrainOnlyStandardizer().fit([[0.0], [2.0]], ["wps_01", "wps_01"])
+        self.assertEqual(scaler.fit_sessions, ["wps_01"])
+        self.assertEqual(scaler.transform([[100.0]])[0][0], 99.0)
+
+    def test_unknown_thresholds_are_validation_only(self):
+        result = select_unknown_thresholds([.1, .2, .3, .9], targets=(.25,))
+        self.assertEqual(result["selection_source"], "validation_only")
+        self.assertIn("0.25", result["thresholds"])
+
+    def test_test_values_cannot_enter_threshold_selection(self):
+        with self.assertRaises(TypeError):
+            select_unknown_thresholds([.1, .2], test_scores=[.9])
+
+
+class TaxonomyTests(unittest.TestCase):
+    def test_all_eighteen_real_operations_are_mapped(self):
+        self.assertEqual(len(OPERATION_TAXONOMY), 18)
+        self.assertEqual(OPERATION_TAXONOMY["EDIT"], "EDIT")
+        self.assertEqual(OPERATION_TAXONOMY["SAVE"], "SAVE_WRITE")
+
+    def test_insufficient_classes_are_not_fabricated(self):
+        support = {"EDIT": {"train": 7, "validation": 9, "test": 9},
+                   "NAVIGATION": {"train": 8, "validation": 3, "test": 3}}
+        result = eligible_classes(support)
+        self.assertEqual(result["eligible"], ["NAVIGATION"])
+        self.assertEqual(result["insufficient"], ["EDIT"])
+
+
+class OnlineAndProvenanceTests(unittest.TestCase):
+    def test_online_contract_rejects_future_kernel_state(self):
+        payload = {"schema_version": 1, "foreground_app_id": 1,
+                   "kernel_features": {}, "past_predictions": [],
+                   "future_kernel_features": {}}
+        with self.assertRaises(ValueError):
+            validate_online_payload(payload)
+
+    def test_online_contract_rejects_current_truth(self):
+        payload = {"schema_version": 1, "foreground_app_id": 1,
+                   "kernel_features": {}, "past_predictions": [],
+                   "ground_truth": "EDIT"}
+        with self.assertRaises(ValueError):
+            validate_online_payload(payload)
+
+    def test_raw_hash_change_is_detected(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            path = Path(temporary) / "raw"
+            path.write_bytes(b"a")
+            before = hash_paths(Path(temporary), [path])
+            path.write_bytes(b"b")
+            after = hash_paths(Path(temporary), [path])
+            self.assertNotEqual(before, after)
+            self.assertEqual(before[0][1], hashlib.sha256(b"a").hexdigest())
+
+
+if __name__ == "__main__":
+    unittest.main()
