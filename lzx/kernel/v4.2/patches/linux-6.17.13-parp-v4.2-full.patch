+u32 parp_tier2_reclaim_rank_score_q15(u16 app_prior_q15, u16 app_rank,
+				      bool foreground) /* lzx-note */
+{
+	u32 rank_floor;
+
+	if (!app_rank || app_prior_q15 > PARP_Q15_ONE)
+		return min_t(u16, app_prior_q15, PARP_Q15_ONE);
+
+	/*
+	 * Eight reclaim bins need an ordinal score: ordinary LSTM probabilities
+	 * are mostly below 1/8 and otherwise collapse into bin 0. Preserve rank
+	 * bands while retaining probability as a within-band lower bound. The
+	 * constants are exact Q15 bin boundaries used by vmscan. lzx-note
+	 */
+	if (foreground || app_rank == 1)
+		rank_floor = PARP_Q15_ONE;
+	else if (app_rank == 2)
+		rank_floor = 24576;
+	else if (app_rank == 3)
+		rank_floor = 20480;
+	else if (app_rank == 4)
+		rank_floor = 16384;
+	else if (app_rank <= 6)
+		rank_floor = 12288;
+	else if (app_rank <= 9)
+		rank_floor = 8192;
+	else if (app_rank <= 12)
+		rank_floor = 4096;
+	else
+		rank_floor = 0;
+
+	return max_t(u32, app_prior_q15, rank_floor);
+} /* lzx-note */
+
+bool parp_tier2_reclaim_bin_score(struct mem_cgroup *memcg,
+				  u32 *score_q15,
+				  bool *prediction_backed) /* lzx-note */
+{
+	struct mem_cgroup *policy_memcg;
+	struct parp_tier2_memcg *state;
+	struct parp_app_context app;
+	u64 now = ktime_get_mono_fast_ns();
+	u64 domain_id;
+	u64 limit;
+	u64 headroom;
+	u32 score = 0;
+	bool have_signal = false;
+
+	if (prediction_backed)
+		*prediction_backed = false;
+
+	if (!memcg || !score_q15 || mem_cgroup_is_root(memcg) ||
+	    !parp_tier2_reclaim_bin_apply_enabled())
+		return false;
+
+	atomic64_inc(&parp_reclaim_bin_stats.lookups);
+	policy_memcg = parp_reclaim_bin_policy_memcg(memcg);
+	if (!policy_memcg) {
+		atomic64_inc(&parp_reclaim_bin_stats.fallbacks);
+		return false;
+	}
+
+	atomic64_inc(&parp_reclaim_bin_stats.policy_hits);
+	if (policy_memcg != memcg)
+		atomic64_inc(&parp_reclaim_bin_stats.inherited_hits);
+
+	domain_id = parp_memcg_domain_id(memcg);
+	if (domain_id && parp_context_lookup(domain_id, now, &app)) {
+		score = parp_tier2_reclaim_rank_score_q15(app.app_prior_q15,
+							 app.app_rank,
+							 app.foreground);
+		have_signal = true;
+		if (prediction_backed)
+			*prediction_backed = true;
+		atomic64_inc(&parp_reclaim_bin_stats.context_hits);
+		atomic64_inc(&parp_reclaim_bin_stats.rank_scores);
+	}
+
+	state = &policy_memcg->parp_tier2;
+	limit = READ_ONCE(state->limit_bytes);
+	headroom = READ_ONCE(state->headroom_bytes);
+	if (limit && limit != U64_MAX) {
+		u32 headroom_q15;
+
+		if (headroom >= limit)
+			headroom_q15 = PARP_Q15_ONE;
+		else
+			/* Keep the 8 GiB cgroup divisor fully 64-bit. lzx-note */
+			headroom_q15 = mul_u64_u64_div_u64(headroom,
+							      PARP_Q15_ONE, limit);
+
+		/*
+		 * Parent headroom controls whether/how much Tier2 reclaims. It must
+		 * not cap every child application's ordinal LSTM score, otherwise all
+		 * children share the same near-zero bin under pressure. lzx-note
+		 */
+		if (!have_signal) {
+			score = headroom_q15;
+			have_signal = true;
+			atomic64_inc(&parp_reclaim_bin_stats.headroom_fallback_scores);
+		}
+		atomic64_inc(&parp_reclaim_bin_stats.headroom_hits);
+	}
+
+	if (!have_signal) {
+		atomic64_inc(&parp_reclaim_bin_stats.fallbacks);
+		return false;
+	}
+
+	*score_q15 = score;
+	atomic64_inc(&parp_reclaim_bin_stats.scored);
+	atomic64_inc(&parp_reclaim_bin_stats.score_bins[
+		min_t(unsigned int, score * 8U >> 15, 7)]);
+	return true;
+} /* lzx-note */
+
