+    def test_21_next_online_no_truth(self):
+        self.assertTrue(no_forbidden_features(['predicted_transition_probability']))
+
+    def test_22_segment_no_truth(self):
+        self.assertTrue(no_forbidden_features(['kernel_embedding']))
