+/*
+ * Lower prediction bins get exponentially more pages from the first visit.
+ * Swappiness stays below ANON_ONLY so cold clean/dirty file pages remain
+ * eligible alongside anonymous pages. lzx-note
+ */
+bool parp_tier2_reclaim_cold_pressure(unsigned int bin,
+				       u8 *priority_boost,
+				       u16 *swappiness) /* lzx-note */
+{
+	unsigned int max_bin;
+
+	if (!priority_boost || !swappiness ||
+	    !parp_tier2_reclaim_cold_aggressive_apply_enabled())
+		return false;
+
+	max_bin = READ_ONCE(sysctl_parp_reclaim_cold_bin_max);
+	if (bin > min_t(unsigned int, max_bin, 7))
+		return false;
+
+	if (!bin) {
+		*priority_boost = 3;
+		*swappiness = 140;
+	} else if (bin == 1) {
+		*priority_boost = 2;
+		*swappiness = 120;
+	} else {
+		*priority_boost = 1;
+		*swappiness = 100;
+	}
+	return true;
+} /* lzx-note */
