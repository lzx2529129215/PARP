+/*
+ * A reclaim target is normally the experiment slice, not an application
+ * scope.  Ordering therefore depends on an enabled policy ancestor, while
+ * the individual descendants provide the LSTM scores. lzx-note
+ */
+bool parp_tier2_reclaim_bin_order_enabled(struct mem_cgroup *memcg) /* lzx-note */
+{
+	return memcg && !mem_cgroup_is_root(memcg) &&
+	       parp_tier2_reclaim_bin_apply_enabled() &&
+	       parp_reclaim_bin_policy_memcg(memcg); /* lzx-note */
+} /* lzx-note */
