+
+
+def replace_once(text, old, new):
+    count = text.count(old)
+    if count != 1:
+        raise AssertionError("expected one occurrence, found %d: %s" % (count, old[:100]))
+    return text.replace(old, new, 1)
+
+
+def build(source, destination):
+    payload = source.read_bytes()
