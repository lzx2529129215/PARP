diff --git a/mm/parp/Kconfig b/mm/parp/Kconfig
new file mode 100644
index 000000000..d2350ef89
--- /dev/null
+++ b/mm/parp/Kconfig
@@ -0,0 +1,143 @@
+# SPDX-License-Identifier: GPL-2.0
+menu "LZX PARP memory optimization experiments" # lzx-note
+
+config PARP
+	bool "Page-Access Reclaim Predictor"
+	depends on LRU_GEN
+	depends on MEMCG
+	select DEBUG_FS
+	help
+	  Build the low-intrusion Page-Access Reclaim Predictor. The default
+	  mode is observe-only: recommendations are traced but native MGLRU
+	  reclaim decisions remain unchanged.
+
+config PARP_KUNIT_TEST
+	tristate "KUnit tests for PARP" if !KUNIT_ALL_TESTS
+	depends on PARP && KUNIT
+	default KUNIT_ALL_TESTS
+	help
+	  Test fixed-point scoring, expiry, state assignment and observe-only
+	  behavior.
+
+config PARP_MYFS # lzx-note
+	bool "Enable the /dev/myfs PARP prediction interface"
+	depends on PARP
+	default y
+	help
+	  Expose a versioned misc character device used by the resident PARP
+	  service to replace one LSTM prediction batch and its cgroup bindings
+	  atomically. This is the supported prediction control interface; writable
+	  app-prior and app-bind debugfs files are not created.
+
+config PARP_TIER2 # lzx-note
+	bool "Enable PARP cgroup Tier2 prediction and reclaim scheduling"
+	depends on PARP
+	default n
+	help
+	  Build the per-cgroup secondary-watermark predictor and bounded proactive
+	  reclaim. The runtime master switch vm.tier2_predict_enabled defaults to
+	  0, and each target cgroup must also set memory.tier2_enabled to 1. This
+	  permits an exact OFF versus Tier2-only comparison with the same kernel
+	  image.
+
+config PARP_TIER2_WSS_PREDICT # lzx-note
+	bool "Gate PARP Tier2 reclaim with future working-set prediction"
+	depends on PARP_TIER2 && PARP_MYFS
+	default n
+	help
+	  Consume the resident service's ABI-v2 future-working-set estimate before
+	  the secondary watermark is reached.  A bounded three-state controller
+	  keeps the configured watermark, lowers the usage watermark to reclaim
+	  earlier when predicted non-resident demand is large, or raises it toward
+	  the hard allocation watermark when the predicted working set is already
+	  resident. Missing, stale, low-confidence or domain-mismatched estimates
+	  fail closed to the original Tier2 behavior. The runtime switch
+	  vm.tier2_wss_predict_enabled permits an exact same-kernel ablation.
+
+config PARP_RECLAIM_BIN_SCORE # lzx-note
+	bool "Enable PARP MGLRU memcg reclaim-bin scoring"
+	depends on PARP_TIER2
+	default n
+	help
+	  Build the app-prior and Tier2-headroom scorer that maps a memcg into
+	  the existing MGLRU reclaim bins. The scorer changes bin placement and
+	  ordered bin scanning only while PARP is in APPLY mode, the independent
+	  vm.parp_reclaim_bin_enabled switch is one, and the target cgroup has
+	  memory.tier2_enabled set to one as its experiment-scope marker. The
+	  Tier2 proactive-reclaim master may remain zero for a bin-only ablation.
+	  When this option is disabled, MGLRU keeps its native random bin placement
+	  and starting-bin behavior. # lzx-note
+
+config PARP_RECLAIM_COLD_AGGRESSIVE # lzx-note
+	bool "Increase first-pass reclaim pressure for prediction-cold memcgs"
+	depends on PARP_RECLAIM_BIN_SCORE
+	default n
+	help
+	  Build a bounded per-memcg pressure policy on top of reclaim-bin ordering.
+	  Prediction-cold bins receive a probability-dependent priority boost,
+	  balanced anonymous/file pressure, and dirty-page writeback permission on
+	  their first visit. The original scan_control values are restored before
+	  scanning the next memcg, so predicted-hot and unrelated workloads retain
+	  native pressure. The independent
+	  vm.parp_reclaim_cold_aggressive_enabled switch defaults to zero and permits
+	  exact bin-only versus bin-plus-pressure ablation. # lzx-note
+
+config PARP_DAMON_ALIGNMENT
+	bool "Collect DAMON VADDR aggregation evidence for PARP"
+	depends on PARP && DAMON_VADDR
+	default n # lzx-note
+	help
+	  Copy DAMON aggregation records into an asynchronous PARP alignment
+	  worker. This remains evidence-only by default and never changes
+	  reclaim, prefetch, pageout, generations, or scan budgets. Records are
+	  classified against referenced process VMAs and published through bounded,
+	  immutable evidence snapshots for later PARP observation.
+
+config PARP_FRONTIER_SCORE
+	bool "Observe PARP per-folio scores at the MGLRU reclaim frontier"
+	depends on PARP
+	select PAGE_EXTENSION
+	default n
+	help
+	  Build the fixed-cost, integer-only reclaim-frontier scorer. Runtime
+	  mode is disabled by default. The only enabled non-zero mode is SHADOW:
+	  it records decisions after native MGLRU sorting, but never changes a
+	  folio generation or isolation result. APPLY is deliberately rejected
+	  until separate runtime validation authorizes it.
+
+config PARP_EFFECTIVE_TIER
+	bool "Predict MGLRU effective tiers from short-term folio reuse"
+	depends on PARP && !PARP_FRONTIER_SCORE
+	select PAGE_EXTENSION
+	default n
+	help
+	  Build a fixed-cost, integer-only GLOBAL reuse scorer at the native
+	  MGLRU tier-protection gate. The scorer computes a virtual Q8 tier
+	  adjustment without changing the native LRU_REFS tier. Runtime is OFF by
+	  default; SHADOW records native and effective decisions while preserving
+	  native behavior. This option is mutually exclusive with the older
+	  post-sort frontier experiment.
+
+config PARP_EFFECTIVE_TIER_EXPERIMENTAL_APPLY
+	bool "Allow experimental PARP effective-tier APPLY modes"
+	depends on PARP_EFFECTIVE_TIER
+	default n
+	help
+	  Permit the protect-only, bounded bidirectional, random-matched and
+	  recency-baseline APPLY modes. Keep this disabled until live SHADOW,
+	  KUnit runtime and reclaim-lock latency gates have passed. When disabled,
+	  every APPLY mode setter returns -EOPNOTSUPP.
+
+config PARP_APP_PRIOR_TIER_PROTECT # lzx-note
+	bool "Guide effective-tier protection with /dev/myfs app priors"
+	depends on PARP_EFFECTIVE_TIER && PARP_MYFS
+	default n
+	help
+	  Add a bounded signed bias from the atomic /dev/myfs application prediction
+	  state to the per-page reuse score. The foreground application and LSTM
+	  Top-ranked candidates receive rank-calibrated protection; low-ranked apps
+	  may receive one bounded cold offset in bidirectional mode. Existing page
+	  history, consecutive-candidate and budget gates remain mandatory. Disable
+	  this option for a compile-time application-prior ablation. lzx-note
+
+endmenu # lzx-note
