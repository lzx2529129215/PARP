+        "current_head": "UNKNOWN_UNTIL_DRIVER_WRITES",
+        "input_manifest_hash": manifest["input_manifest_hash"],
+        "completed_outputs": sorted(str(path.relative_to(output)) for path in output.rglob("*") if path.is_file()),
