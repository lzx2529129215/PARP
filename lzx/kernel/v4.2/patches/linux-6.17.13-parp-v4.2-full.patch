+static void parp_cold_reclaim_enter(struct mem_cgroup *memcg,
+				    struct scan_control *sc,
+				    unsigned int bin,
+				    struct parp_cold_reclaim_context *ctx) /* lzx-note */
+{
+	u8 priority_boost;
+	u16 swappiness;
+	int native_swappiness;
+
+	memset(ctx, 0, sizeof(*ctx));
+	if (!parp_tier2_reclaim_cold_pressure(bin, &priority_boost,
+					      &swappiness))
+		return;
+
+	ctx->active = true;
+	ctx->bin = bin;
+	ctx->priority = sc->priority;
+	ctx->priority_boost = sc->priority > 0 ?
+		min_t(u8, priority_boost, sc->priority) : 0;
+	ctx->may_writepage = sc->may_writepage;
+	ctx->swappiness_override = sc->parp_swappiness_override;
+	ctx->scanned = sc->nr_scanned;
+	ctx->reclaimed = sc->nr_reclaimed;
+
+	native_swappiness = sc_swappiness(sc, memcg);
+	ctx->swappiness = max_t(u16, native_swappiness, swappiness);
+	ctx->writepage_promoted = !sc->may_writepage;
+	ctx->swappiness_promoted = ctx->swappiness > native_swappiness;
+	sc->priority -= ctx->priority_boost;
+	sc->may_writepage = 1;
+	sc->parp_swappiness_override = ctx->swappiness + 1;
+} /* lzx-note */
+
+static void parp_cold_reclaim_exit(struct scan_control *sc,
+				   struct parp_cold_reclaim_context *ctx) /* lzx-note */
+{
