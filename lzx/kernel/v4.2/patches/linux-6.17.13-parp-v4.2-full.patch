+bool parp_effective_tier_get_trace_all_candidates(void) /* lzx-note */
+{
+	return READ_ONCE(parp_tier_trace_all_candidates);
+} /* lzx-note */
+
+int parp_effective_tier_set_trace_all_candidates(bool enabled) /* lzx-note */
+{
+	int error = 0;
+
+	mutex_lock(&parp_tier_trace_all_lock);
+	mutex_lock(&parp_tier_mode_lock);
+	if (READ_ONCE(parp_tier_mode) != PARP_EFFECTIVE_TIER_OFF)
+		error = -EBUSY;
+	else
+		WRITE_ONCE(parp_tier_trace_all_candidates, enabled);
+	mutex_unlock(&parp_tier_mode_lock);
+	mutex_unlock(&parp_tier_trace_all_lock);
+	return error;
+} /* lzx-note */
