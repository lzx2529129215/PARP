+    os.replace(tmp,path)
+
+
+def atomic_text(path,text):
+    path=Path(path); path.parent.mkdir(parents=True,exist_ok=True); tmp=path.with_name(path.name+".tmp")
+    tmp.write_text(text,encoding="utf-8"); os.replace(tmp,path)
+
+
+def write_jsonl_gz(path,rows):
