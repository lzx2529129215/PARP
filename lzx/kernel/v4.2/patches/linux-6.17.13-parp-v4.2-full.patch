+	unsigned long reclaimed;
+
+	if (!ctx->active)
+		return;
+	scanned = sc->nr_scanned - ctx->scanned;
+	reclaimed = sc->nr_reclaimed - ctx->reclaimed;
+	sc->priority = ctx->priority;
+	sc->may_writepage = ctx->may_writepage;
+	sc->parp_swappiness_override = ctx->swappiness_override;
+	parp_tier2_reclaim_cold_note(ctx->bin, ctx->priority_boost,
+		ctx->writepage_promoted, ctx->swappiness_promoted,
+		scanned, reclaimed);
+} /* lzx-note */
+
+static bool parp_cold_reclaim_skip(struct scan_control *sc,
+				   struct parp_cold_reclaim_context *ctx) /* lzx-note */
+{
+	return sc->parp_cold_only && !ctx->active;
+} /* lzx-note */
