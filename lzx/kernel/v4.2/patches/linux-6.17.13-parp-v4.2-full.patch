+        "Random Forest":lambda:RandomForestLite(trees=48),"HistGradientBoosting":lambda:HistGradientBoostingLite(rounds=6)}
+    model=constructors[kind]().fit(scaler.transform(x),y); positive=model.classes.index("1")
