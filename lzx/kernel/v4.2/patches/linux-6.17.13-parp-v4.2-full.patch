+
+def main():
+    p=argparse.ArgumentParser(); p.add_argument("--phase28b",type=Path,required=True); p.add_argument("--output",type=Path,required=True); a=p.parse_args(); print(json.dumps(run(a.phase28b,a.output),sort_keys=True))
