+
+	if (!len || len >= sizeof(text) || copy_from_user(text, buf, len))
+		return -EINVAL;
+	text[len] = '\0';
+	if (kstrtouint(strim(text), 0, &mode) || parp_set_evidence_mode(mode))
+		return -EINVAL;
+	return len;
+}
+
+static const struct file_operations evidence_mode_fops = {
