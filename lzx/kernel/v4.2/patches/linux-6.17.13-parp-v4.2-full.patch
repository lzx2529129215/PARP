+        "\tif [[ -n ${sampler_pid:-} ]]; then\n"
+        "\t\tkill -INT \"$sampler_pid\" 2>/dev/null || true\n"
+        "\t\twait \"$sampler_pid\" 2>/dev/null || true\n"
+        "\t\tsampler_pid=\n"
