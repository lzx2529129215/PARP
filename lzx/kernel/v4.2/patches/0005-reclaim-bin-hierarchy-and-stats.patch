+#ifdef CONFIG_PARP_RECLAIM_BIN_SCORE /* lzx-note */
+/*
+ * A systemd scope created below an enabled experiment slice must use the
+ * nearest enabled ancestor's headroom policy.  Per-app context lookup still
+ * starts at the leaf memcg so application priors remain specific. lzx-note
+ */
+static struct mem_cgroup *parp_reclaim_bin_policy_memcg(
+		struct mem_cgroup *memcg) /* lzx-note */
+{
+	struct mem_cgroup *iter;
+
+	for (iter = memcg; iter && !mem_cgroup_is_root(iter);
+	     iter = parent_mem_cgroup(iter)) {
+		if (READ_ONCE(iter->parp_tier2.enabled))
+			return iter;
+	}
+
+	return NULL;
+} /* lzx-note */
+
+bool parp_tier2_reclaim_bin_apply_enabled(void) /* lzx-note */
+{
+	return parp_get_mode() == PARP_MODE_APPLY &&
+	       parp_tier2_runtime_enabled();
+} /* lzx-note */
+
+bool parp_tier2_reclaim_bin_score(struct mem_cgroup *memcg,
+				  u32 *score_q15) /* lzx-note */
+{
+	struct mem_cgroup *policy_memcg;
+	struct parp_tier2_memcg *state;
+	struct parp_app_context app;
+	u64 now = ktime_get_mono_fast_ns();
+	u64 domain_id;
+	u64 limit;
+	u64 headroom;
+	u32 score = 0;
+	bool have_signal = false;
+
+	if (!memcg || !score_q15 || mem_cgroup_is_root(memcg) ||
+	    !parp_tier2_reclaim_bin_apply_enabled())
+		return false;
+
+	atomic64_inc(&parp_reclaim_bin_stats.lookups);
+	policy_memcg = parp_reclaim_bin_policy_memcg(memcg);
+	if (!policy_memcg) {
+		atomic64_inc(&parp_reclaim_bin_stats.fallbacks);
+		return false;
+	}
+
+	atomic64_inc(&parp_reclaim_bin_stats.policy_hits);
+	if (policy_memcg != memcg)
+		atomic64_inc(&parp_reclaim_bin_stats.inherited_hits);
+
+	domain_id = parp_memcg_domain_id(memcg);
+	if (domain_id && parp_context_lookup(domain_id, now, &app)) {
+		score = app.app_prior_q15;
+		have_signal = true;
+		atomic64_inc(&parp_reclaim_bin_stats.context_hits);
+	}
+
+	state = &policy_memcg->parp_tier2;
+	limit = READ_ONCE(state->limit_bytes);
+	headroom = READ_ONCE(state->headroom_bytes);
+	if (limit && limit != U64_MAX) {
+		u32 headroom_q15;
+
+		if (headroom >= limit)
+			headroom_q15 = PARP_Q15_ONE;
+		else
+			/* Keep the 8 GiB cgroup divisor fully 64-bit. lzx-note */
+			headroom_q15 = mul_u64_u64_div_u64(headroom,
+							      PARP_Q15_ONE, limit);
+
+		score = have_signal ? min(score, headroom_q15) : headroom_q15;
+		have_signal = true;
+		atomic64_inc(&parp_reclaim_bin_stats.headroom_hits);
+	}
+
+	if (!have_signal) {
+		atomic64_inc(&parp_reclaim_bin_stats.fallbacks);
+		return false;
+	}
+
+	*score_q15 = score;
+	atomic64_inc(&parp_reclaim_bin_stats.scored);
+	return true;
+} /* lzx-note */
+
+void parp_tier2_reclaim_bin_stats_snapshot(
+		struct parp_reclaim_bin_stats *stats) /* lzx-note */
+{
+	if (!stats)
+		return;
+
+	stats->lookups = atomic64_read(&parp_reclaim_bin_stats.lookups);
+	stats->policy_hits = atomic64_read(&parp_reclaim_bin_stats.policy_hits);
+	stats->inherited_hits = atomic64_read(&parp_reclaim_bin_stats.inherited_hits);
+	stats->context_hits = atomic64_read(&parp_reclaim_bin_stats.context_hits);
+	stats->headroom_hits = atomic64_read(&parp_reclaim_bin_stats.headroom_hits);
+	stats->scored = atomic64_read(&parp_reclaim_bin_stats.scored);
+	stats->fallbacks = atomic64_read(&parp_reclaim_bin_stats.fallbacks);
+} /* lzx-note */
+#endif /* CONFIG_PARP_RECLAIM_BIN_SCORE */ /* lzx-note */
+
