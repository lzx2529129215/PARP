+s32 parp_effective_tier_app_prior_bias(u16 app_prior_q15, u16 app_rank,
+		bool foreground, const struct parp_tier_policy *policy)
+{
+	s32 bias;
+
+	if (!parp_tier_policy_valid(policy) || app_prior_q15 > PARP_Q15_ONE ||
+	    !app_rank)
+		return 0;
+
+	/*
+	 * Preserve the LSTM probability ordering, then calibrate rank 1 (the
+	 * foreground app) and ranks 2..4 (LSTM Top-3) to the page model's hot
+	 * thresholds. This is positive-only and capped at hot_threshold_2; the
+	 * ordinary pressure and page-budget gates still decide whether a page can
+	 * actually be protected. lzx-note
+	 */
+	bias = div_u64((u64)app_prior_q15 * policy->hot_threshold_2,
+		       PARP_Q15_ONE);
+	if (foreground || app_rank <= 2)
+		bias = max(bias, policy->hot_threshold_2);
+	else if (app_rank <= 4)
+		bias = max(bias, policy->hot_threshold_1);
+
+	return clamp(bias, 0, policy->hot_threshold_2);
+}
