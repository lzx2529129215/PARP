@@ -1958,7 +1958,12 @@ int parp_effective_tier_set_mode(enum parp_effective_tier_mode mode)
 	if (mode >= PARP_EFFECTIVE_TIER_PROTECT_ONLY &&
 	    !IS_ENABLED(CONFIG_PARP_EFFECTIVE_TIER_EXPERIMENTAL_APPLY))
 		return -EOPNOTSUPP;
-	if (mode == PARP_EFFECTIVE_TIER_SHADOW &&
+	/* Every active mode reads or updates the boot-reserved per-page state.
+	 * Reject the transition before enabling the static key instead of
+	 * accepting an APPLY mode that can only latch state_fault and fall back.
+	 * lzx-note
+	 */
+	if (mode != PARP_EFFECTIVE_TIER_OFF &&
 	    !parp_effective_tier_metadata_ready())
 		return -EOPNOTSUPP; /* #lzx */
 	mutex_lock(&parp_tier_mode_lock);
