@@ -231,6 +231,12 @@ class Phase210Contracts(unittest.TestCase):
         self.assertEqual(result, "42")
         self.assertEqual(calls, [["xdotool", "search", "--class", "^parp-phase210-qq$"]])
 
+    def test_46_every_window_state_can_recover_hidden_qq(self):
