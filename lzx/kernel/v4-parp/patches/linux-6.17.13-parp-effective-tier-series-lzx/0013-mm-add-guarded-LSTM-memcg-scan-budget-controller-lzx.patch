+	bool valid;
+	u64 native_nr_to_scan;
+	u64 proposed_nr_to_scan;
+	u64 applied_nr_to_scan;
+	u32 multiplier_q15;
+	u16 confidence_q15;
+	enum parp_scan_budget_reason reason;
+	u32 reason_flags;
+	u64 budget_sequence;
+};
