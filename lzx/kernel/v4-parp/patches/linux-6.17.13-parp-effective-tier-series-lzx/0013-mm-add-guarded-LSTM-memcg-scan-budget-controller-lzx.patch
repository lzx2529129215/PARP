+	PARP_SCAN_REASON_CIRCUIT_BREAKER,
+	PARP_SCAN_REASON_CLAMP_MIN,
+	PARP_SCAN_REASON_CLAMP_MAX,
+	PARP_SCAN_REASON_DISABLED,
+};
