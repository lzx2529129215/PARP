+};
+
+enum parp_reclaim_scope {
+	PARP_RECLAIM_SCOPE_UNKNOWN,
+	PARP_RECLAIM_SCOPE_GLOBAL_KSWAPD,
+	PARP_RECLAIM_SCOPE_GLOBAL_DIRECT,
