+                     SoftmaxRegression, Standardizer, binary_metrics)
+
+HORIZONS=(10,30,60); SESSIONS=("wps_01","wps_02","wps_03","files_01","files_02")
+TRAIN={"wps_01","files_01"}; VALID={"wps_02"}; TEST={"wps_03","files_02"}
