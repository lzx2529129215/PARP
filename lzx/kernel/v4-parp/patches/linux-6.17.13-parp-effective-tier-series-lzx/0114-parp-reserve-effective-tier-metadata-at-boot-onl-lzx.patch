From 0946265865f1c2d9ec7fee1a0c76103cf51a786a Mon Sep 17 00:00:00 2001
From: Codex PARP Reproduction <codex@localhost>
Date: Wed, 5 Aug 2026 09:12:02 +0800
Subject: [PATCH 114/124] parp: reserve effective-tier metadata at boot only

---
 include/linux/parp.h                          |  1 +
 mm/parp/core/effective_tier.c                 | 36 +++++++++++++++++--
 mm/parp/tests/parp_test.c                     | 14 ++++++++
 tools/parp/effective_tier/README.md           | 14 ++++++++
 .../effective_tier/live_shadow_preflight.py   | 24 +++++++++++++
 5 files changed, 87 insertions(+), 2 deletions(-)

diff --git a/include/linux/parp.h b/include/linux/parp.h
index 93c0d47d5..83b10ef3c 100644
--- a/include/linux/parp.h
+++ b/include/linux/parp.h
@@ -342,6 +342,7 @@ void __parp_effective_tier_lock_finish(
 
 enum parp_effective_tier_mode parp_effective_tier_get_mode(void);
 int parp_effective_tier_set_mode(enum parp_effective_tier_mode mode);
+bool parp_effective_tier_metadata_ready(void);
 ssize_t parp_effective_tier_format_stats(char *buf, size_t size);
 ssize_t parp_effective_tier_format_config(char *buf, size_t size);
 int parp_effective_tier_set_config(const char *buf);
diff --git a/mm/parp/core/effective_tier.c b/mm/parp/core/effective_tier.c
index c672e8eea..5ed52345c 100644
--- a/mm/parp/core/effective_tier.c
+++ b/mm/parp/core/effective_tier.c
@@ -160,15 +160,35 @@ static atomic64_t parp_tier_trace_sequence = ATOMIC64_INIT(0);
 static siphash_key_t parp_tier_cookie_key __read_mostly;
 static u8 parp_tier_state_epoch __read_mostly;
 static atomic_t parp_tier_state_fault = ATOMIC_INIT(0);
+static bool parp_tier_metadata_requested;
+static bool parp_tier_metadata_ready;
+
+static int __init parp_effective_tier_reserve_setup(char *str)
+{
+	bool reserve;
+
+	/* A malformed or omitted request must retain the no-allocation default. */
+	if (!str || kstrtobool(str, &reserve))
+		return 0;
+	WRITE_ONCE(parp_tier_metadata_requested, reserve);
+	return 0;
+}
+early_param("parp_effective_tier_reserve", parp_effective_tier_reserve_setup);
 
 static bool __init parp_effective_tier_page_ext_needed(void)
 {
-	return true;
+	return READ_ONCE(parp_tier_metadata_requested);
+}
+
+static void __init parp_effective_tier_page_ext_init(void)
+{
+	WRITE_ONCE(parp_tier_metadata_ready, true);
 }
 
 struct page_ext_operations parp_effective_tier_page_ext_ops = {
 	.size = sizeof(struct parp_reuse_page_ext),
 	.need = parp_effective_tier_page_ext_needed,
+	.init = parp_effective_tier_page_ext_init,
 };
 
 static int __init parp_effective_tier_init(void)
@@ -1909,6 +1929,11 @@ enum parp_effective_tier_mode parp_effective_tier_get_mode(void)
 	return READ_ONCE(parp_tier_mode);
 }
 
+bool parp_effective_tier_metadata_ready(void)
+{
+	return READ_ONCE(parp_tier_metadata_ready);
+}
+
 int parp_effective_tier_set_mode(enum parp_effective_tier_mode mode)
 {
 	struct parp_tier_runtime_config config;
@@ -1920,6 +1945,9 @@ int parp_effective_tier_set_mode(enum parp_effective_tier_mode mode)
 	if (mode >= PARP_EFFECTIVE_TIER_PROTECT_ONLY &&
 	    !IS_ENABLED(CONFIG_PARP_EFFECTIVE_TIER_EXPERIMENTAL_APPLY))
 		return -EOPNOTSUPP;
+	if (mode == PARP_EFFECTIVE_TIER_SHADOW &&
+	    !parp_effective_tier_metadata_ready())
+		return -EOPNOTSUPP;
 	mutex_lock(&parp_tier_mode_lock);
 	if (mode >= PARP_EFFECTIVE_TIER_PROTECT_ONLY &&
 	    (!parp_runtime_config_read(&config) ||
@@ -1964,6 +1992,8 @@ ssize_t parp_effective_tier_format_config(char *buf, size_t size)
 		"model GLOBAL_REUSE_MODEL\nmodel_type %s\nmodel_version %u\n"
 		"model_checksum %s\nmodel_provenance %s\n"
 		"feature_schema_version %u\nconfig_sequence %u\n"
+		"metadata_reservation_requested %u\nmetadata_ready %u\n"
+		"metadata_payload_bytes %zu\n"
 		"cold_threshold %d\nhot_threshold_1 %d\n"
 		"hot_threshold_2 %d\nhot_threshold_3 %d\n"
 		"max_upgrade_tiers %u\n"
@@ -1976,7 +2006,9 @@ ssize_t parp_effective_tier_format_config(char *buf, size_t size)
 		PARP_TIER_MODEL_TYPE, PARP_TIER_MODEL_VERSION,
 		PARP_TIER_MODEL_CHECKSUM, PARP_TIER_MODEL_PROVENANCE,
 		PARP_TIER_SCHEMA_VERSION,
-		config.sequence, config.policy.cold_threshold,
+		config.sequence, READ_ONCE(parp_tier_metadata_requested),
+		READ_ONCE(parp_tier_metadata_ready),
+		parp_effective_tier_metadata_size(), config.policy.cold_threshold,
 		config.policy.hot_threshold_1,
 		config.policy.hot_threshold_2,
 		config.policy.hot_threshold_3,
diff --git a/mm/parp/tests/parp_test.c b/mm/parp/tests/parp_test.c
index edeebb0c1..a7cefb55e 100644
--- a/mm/parp/tests/parp_test.c
+++ b/mm/parp/tests/parp_test.c
@@ -1088,6 +1088,11 @@ static void parp_effective_access_lifetime_test(struct kunit *test)
 	u32 last_access;
 	int error;
 
+	if (!parp_effective_tier_metadata_ready()) {
+		kunit_skip(test, "effective-tier metadata was not boot-reserved");
+		return;
+	}
+
 	page = alloc_page(GFP_KERNEL);
 	KUNIT_ASSERT_NOT_NULL(test, page);
 	folio = page_folio(page);
@@ -1129,6 +1134,11 @@ static void parp_effective_epoch_limit_test(struct kunit *test)
 	struct page *page;
 	int error;
 
+	if (!parp_effective_tier_metadata_ready()) {
+		kunit_skip(test, "effective-tier metadata was not boot-reserved");
+		return;
+	}
+
 	page = alloc_page(GFP_KERNEL);
 	KUNIT_ASSERT_NOT_NULL(test, page);
 	folio = page_folio(page);
@@ -1180,6 +1190,10 @@ static void parp_effective_config_safety_test(struct kunit *test)
 	KUNIT_EXPECT_FALSE(test, IS_ENABLED(CONFIG_PARP_FRONTIER_SCORE));
 	KUNIT_EXPECT_EQ(test, parp_effective_tier_get_mode(),
 		PARP_EFFECTIVE_TIER_OFF);
+	if (!parp_effective_tier_metadata_ready())
+		KUNIT_EXPECT_EQ(test,
+				parp_effective_tier_set_mode(PARP_EFFECTIVE_TIER_SHADOW),
+				-EOPNOTSUPP);
 	if (!IS_ENABLED(CONFIG_PARP_EFFECTIVE_TIER_EXPERIMENTAL_APPLY))
 		KUNIT_EXPECT_EQ(test, parp_effective_tier_set_mode(
 			PARP_EFFECTIVE_TIER_BIDIRECTIONAL), -EOPNOTSUPP);
diff --git a/tools/parp/effective_tier/README.md b/tools/parp/effective_tier/README.md
index 5898f983b..cfcaf114d 100644
--- a/tools/parp/effective_tier/README.md
+++ b/tools/parp/effective_tier/README.md
@@ -48,6 +48,20 @@ non-overridable protection. Large folios are counted in base pages; scoring
 does not multiply their influence by treating one folio as one page. Compressed
 timestamps use modulo-2^32 subtraction via `u32_elapsed()`.
 
+## Live SHADOW metadata reservation
+
+The kernel defaults to OFF without allocating per-page reuse metadata. A live
+SHADOW boot must explicitly include `parp_effective_tier_reserve=1` on its
+one-time kernel command line. This is intentionally a boot-only reservation:
+the page-extension allocator runs before runtime debugfs mode changes, and a
+runtime request cannot safely create metadata for pages that are already live.
+Without that parameter, `effective_tier_config` reports `metadata_ready 0`
+and the SHADOW mode write fails closed with `-EOPNOTSUPP`. The same file
+reports `metadata_payload_bytes`; on this host the payload is 24B/page (about
+94 MiB at 16 GiB RAM, roughly 125 MiB including page-extension headers). The
+read-only live preflight treats missing boot reservation as a blocker and never
+changes the mode itself.
+
 Run from the kernel tree root:
 
 ```sh
diff --git a/tools/parp/effective_tier/live_shadow_preflight.py b/tools/parp/effective_tier/live_shadow_preflight.py
index 0d2b9869b..08e0a187f 100644
--- a/tools/parp/effective_tier/live_shadow_preflight.py
+++ b/tools/parp/effective_tier/live_shadow_preflight.py
@@ -78,6 +78,17 @@ def _path_state(path: Path) -> Dict[str, object]:
     return {"exists": True, "readable": _text(path) is not None}
 
 
+def _key_value_text(text: Optional[str]) -> Dict[str, str]:
+    """Parse the simple, read-only PARP debugfs key/value format."""
+
+    values: Dict[str, str] = {}
+    for line in (text or "").splitlines():
+        key, separator, value = line.partition(" ")
+        if key and separator:
+            values[key] = value.strip()
+    return values
+
+
 def _sha256(path: Path) -> Optional[str]:
     try:
         digest = hashlib.sha256()
@@ -327,10 +338,16 @@ def create_preflight(tree: Path, output: Path, build_dir: Optional[Path],
     if running_release != expected_release:
         blockers.append("target_kernel_not_running")
     debugfs_paths = ["/sys/kernel/debug/parp/effective_tier_mode",
+                     "/sys/kernel/debug/parp/effective_tier_config",
                      "/sys/kernel/debug/parp/effective_tier_stats"]
     debugfs_state = {path: _path_state(Path(path)) for path in debugfs_paths}
     if not all(bool(state["readable"]) for state in debugfs_state.values()):
         blockers.append("effective_tier_debugfs_unavailable_or_inaccessible")
+    metadata_config = _key_value_text(
+        _text(Path("/sys/kernel/debug/parp/effective_tier_config")))
+    metadata_ready = metadata_config.get("metadata_ready")
+    if running_release == expected_release and metadata_ready != "1":
+        blockers.append("effective_tier_metadata_not_boot_reserved")
 
     repository_audit = {
         "baseline_head": BASELINE_HEAD,
@@ -357,6 +374,13 @@ def create_preflight(tree: Path, output: Path, build_dir: Optional[Path],
     boot_inspection = {
         "uname": _run(["uname", "-a"]),
         "cmdline": _text(Path("/proc/cmdline")),
+        "effective_tier_metadata": {
+            "reservation_requested": metadata_config.get(
+                "metadata_reservation_requested"),
+            "ready": metadata_ready,
+            "payload_bytes": metadata_config.get("metadata_payload_bytes"),
+            "required_kernel_parameter": "parp_effective_tier_reserve=1",
+        },
         "root_filesystem": _run(["findmnt", "-n", "-o", "SOURCE,FSTYPE,OPTIONS", "/"]),
         "boot_space": _run(["df", "-B1", "/boot"]),
         "grub_environment": _run(["grub-editenv", "list"]),
-- 
