From cd559c31aca50050305e33d245fcdaa74ce00df8 Mon Sep 17 00:00:00 2001
From: Codex PARP Reproduction <codex@localhost>
Date: Mon, 3 Aug 2026 17:50:07 +0800
Subject: [PATCH 075/124] fix: tolerate exiting QQ workers in cgroup guard

---
 tools/parp/phase210/qq_collection_root.sh            | 11 ++++++++++-
 tools/parp/phase210/tests/test_phase210_contracts.py |  2 ++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/tools/parp/phase210/qq_collection_root.sh b/tools/parp/phase210/qq_collection_root.sh
index 76cefaa84..070081aad 100644
--- a/tools/parp/phase210/qq_collection_root.sh
+++ b/tools/parp/phase210/qq_collection_root.sh
@@ -354,9 +354,15 @@ collect_session()
 		fi
 		escaped=0
 		for pid in "${discovered_pids[@]}"; do
+			[[ -r /proc/$pid/cgroup ]] || continue
 			current_cgroup=$(sed -n 's/^0:://p' "/proc/$pid/cgroup" 2>/dev/null || true)
+			[[ -n $current_cgroup ]] || continue
 			if [[ $current_cgroup != "$control_group" ]]; then
-				printf '%s\n' "$pid" >"$cgroup_path/cgroup.procs"
+				if ! printf '%s\n' "$pid" >"$cgroup_path/cgroup.procs" 2>/dev/null; then
+					[[ -d /proc/$pid ]] || continue
+					log "ERROR: failed to attach live QQ target pid=$pid"
+					exit 95
+				fi
 				escaped=1
 			fi
 		done
@@ -459,11 +465,14 @@ collect_session()
 		if ((elapsed % 5 == 0)); then
 			mapfile -t discovered_pids < <(list_phase210_qq_pids "$profile" "$automation_pgid")
 			for pid in "${discovered_pids[@]}"; do
+				[[ -r /proc/$pid/cgroup ]] || continue
 				current_cgroup=$(sed -n 's/^0:://p' "/proc/$pid/cgroup" 2>/dev/null || true)
+				[[ -n $current_cgroup ]] || continue
 				[[ $current_cgroup == "$control_group" ]] || { log "ERROR: QQ target escaped dedicated cgroup pid=$pid cgroup=$current_cgroup"; exit 95; }
 			done
 			mapfile -t member_pids < <(cat "$cgroup_path/cgroup.procs" | sort -nu)
 			for pid in "${member_pids[@]}"; do
+				[[ -d /proc/$pid ]] || continue
 				phase210_pid_is_safe "$pid" "$profile" "$automation_pgid" || { log "ERROR: non-test process entered QQ target cgroup pid=$pid"; exit 95; }
 			done
 		fi
diff --git a/tools/parp/phase210/tests/test_phase210_contracts.py b/tools/parp/phase210/tests/test_phase210_contracts.py
index 7231d7eae..1c7d9729e 100644
--- a/tools/parp/phase210/tests/test_phase210_contracts.py
+++ b/tools/parp/phase210/tests/test_phase210_contracts.py
@@ -185,6 +185,8 @@ class Phase210Contracts(unittest.TestCase):
         self.assertIn("non-test process entered QQ target cgroup", collector)
         self.assertIn("parp-control", collector)
         self.assertIn("QQ target leaf lacks memory controller", collector)
+        self.assertIn("[[ -n $current_cgroup ]] || continue", collector)
+        self.assertIn("failed to attach live QQ target", collector)
 
 
 if __name__ == "__main__":
-- 
2.25.1

