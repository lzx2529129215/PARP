+    if state.get("status") != "PARP_PHASE210_POSITIVE_SUPPORT_PILOT_INSUFFICIENT":
+        raise RuntimeError("PILOT_STATUS_NOT_TRUSTED")
+    session = state.get("sessions", [{}])[0]
