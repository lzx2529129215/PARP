+"""Frozen mapping from all observed Phase2.7B operation labels."""
+
+import json
+from pathlib import Path
+
+_CONFIG = Path(__file__).with_name("config") / "operation_taxonomy.json"
+with _CONFIG.open(encoding="utf-8") as _stream:
+    OPERATION_TAXONOMY = json.load(_stream)["mapping"]
+
+
+def map_operation(name):
+    if name not in OPERATION_TAXONOMY:
+        raise ValueError("unmapped real operation: %s" % name)
+    return OPERATION_TAXONOMY[name]
+
+
+def eligible_classes(support, train_min=8, validation_min=3, test_min=3):
+    eligible, insufficient = [], []
+    for name, values in sorted(support.items()):
+        target = eligible if (values.get("train", 0) >= train_min and
+                              values.get("validation", 0) >= validation_min and
+                              values.get("test", 0) >= test_min) else insufficient
+        target.append(name)
+    return {"eligible": eligible, "insufficient": insufficient,
+            "thresholds": {"train": train_min, "validation": validation_min,
+                           "test": test_min}}
