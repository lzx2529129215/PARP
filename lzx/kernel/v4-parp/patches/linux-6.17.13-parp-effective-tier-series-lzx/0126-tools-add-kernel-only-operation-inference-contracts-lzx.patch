+        with self.assertRaises(ValueError):
+            validate_feature_names(["absolute_file_path"])
+
+    def test_file_id_is_not_a_feature(self):
+        with self.assertRaises(ValueError):
+            validate_feature_names(["top1_file_id"])
+
+    def test_source_map_is_complete_and_kernel_only(self):
+        names = ["foreground_app_id", "top1_active_pages_log"]
+        source = {
+            "foreground_app_id": {"source_type": "UPPER_LAYER_APP_ID", "allowed_online": True},
+            "top1_active_pages_log": {"source_type": "PARP_FILE", "allowed_online": True},
