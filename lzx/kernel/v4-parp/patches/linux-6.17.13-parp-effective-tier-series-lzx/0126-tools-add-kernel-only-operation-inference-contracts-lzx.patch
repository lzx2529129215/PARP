+        self.assertEqual(scaler.fit_sessions, ["wps_01"])
+        self.assertEqual(scaler.transform([[100.0]])[0][0], 99.0)
+
+    def test_unknown_thresholds_are_validation_only(self):
+        result = select_unknown_thresholds([.1, .2, .3, .9], targets=(.25,))
+        self.assertEqual(result["selection_source"], "validation_only")
+        self.assertIn("0.25", result["thresholds"])
