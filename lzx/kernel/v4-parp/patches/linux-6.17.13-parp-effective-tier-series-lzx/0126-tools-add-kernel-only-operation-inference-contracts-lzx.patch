+        self.assertEqual(len(OPERATION_TAXONOMY), 18)
+        self.assertEqual(OPERATION_TAXONOMY["EDIT"], "EDIT")
+        self.assertEqual(OPERATION_TAXONOMY["SAVE"], "SAVE_WRITE")
+
+    def test_insufficient_classes_are_not_fabricated(self):
+        support = {"EDIT": {"train": 7, "validation": 9, "test": 9},
+                   "NAVIGATION": {"train": 8, "validation": 3, "test": 3}}
+        result = eligible_classes(support)
+        self.assertEqual(result["eligible"], ["NAVIGATION"])
+        self.assertEqual(result["insufficient"], ["EDIT"])
+
+
+class OnlineAndProvenanceTests(unittest.TestCase):
+    def test_online_contract_rejects_future_kernel_state(self):
+        payload = {"schema_version": 1, "foreground_app_id": 1,
+                   "kernel_features": {}, "past_predictions": [],
+                   "future_kernel_features": {}}
+        with self.assertRaises(ValueError):
+            validate_online_payload(payload)
+
+    def test_online_contract_rejects_current_truth(self):
+        payload = {"schema_version": 1, "foreground_app_id": 1,
+                   "kernel_features": {}, "past_predictions": [],
+                   "ground_truth": "EDIT"}
+        with self.assertRaises(ValueError):
+            validate_online_payload(payload)
+
+    def test_raw_hash_change_is_detected(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            path = Path(temporary) / "raw"
+            path.write_bytes(b"a")
+            before = hash_paths(Path(temporary), [path])
+            path.write_bytes(b"b")
+            after = hash_paths(Path(temporary), [path])
+            self.assertNotEqual(before, after)
+            self.assertEqual(before[0][1], hashlib.sha256(b"a").hexdigest())
+
