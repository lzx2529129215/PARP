+"""Fixed-length kernel-only vector schemas and causal materialization."""
+
+from collections import defaultdict
+import math
+
+from .contracts import validate_source_map
+from .features import aggregate_other, signed_log1p, stable_top_files
+
+VERSIONS = ("V1_PAGE_ONLY", "V2_PAGE_VM", "V3_PAGE_VM_IO_CPU", "V4_TEMPORAL")
+
+VM_FIELDS = (
+    "memory_current_log", "memory_anon_bytes_log", "memory_file_bytes_log",
+    "inactive_anon_log", "active_anon_log", "inactive_pagecache_log",
+    "active_pagecache_log", "slab_log", "kernel_stack_log", "pagetables_log",
+    "swap_current_log", "pgfault_delta", "pgmajfault_delta",
+    "refault_anon_delta", "refault_pagecache_delta", "pgscan_delta",
+    "pgsteal_delta", "scan_efficiency", "refault_rate",
+)
+
+SYSTEM_FIELDS = (
+    "read_bytes_delta", "write_bytes_delta", "read_ios_delta",
+    "write_ios_delta", "discard_bytes_delta", "dirty_bytes",
+    "writeback_bytes", "version_change_count", "cpu_usage_usec_delta",
+    "user_usec_delta", "system_usec_delta", "nr_periods_delta",
+    "nr_throttled_delta", "throttled_usec_delta", "task_count",
+    "context_switch_delta", "runnable_time", "blocked_time",
+    "memory_psi_some", "memory_psi_full", "cpu_psi_some", "io_psi_some",
+    "io_psi_full",
+)
+
+
+def _source(source_type, source_file, interface, transformation,
+            availability=True, scope="APP_DOMAIN"):
+    return {"source_type": source_type, "source_file": source_file,
+            "kernel_interface": interface, "scope": scope,
+            "transformation": transformation, "availability": availability,
+            "allowed_online": True}
+
+
+def _jaccard(left, right):
+    return len(left & right) / len(left | right) if left or right else 1.0
+
+
+def _centroid(shape):
+    total = sum(shape)
+    return sum(index * value for index, value in enumerate(shape)) / total if total else 0.0
+
+
+def current_features(row, previous, top_k):
+    files = row["files"]
+    top = stable_top_files(files, top_k)
+    other = aggregate_other(files, top)
+    total_weight = sum(item["weighted_pages"] for item in files) or 1.0
+    total_active = sum(item["active_pages"] for item in files) or 1
+    values = {"pagecache_object_count": float(len(files)),
+              "active_pagecache_object_count": float(sum(item["active_pages"] > 0 for item in files)),
+              "total_active_pages_log": math.log1p(sum(item["active_pages"] for item in files)),
+              "total_weighted_pages_log": math.log1p(sum(item["weighted_pages"] for item in files))}
+    sources = {name: _source("PARP_FILE", "parp_region_evidence.raw",
+                             "parp:parp_region_evidence", "window aggregate")
+               for name in values}
+    previous_by_key = {item["file_key"]: item for item in previous["files"]} if previous else {}
+    previous_rank = {item["file_key"]: index + 1 for index, item in enumerate(
+        stable_top_files(previous["files"], top_k))} if previous else {}
+    for index in range(top_k):
+        prefix = "slot%d_" % (index + 1)
+        item = top[index] if index < len(top) else None
+        prior = previous_by_key.get(item["file_key"]) if item else None
+        rank_before = previous_rank.get(item["file_key"], 0) if item else 0
+        fields = {
+            "valid": float(item is not None),
+            "size_log": math.log1p(item["file_size"]) if item else 0.0,
+            "page_count_log": math.log1p(item["file_pages"]) if item else 0.0,
+            "active_pages_log": math.log1p(item["active_pages"]) if item else 0.0,
+            "observed_pages_log": math.log1p(item["observed_pages"]) if item else 0.0,
+            "coverage": item["coverage"] if item else 0.0,
+            "weighted_coverage": item["weighted_coverage"] if item else 0.0,
+            "region_count_log": math.log1p(item["region_count"]) if item else 0.0,
+            "mean_accesses": item["mean_nr_accesses"] if item else 0.0,
+            "max_accesses": item["max_nr_accesses"] if item else 0.0,
+            "mean_age": item["mean_age"] if item else 0.0,
+            "max_age": item["max_age"] if item else 0.0,
+            "active_segments_l10": item["active_segments_l10"] if item else 0.0,
+            "active_segments_l100": item["active_segments_l100"] if item else 0.0,
+            "activity_share": item["weighted_pages"] / total_weight if item else 0.0,
+            "active_previous": float(prior is not None and prior["active_pages"] > 0),
+            "activity_score_delta": (item["activity_score"] - prior["activity_score"])
+                                    if item and prior else 0.0,
+            "rank_previous": float(rank_before),
+            "rank_changed": float(bool(item and rank_before and rank_before != index + 1)),
+            "shape_jaccard_previous": _jaccard(
+                {i for i, x in enumerate(item["shape_l10"]) if x > 0} if item else set(),
+                {i for i, x in enumerate(prior["shape_l10"]) if x > 0} if prior else set()),
+            "centroid_shift": (_centroid(item["shape_l10"]) - _centroid(prior["shape_l10"]))
+                              if item and prior else 0.0,
+        }
+        for shape_index in range(10):
+            fields["shape_coverage_%d" % shape_index] = (
+                item["shape_l10"][shape_index] if item and shape_index < len(item["shape_l10"]) else 0.0)
+            fields["shape_weighted_%d" % shape_index] = (
+                item["weighted_shape_l10"][shape_index]
+                if item and shape_index < len(item["weighted_shape_l10"]) else 0.0)
+        for name, value in fields.items():
+            values[prefix + name] = value
+            sources[prefix + name] = _source(
+                "DERIVED_KERNEL_HISTORY" if name in ("active_previous", "activity_score_delta",
+                    "rank_previous", "rank_changed", "shape_jaccard_previous", "centroid_shift")
+                else "PARP_FILE", "parp_region_evidence.raw",
+                "parp:parp_region_evidence", "top-k stable aggregate")
+    other_values = {
+        "other_object_count": other["other_file_count"],
+        "other_active_pages_log": math.log1p(other["other_active_pages"]),
+        "other_weighted_pages_log": math.log1p(other["other_weighted_pages"]),
+        "other_region_count_log": math.log1p(other["other_region_count"]),
+        "top1_activity_share": top[0]["weighted_pages"] / total_weight if top else 0.0,
+        "topk_activity_share": sum(item["weighted_pages"] for item in top) / total_weight,
+        "topk_active_page_share": sum(item["active_pages"] for item in top) / total_active,
+        "other_mean_coverage": (sum(item["coverage"] for item in files if item not in top) /
+                                other["other_file_count"] if other["other_file_count"] else 0.0),
+        "other_max_coverage": max((item["coverage"] for item in files if item not in top), default=0.0),
+    }
