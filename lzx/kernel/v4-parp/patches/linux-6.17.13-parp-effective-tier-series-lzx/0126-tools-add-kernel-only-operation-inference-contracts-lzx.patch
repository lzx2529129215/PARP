+
+class TopKTests(unittest.TestCase):
+    def setUp(self):
+        self.files = [
+            {"file_key": "b", "activity_score": .5, "weighted_pages": 2,
+             "active_pages": 3, "region_count": 2},
+            {"file_key": "a", "activity_score": .5, "weighted_pages": 2,
+             "active_pages": 3, "region_count": 1},
+            {"file_key": "c", "activity_score": .1, "weighted_pages": 1,
+             "active_pages": 2, "region_count": 4},
+        ]
+
+    def test_top3_selection_is_stable(self):
+        one = stable_top_files(self.files, 3)
+        two = stable_top_files(list(reversed(self.files)), 3)
+        self.assertEqual([row["file_key"] for row in one], ["a", "b", "c"])
+        self.assertEqual(one, two)
+
+    def test_other_summary_conserves_counts(self):
+        top = stable_top_files(self.files, 1)
+        other = aggregate_other(self.files, top)
+        self.assertEqual(other["other_file_count"] + len(top), len(self.files))
+        self.assertEqual(other["other_active_pages"] + sum(x["active_pages"] for x in top),
+                         sum(x["active_pages"] for x in self.files))
+
+
+class WindowAndHistoryTests(unittest.TestCase):
+    def test_window_history_never_crosses_session(self):
+        rows = [{"session_id": "a", "value": 1}, {"session_id": "a", "value": 2},
+                {"session_id": "b", "value": 3}]
+        self.assertEqual(causal_history(rows, 2, 3), [rows[2]])
+
+    def test_history_never_reads_future(self):
+        rows = [{"session_id": "a", "value": i} for i in range(5)]
