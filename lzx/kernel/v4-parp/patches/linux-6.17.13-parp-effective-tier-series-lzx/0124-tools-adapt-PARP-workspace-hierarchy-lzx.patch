+            self.assertEqual(  #lzx
+                layout.v4_parp_root, lzx_root / "kernel" / "v4-parp")  #lzx
             self.assertEqual(layout.missing_dependencies(), ())  #lzx
 
 
diff --git a/tools/parp/effective_tier/workspace_layout-lzx.py b/tools/parp/effective_tier/workspace_layout-lzx.py
index 302ef21fc..3c05a40ba 100644
--- a/tools/parp/effective_tier/workspace_layout-lzx.py
+++ b/tools/parp/effective_tier/workspace_layout-lzx.py
@@ -42,22 +42,24 @@ def _ancestors(start: Path) -> Iterable[Path]:  #lzx
 
 
 def resolve_workspace(start: Path | None = None) -> WorkspaceLayout:  #lzx
-    """Locate lzx/v4-parp from any source or tooling path below it.  #lzx"""
+    """Locate lzx/kernel/v4-parp from any source or tooling path below it.  #lzx"""
 
     origin = Path.cwd() if start is None else Path(start)  #lzx
     for candidate in _ancestors(origin):  #lzx
-        if candidate.name != "v4-parp" or candidate.parent.name != "lzx":
+        if (candidate.name != "v4-parp" or  #lzx
+                candidate.parent.name != "kernel" or  #lzx
+                candidate.parent.parent.name != "lzx"):  #lzx
             continue
         if not (candidate / "work").is_dir():  #lzx
             continue
-        lzx_root = candidate.parent  #lzx
+        lzx_root = candidate.parent.parent  #lzx
         return WorkspaceLayout(  #lzx
             lzx_root=lzx_root,
             v4_parp_root=candidate,
-            automation_root=lzx_root / "automation",
-            runtime_monitor_root=lzx_root / "runtime_monitor",
+            automation_root=lzx_root / "tool" / "automation",  #lzx
+            runtime_monitor_root=lzx_root / "tool" / "runtime_monitor",  #lzx
         )
-    raise ValueError(f"cannot locate lzx/v4-parp above {origin}")  #lzx
+    raise ValueError(f"cannot locate lzx/kernel/v4-parp above {origin}")  #lzx
 
 
 def main() -> int:  #lzx
