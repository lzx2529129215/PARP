diff --git a/tools/parp/effective_tier/tests/test_phase_e.py b/tools/parp/effective_tier/tests/test_phase_e.py
index 353c03b62..4ef19c634 100644
--- a/tools/parp/effective_tier/tests/test_phase_e.py
+++ b/tools/parp/effective_tier/tests/test_phase_e.py
@@ -1153,17 +1153,19 @@ class EffectiveTierWorkspaceLayoutTests(unittest.TestCase):  #lzx
         module = self._module()  #lzx
         with tempfile.TemporaryDirectory() as directory:  #lzx
             lzx_root = Path(directory) / "lzx"  #lzx
-            source = (lzx_root / "v4-parp" / "work" / "linux-test" /  #lzx
+            source = (lzx_root / "kernel" / "v4-parp" / "work" / "linux-test" /  #lzx
                       "tools" / "parp" / "effective_tier")
             source.mkdir(parents=True)  #lzx
-            (lzx_root / "automation").mkdir()  #lzx
-            (lzx_root / "automation" / "app_automation.py").touch()  #lzx
