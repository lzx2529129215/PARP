From 2d7508abca27c83fccf40a2874c513a188b7b6b3 Mon Sep 17 00:00:00 2001
From: Codex PARP Reproduction <codex@localhost>
Date: Sat, 1 Aug 2026 01:36:25 +0800
Subject: [PATCH 023/124] build: make Phase 2.6 kernel release deterministic

---
 tools/parp/phase26/phase26_build.sh    | 9 ++++++---
 tools/parp/phase26/phase26_package.sh  | 4 ++--
 tools/parp/tests/test_phase26_tools.py | 1 +
 3 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/tools/parp/phase26/phase26_build.sh b/tools/parp/phase26/phase26_build.sh
index c1d1c14e8..28414ea0d 100755
--- a/tools/parp/phase26/phase26_build.sh
+++ b/tools/parp/phase26/phase26_build.sh
@@ -17,7 +17,8 @@ if [[ ! -f "$build_dir/.config" ]]; then
 		--set-str SYSTEM_TRUSTED_KEYS "" \
 		--set-str SYSTEM_REVOCATION_KEYS "" \
 		-d LOCALVERSION_AUTO --set-str LOCALVERSION -parp-v4-phase26-observe
-	phase26_run make -C "$PHASE26_WORK_TREE" O="$build_dir" olddefconfig
+	phase26_run make -C "$PHASE26_WORK_TREE" O="$build_dir" \
+		LOCALVERSION= olddefconfig
 fi
 for symbol in PARP MEMCG CGROUPS LRU_GEN DAMON DAMON_VADDR DAMON_SYSFS \
 		DEBUG_FS TRACING TRACEPOINTS FTRACE SWAP; do
@@ -28,8 +29,10 @@ if grep -q '^CONFIG_SYSTEM_REVOCATION_KEYS=' "$build_dir/.config"; then
 	grep -q '^CONFIG_SYSTEM_REVOCATION_KEYS=""$' "$build_dir/.config"
 fi
 ! grep -q 'debian/canonical-.*certs.pem' "$build_dir/.config"
-phase26_run make -C "$PHASE26_WORK_TREE" O="$build_dir" -j"$(nproc)" bzImage modules
-release=$(make -s -C "$PHASE26_WORK_TREE" O="$build_dir" kernelrelease)
+phase26_run make -C "$PHASE26_WORK_TREE" O="$build_dir" LOCALVERSION= \
+	-j"$(nproc)" bzImage modules
+release=$(make -s -C "$PHASE26_WORK_TREE" O="$build_dir" \
+	LOCALVERSION= kernelrelease)
 test "$release" = 6.17.13-parp-v4-phase26-observe
 phase26_state_set target_kernel_release "\"$release\""
 phase26_state_set source_head "\"$(git -C "$PHASE26_WORK_TREE" rev-parse HEAD)\""
diff --git a/tools/parp/phase26/phase26_package.sh b/tools/parp/phase26/phase26_package.sh
index 703fcb353..56df93efe 100755
--- a/tools/parp/phase26/phase26_package.sh
+++ b/tools/parp/phase26/phase26_package.sh
@@ -10,7 +10,7 @@ test -n "$release"
 mkdir -p "$PHASE26_OUTPUT_ROOT/packages"
 if command -v fakeroot >/dev/null 2>&1 && command -v dpkg-buildpackage >/dev/null 2>&1; then
 	phase26_run make -C "$PHASE26_WORK_TREE" O="$build_dir" -j"$(nproc)" \
-		KDEB_PKGVERSION="1phase26" bindeb-pkg
+		LOCALVERSION= KDEB_PKGVERSION="1phase26" bindeb-pkg
 	find "$(dirname "$build_dir")" "$(dirname "$PHASE26_WORK_TREE")" \
 		-maxdepth 1 -type f -name "*${release}*.*deb" \
 		-exec cp -n {} "$PHASE26_OUTPUT_ROOT/packages/" \;
@@ -19,7 +19,7 @@ if ! compgen -G "$PHASE26_OUTPUT_ROOT/packages/*.deb" >/dev/null; then
 	stage="$PHASE26_OUTPUT_ROOT/packages/staged-root"
 	mkdir -p "$stage/boot" "$stage/lib/modules"
 	phase26_run make -C "$PHASE26_WORK_TREE" O="$build_dir" \
-		INSTALL_MOD_PATH="$stage" modules_install
+		LOCALVERSION= INSTALL_MOD_PATH="$stage" modules_install
 	cp -f "$build_dir/arch/x86/boot/bzImage" "$stage/boot/vmlinuz-$release"
 	cp -f "$build_dir/System.map" "$stage/boot/System.map-$release"
 	cp -f "$build_dir/.config" "$stage/boot/config-$release"
diff --git a/tools/parp/tests/test_phase26_tools.py b/tools/parp/tests/test_phase26_tools.py
index 2f8ac38d7..3a28fbcf7 100644
--- a/tools/parp/tests/test_phase26_tools.py
+++ b/tools/parp/tests/test_phase26_tools.py
@@ -94,6 +94,7 @@ class ShellToolTests(unittest.TestCase):
         self.assertIn('--set-str SYSTEM_TRUSTED_KEYS ""', text)
         self.assertIn('--set-str SYSTEM_REVOCATION_KEYS ""', text)
         self.assertNotIn("-d SYSTEM_TRUSTED_KEYS", text)
+        self.assertIn("LOCALVERSION=", text)
 
 
 class CompatibilityRunnerTests(unittest.TestCase):
-- 
2.25.1

