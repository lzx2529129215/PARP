From 657a65b0a094fb516a47651090ffa175dbb318d1 Mon Sep 17 00:00:00 2001
From: Codex PARP Reproduction <codex@localhost>
Date: Wed, 5 Aug 2026 21:23:05 +0800
Subject: [PATCH 122/124] parp: keep decision trace strings within safe slots

---
 include/trace/events/parp.h                     |  6 +++---
 tools/parp/effective_tier/tests/test_phase_e.py | 12 ++++++++++++
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/include/trace/events/parp.h b/include/trace/events/parp.h
index 8c769f9c1..8e51b66c5 100644
--- a/include/trace/events/parp.h
+++ b/include/trace/events/parp.h
@@ -484,7 +484,7 @@ TRACE_EVENT(parp_effective_tier_decision,
 		__entry->isolate_attempted = event->isolate_attempted;
 		__entry->isolate_result = event->isolate_result;
 	),
-	TP_printk("time=%llu experiment=%llu session=%llu cookie=%llu lifetime=%u memcg=%llu nid=%u type=%u source_seq=%llu gen=%u native_tier=%u tier_idx=%u special=%d mode=%u model_type=%s model_version=%u expected_model_version=%u feature_schema_version=%u model_checksum=%s model_provenance=%s model_valid=%d features_valid=%d native_protect=%d effective_protect=%d actual_tier_protect=%d score=%d score_bin=%u rank_score_bin=%u thresholds=%d/%d/%d/%d delta_q8=%d effective_q8=%d action=%u bypass=%u pages=%llu batch=%llu epoch=%llu priority=%d score_ns=%llu decision_ns=%llu trace_seq=%llu sort=%d isolate_attempted=%d isolate_result=%d features=%lld,%lld,%lld,%lld,%lld,%lld pressure_level_kernel=%u reclaim_context=%u sc_priority=%d nr_to_reclaim=%llu nr_reclaimed_before=%llu epoch_reclaimed_pages=%llu batch_scanned_pages=%llu batch_isolated_pages=%llu batch_reclaimed_pages=%llu consecutive_no_progress_batches=%u fixed_delta_q8=%d binary_bypass_delta_q8=%d pressure_aware_delta_q8=%d fixed_effective_protect=%d pressure_aware_effective_protect=%d pressure_policy_version=%u pressure_policy_provenance=%s pressure_bypass_reason=%u",
+	TP_printk("time=%llu experiment=%llu session=%llu cookie=%llu lifetime=%u memcg=%llu nid=%u type=%u source_seq=%llu gen=%u native_tier=%u tier_idx=%u special=%d mode=%u model_type=%s model_version=%u expected_model_version=%u feature_schema_version=%u model_checksum=%s model_provenance=%s pressure_policy_provenance=%s model_valid=%d features_valid=%d native_protect=%d effective_protect=%d actual_tier_protect=%d score=%d score_bin=%u rank_score_bin=%u thresholds=%d/%d/%d/%d delta_q8=%d effective_q8=%d action=%u bypass=%u pages=%llu batch=%llu epoch=%llu priority=%d score_ns=%llu decision_ns=%llu trace_seq=%llu sort=%d isolate_attempted=%d isolate_result=%d features=%lld,%lld,%lld,%lld,%lld,%lld pressure_level_kernel=%u reclaim_context=%u sc_priority=%d nr_to_reclaim=%llu nr_reclaimed_before=%llu epoch_reclaimed_pages=%llu batch_scanned_pages=%llu batch_isolated_pages=%llu batch_reclaimed_pages=%llu consecutive_no_progress_batches=%u fixed_delta_q8=%d binary_bypass_delta_q8=%d pressure_aware_delta_q8=%d fixed_effective_protect=%d pressure_aware_effective_protect=%d pressure_policy_version=%u pressure_bypass_reason=%u", /* #lzx */
 		  __entry->timestamp_ns, __entry->experiment_id,
 		  __entry->session_id, __entry->folio_cookie,
 		  __entry->lifetime_epoch, __entry->memcg_id, __entry->nid,
@@ -494,7 +494,8 @@ TRACE_EVENT(parp_effective_tier_decision,
 		__entry->mode, __get_str(model_type), __entry->model_version, /* #lzx */
 		__entry->expected_model_version,
 		__entry->feature_schema_version, __get_str(model_checksum), /* #lzx */
-		__get_str(model_provenance), __entry->model_valid, /* #lzx */
+		__get_str(model_provenance), __get_str(pressure_policy_provenance), /* #lzx */
+		__entry->model_valid, /* #lzx */
 		  __entry->features_valid,
 		  __entry->native_protect, __entry->effective_protect,
 		  __entry->actual_tier_protect, __entry->reuse_score,
@@ -522,7 +523,6 @@ TRACE_EVENT(parp_effective_tier_decision,
 		  __entry->fixed_effective_protect,
 		  __entry->pressure_aware_effective_protect,
 		  __entry->pressure_policy_version,
-		__get_str(pressure_policy_provenance), /* #lzx */
 		  __entry->pressure_bypass_reason) /* #lzx */
 );
 
diff --git a/tools/parp/effective_tier/tests/test_phase_e.py b/tools/parp/effective_tier/tests/test_phase_e.py
index 73ba0651b..ccca60832 100644
--- a/tools/parp/effective_tier/tests/test_phase_e.py
+++ b/tools/parp/effective_tier/tests/test_phase_e.py
@@ -1124,6 +1124,18 @@ class EffectiveTierTraceSourceTests(unittest.TestCase):  #lzx
                 self.assertNotRegex(  #lzx
                     decision, rf"__array\(char,\s*{field},")  #lzx
 
+    def test_decision_printk_has_no_late_string_argument(self):  #lzx
+        header = (HERE.parents[2] / "include" / "trace" / "events" /
+                  "parp.h").read_text(encoding="utf-8")  #lzx
+        decision = header.split("TRACE_EVENT(parp_effective_tier_decision,", 1)[1]  #lzx
+        decision = decision.split("TRACE_EVENT(parp_effective_tier_access,", 1)[0]  #lzx
+        self.assertIn(  #lzx
+            "model_provenance=%s pressure_policy_provenance=%s model_valid",
+            decision)
+        self.assertNotIn(  #lzx
+            "pressure_policy_version=%u pressure_policy_provenance=%s",
+            decision)
+
 
 if __name__ == "__main__":
     unittest.main()
-- 
