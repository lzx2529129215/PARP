From ecc9c30e528e05dd8893ae29802f66b25ab631bc Mon Sep 17 00:00:00 2001
From: Codex PARP Reproduction <codex@localhost>
Date: Wed, 5 Aug 2026 21:18:07 +0800
Subject: [PATCH 121/124] parp: isolate P1 worker in test leaf cgroup

---
 .../live-p1-pressure-calibrator-lzx.py        | 28 ++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/tools/parp/effective_tier/live-p1-pressure-calibrator-lzx.py b/tools/parp/effective_tier/live-p1-pressure-calibrator-lzx.py
index c1dacadea..23525a415 100644
--- a/tools/parp/effective_tier/live-p1-pressure-calibrator-lzx.py
+++ b/tools/parp/effective_tier/live-p1-pressure-calibrator-lzx.py
@@ -17,6 +17,7 @@ from typing import Dict, List
 
 MIB = 1024 * 1024  #lzx
 PAGE = 4096  #lzx
+WORKER_CGROUP_NAME = "parp-p1-pressure-lzx"  #lzx
 
 
 def read_text(path: Path) -> str:
@@ -78,6 +79,16 @@ def validate_cgroup(cgroup: Path) -> None:
             raise ValueError(f"missing required cgroup file: {name}")
 
 
+def validate_worker_cgroup(cgroup: Path, worker_cgroup: Path) -> None:
+    """Allow a new leaf only below the already-authorized test slice.  #lzx"""
+
+    if worker_cgroup.parent != cgroup or \
+            worker_cgroup.name != WORKER_CGROUP_NAME:
+        raise ValueError("refusing a worker cgroup outside the P1 test leaf")
+    if worker_cgroup.exists():
+        raise ValueError("P1 worker cgroup already exists; refuse stale state")
+
+
 def child_exit_status(pid: int) -> int | None:
     waited, status = os.waitpid(pid, os.WNOHANG)
     if not waited:
@@ -115,6 +126,8 @@ def abort_on_signal(signum: int, _frame: object) -> None:
 def run(args: argparse.Namespace) -> Dict[str, object]:
     cgroup = Path(args.cgroup).resolve()
     validate_cgroup(cgroup)
+    worker_cgroup = cgroup / WORKER_CGROUP_NAME  #lzx
+    validate_worker_cgroup(cgroup, worker_cgroup)  #lzx
     if os.geteuid() != 0:
         raise PermissionError("run this P1 calibrator through sudo")
     if args.duration_s <= 0 or args.duration_s > 30:
@@ -139,6 +152,8 @@ def run(args: argparse.Namespace) -> Dict[str, object]:
         "memory_high_before": before_high,
         "memory_max_before": before_max,
         "memory_max_written": False,
+        "worker_cgroup": str(worker_cgroup),
+        "worker_cgroup_removed": False,
         "memory_events_before": before_events,
         "memory_pressure_before": before_pressure,
         "samples": [],
@@ -152,8 +167,11 @@ def run(args: argparse.Namespace) -> Dict[str, object]:
     account = pwd.getpwnam(args.user)
     read_fd, write_fd = os.pipe()
     child_pid = -1
+    worker_cgroup_created = False  #lzx
     full_samples = 0
     try:
+        worker_cgroup.mkdir()  #lzx
+        worker_cgroup_created = True  #lzx
         write_text(cgroup / "memory.high", str(high_value))
         child_pid = os.fork()
         if child_pid == 0:
@@ -161,7 +179,7 @@ def run(args: argparse.Namespace) -> Dict[str, object]:
             worker(read_fd, args.target_mib * MIB, account.pw_uid, account.pw_gid)
             os._exit(0)
         os.close(read_fd)
-        write_text(cgroup / "cgroup.procs", str(child_pid))
+        write_text(worker_cgroup / "cgroup.procs", str(child_pid))  #lzx
         os.write(write_fd, b"1")
         os.close(write_fd)
         deadline = time.monotonic() + args.duration_s
@@ -202,6 +220,14 @@ def run(args: argparse.Namespace) -> Dict[str, object]:
         report["memory_max_after"] = read_text(cgroup / "memory.max")
         report["memory_events_after"] = read_events(cgroup / "memory.events")
         report["memory_pressure_after"] = read_pressure(cgroup / "memory.pressure")
+        if worker_cgroup_created:
+            try:
+                worker_cgroup.rmdir()  #lzx
+                report["worker_cgroup_removed"] = True  #lzx
+            except OSError as exc:
+                report["worker_cgroup_cleanup_error"] = str(exc)  #lzx
+                report["status"] = "P1_ABORTED"  #lzx
+                report["abort_reason"] = "WORKER_CGROUP_CLEANUP_FAILED"  #lzx
     return report
 
 
