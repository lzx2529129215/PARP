diff --git a/mm/parp/Kconfig b/mm/parp/Kconfig
index 14ac2bb03..2cf06e5d0 100644
--- a/mm/parp/Kconfig
+++ b/mm/parp/Kconfig
@@ -27,3 +27,15 @@ config PARP_DAMON_ALIGNMENT
 	  reclaim, prefetch, pageout, generations, or scan budgets. Records are
