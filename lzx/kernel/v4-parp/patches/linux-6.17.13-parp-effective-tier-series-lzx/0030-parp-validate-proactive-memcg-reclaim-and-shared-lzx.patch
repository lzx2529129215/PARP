+++ b/tools/parp/tests/test_scan_budget.py
@@ -38,6 +38,14 @@ class ScanBudgetTest(unittest.TestCase):
                                          scope=scope)
             self.assertEqual(result["applied"], 1000)
 
+    def test_proactive_target_memcg_uses_the_target_budget(self):
