[Unit]
Description=PARP keyboard and pointer input event source for UID %i
After=systemd-user-sessions.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/parp-input-events --target-uid %i
Restart=always
RestartSec=2
UMask=0077
# 读取 seat0 输入设备；不持有注入输入、BPF、进程控制或写 cgroup 的能力。
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=char-input r
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# ctypes 的 C 回调需要 executable trampoline，不能启用 MemoryDenyWriteExecute。
RestrictAddressFamilies=AF_NETLINK AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
