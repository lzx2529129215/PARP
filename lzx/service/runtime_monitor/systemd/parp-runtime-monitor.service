[Unit]
Description=PARP resident application-event and LSTM prediction service
Documentation=file://%h/Desktop/PARP/lzx/service/runtime_monitor/README_SERVICE.md
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/PARP/lzx/service
Environment=PYTHONUNBUFFERED=1
Environment=PARP_SERVICE_FOREGROUND_BACKEND=desktop
Environment=PARP_SERVICE_MYFS_MODE=apply
EnvironmentFile=-%h/.config/parp/runtime-monitor.env
ExecStart=%h/Desktop/PARP/lzx/service/runtime_monitor/scripts/run_service_daemon.sh
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=default.target
