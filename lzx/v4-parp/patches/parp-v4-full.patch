+++ b/tools/parp/parpctl.py
@@ -0,0 +1,25 @@
+#!/usr/bin/env python3
+"""Minimal observe-only PARP control client."""
+
+import argparse
+from pathlib import Path
+
+MODE = {"disabled": "0", "observe": "1", "apply": "2"}
+MODE_PATH = Path("/sys/kernel/debug/parp/mode")
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    sub = parser.add_subparsers(dest="command", required=True)
+    sub.add_parser("mode-get")
+    mode_set = sub.add_parser("mode-set")
+    mode_set.add_argument("mode", choices=MODE)
+    args = parser.parse_args()
+    if args.command == "mode-get":
+        print(MODE_PATH.read_text(encoding="ascii").strip())
+    else:
+        MODE_PATH.write_text(MODE[args.mode] + "\n", encoding="ascii")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/parp/reference_model.py b/tools/parp/reference_model.py
new file mode 100755
index 000000000..04cb4dc71
--- /dev/null
+++ b/tools/parp/reference_model.py
@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""Bit-exact reference operations for the PARP Q15 kernel implementation."""
+
+Q15_ONE = 32767
+
+
+def q15_mul(a: int, b: int) -> int:
+    a = min(max(a, 0), Q15_ONE)
+    b = min(max(b, 0), Q15_ONE)
+    return min((a * b + (1 << 14)) >> 15, Q15_ONE)
+
+
+def file_future_score(app_prior: int, next_state: int, support: int,
+                      stability: int, freshness: int) -> int:
+    score = q15_mul(app_prior, next_state)
+    score = q15_mul(score, support)
+    score = q15_mul(score, stability)
+    return q15_mul(score, freshness)
+
+
+def anon_cold_score(accesses_10s: int, accesses_30s: int,
+                    accesses_60s: int, active_ratio: int,
+                    app_prior: int, evidence_valid: bool = True) -> int:
+    if not evidence_valid:
+        return 0
+    recent = min(accesses_10s * 4 + accesses_30s * 2 + accesses_60s,
+                 Q15_ONE)
+    cold = (Q15_ONE - recent + Q15_ONE - active_ratio) // 2
+    return q15_mul(cold, Q15_ONE - min(app_prior, Q15_ONE))
+
+
+def assign_state(features, centers, unknown_threshold):
+    distances = [
+        sum((x - y) ** 2 for x, y in zip(features, center))
+        for center in centers
+    ]
+    state = min(range(len(distances)), key=distances.__getitem__)
+    return -1 if distances[state] > unknown_threshold else state
diff --git a/tools/parp/schema.py b/tools/parp/schema.py
new file mode 100755
index 000000000..d61357677
--- /dev/null
+++ b/tools/parp/schema.py
@@ -0,0 +1,21 @@
+#!/usr/bin/env python3
+"""Versioned userspace schema; the kernel never parses JSON."""
+
+import struct
+
+SCHEMA_VERSION = 1
+APP_PRIOR = struct.Struct("<IIHHIQQQ")
+APP_BIND = struct.Struct("<I Q I I Q Q Q Q ?")
+
+
+def pack_app_prior(app_id, use_score, rank, horizon_ms, ttl_ns,
+                   model_version, timestamp_ns):
+    return APP_PRIOR.pack(SCHEMA_VERSION, app_id, use_score, rank, horizon_ms,
+                          ttl_ns, model_version, timestamp_ns)
+
+
+def pack_app_bind(domain_id, app_id, generation, updated_ns, expires_ns,
+                  epoch_id, model_version, active=True):
+    return APP_BIND.pack(SCHEMA_VERSION, domain_id, app_id, generation,
+                         updated_ns, expires_ns, epoch_id, model_version,
+                         active)
