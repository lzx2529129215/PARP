+#include "../internal.h"
+
+unsigned int parp_app_prior_bin(u16 score)
+{
+	return min_t(unsigned int, score / 8192, 3);
+}
diff --git a/mm/parp/model/file_predictor.c b/mm/parp/model/file_predictor.c
new file mode 100644
index 000000000..223004405
--- /dev/null
+++ b/mm/parp/model/file_predictor.c
@@ -0,0 +1,12 @@
+// SPDX-License-Identifier: GPL-2.0
+#include "../internal.h"
+
+u16 parp_file_future_score(const struct parp_page_sample *sample)
+{
+	u16 score;
+
+	score = parp_q15_mul(sample->app_prior_q15, sample->next_state_q15);
+	score = parp_q15_mul(score, sample->support_q15);
+	score = parp_q15_mul(score, sample->stability_q15);
+	return parp_q15_mul(score, sample->freshness_q15);
+}
