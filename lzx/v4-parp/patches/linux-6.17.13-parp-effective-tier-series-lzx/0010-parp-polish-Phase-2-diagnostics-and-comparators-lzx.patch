diff --git a/mm/parp/Kconfig b/mm/parp/Kconfig
index ef3bee3b6..14ac2bb03 100644
--- a/mm/parp/Kconfig
+++ b/mm/parp/Kconfig
@@ -24,4 +24,6 @@ config PARP_DAMON_ALIGNMENT
 	help
 	  Copy DAMON aggregation records into an asynchronous PARP alignment
 	  worker. This remains evidence-only by default and never changes
-	  reclaim, prefetch, pageout, generations, or scan budgets.
+	  reclaim, prefetch, pageout, generations, or scan budgets. Records are
+	  classified against referenced process VMAs and published through bounded,
+	  immutable evidence snapshots for later PARP observation.
diff --git a/mm/parp/core/evidence.c b/mm/parp/core/evidence.c
index 8ad838dfb..69ddd0b55 100644
--- a/mm/parp/core/evidence.c
+++ b/mm/parp/core/evidence.c
@@ -223,20 +223,30 @@ parp_anon_victim(const struct parp_anon_observation *observation,
 	return victim && incoming > weakest ? victim : NULL;
 }
 
+static int parp_cmp_u64(u64 left, u64 right)
+{
+	if (left == right)
+		return 0;
+	return left < right ? -1 : 1;
+}
+
 static int parp_file_compare(const void *left, const void *right)
 {
 	const struct parp_file_evidence *a = left, *b = right;
-
-#define PARP_CMP_FIELD(field) do { if (a->field != b->field) \
-	return a->field < b->field ? -1 : 1; } while (0)
-	PARP_CMP_FIELD(domain_id);
-	PARP_CMP_FIELD(key.dev_major);
-	PARP_CMP_FIELD(key.dev_minor);
-	PARP_CMP_FIELD(key.inode);
-	PARP_CMP_FIELD(key.file_version);
-	PARP_CMP_FIELD(key.start_index);
-#undef PARP_CMP_FIELD
-	return 0;
+	int ret;
+
+	ret = parp_cmp_u64(a->domain_id, b->domain_id);
+	if (!ret)
+		ret = parp_cmp_u64(a->key.dev_major, b->key.dev_major);
+	if (!ret)
+		ret = parp_cmp_u64(a->key.dev_minor, b->key.dev_minor);
+	if (!ret)
+		ret = parp_cmp_u64(a->key.inode, b->key.inode);
+	if (!ret)
+		ret = parp_cmp_u64(a->key.file_version, b->key.file_version);
+	if (!ret)
+		ret = parp_cmp_u64(a->key.start_index, b->key.start_index);
+	return ret;
 }
 
 static int parp_anon_compare(const void *left, const void *right)
@@ -615,18 +625,23 @@ static int parp_compare_file_point(const struct parp_file_evidence *entry,
 				   const struct parp_file_region_key *key,
 				   u64 index)
 {
-#define PARP_POINT_CMP(left, right) do { if ((left) != (right)) \
-	return (left) < (right) ? -1 : 1; } while (0)
-	PARP_POINT_CMP(entry->domain_id, domain_id);
-	PARP_POINT_CMP(entry->key.dev_major, key->dev_major);
-	PARP_POINT_CMP(entry->key.dev_minor, key->dev_minor);
-	PARP_POINT_CMP(entry->key.inode, key->inode);
-	PARP_POINT_CMP(entry->key.file_version, key->file_version);
+	int ret;
+
+	ret = parp_cmp_u64(entry->domain_id, domain_id);
+	if (!ret)
+		ret = parp_cmp_u64(entry->key.dev_major, key->dev_major);
+	if (!ret)
+		ret = parp_cmp_u64(entry->key.dev_minor, key->dev_minor);
+	if (!ret)
+		ret = parp_cmp_u64(entry->key.inode, key->inode);
+	if (!ret)
+		ret = parp_cmp_u64(entry->key.file_version, key->file_version);
+	if (ret)
+		return ret;
 	if (index < entry->key.start_index)
 		return 1;
 	if (index >= entry->key.start_index + entry->key.nr_pages)
 		return -1;
-#undef PARP_POINT_CMP
 	return 0;
 }
 
