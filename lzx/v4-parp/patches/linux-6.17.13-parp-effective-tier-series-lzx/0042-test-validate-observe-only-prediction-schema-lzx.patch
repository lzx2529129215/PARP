From 9d211192af94a9304a34f21c80da675801d93ed5 Mon Sep 17 00:00:00 2001
From: Codex PARP Reproduction <codex@localhost>
Date: Sun, 2 Aug 2026 16:01:49 +0800
Subject: [PATCH 042/123] test: validate observe-only prediction schema

---
 .../prediction_schema.json                    | 84 +++++++++++++++++++
 .../tests/test_model_pipeline.py              | 17 +++-
 2 files changed, 100 insertions(+), 1 deletion(-)
 create mode 100644 tools/parp/intra_app_prediction/prediction_schema.json

diff --git a/tools/parp/intra_app_prediction/prediction_schema.json b/tools/parp/intra_app_prediction/prediction_schema.json
new file mode 100644
index 000000000..cbcb3bd45
--- /dev/null
+++ b/tools/parp/intra_app_prediction/prediction_schema.json
@@ -0,0 +1,84 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://parp.local/schemas/phase27-prediction-v1.json",
+  "title": "PARP Phase2.7 observe-only page segment prediction",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema_version",
+    "run_id",
+    "app_id",
+    "domain_id",
+    "model_type",
+    "model_version",
+    "prediction_generation",
+    "generated_ns",
+    "ttl_ns",
+    "file_segments",
+    "anon_prediction",
+    "kernel_write"
+  ],
+  "properties": {
+    "schema_version": {"const": 1},
+    "run_id": {"type": "string", "minLength": 1},
+    "app_id": {"type": ["string", "integer"]},
+    "domain_id": {"type": "integer", "minimum": 0},
+    "model_type": {"const": "page_state_markov"},
+    "model_version": {"type": "integer", "minimum": 1},
+    "prediction_generation": {"type": "integer", "minimum": 1},
+    "generated_ns": {"type": "integer", "minimum": 0},
+    "ttl_ns": {"type": "integer", "minimum": 1},
+    "kernel_write": {"const": false},
+    "file_segments": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": [
+          "dev_major",
+          "dev_minor",
+          "inode",
+          "file_version",
+          "partition_generation",
+          "file_page_count",
+          "requested_bins",
+          "effective_bins",
+          "segment_id",
+          "probability_10s_q15",
+          "probability_30s_q15",
+          "probability_60s_q15",
+          "confidence_q15"
+        ],
+        "properties": {
+          "dev_major": {"type": "integer", "minimum": 0},
+          "dev_minor": {"type": "integer", "minimum": 0},
+          "inode": {"type": "integer", "minimum": 0},
+          "file_version": {"type": "integer", "minimum": 0},
+          "partition_generation": {"type": "integer", "minimum": 1},
+          "file_page_count": {"type": "integer", "minimum": 1},
+          "requested_bins": {"enum": [10, 100, 1000]},
+          "effective_bins": {"type": "integer", "minimum": 1},
+          "segment_id": {"type": "integer", "minimum": 0},
+          "probability_10s_q15": {"type": "integer", "minimum": 0, "maximum": 32767},
+          "probability_30s_q15": {"type": "integer", "minimum": 0, "maximum": 32767},
+          "probability_60s_q15": {"type": "integer", "minimum": 0, "maximum": 32767},
+          "confidence_q15": {"type": "integer", "minimum": 0, "maximum": 32767}
+        }
+      }
+    },
+    "anon_prediction": {
+      "type": "object",
+      "required": [
+        "hot_bytes_10s",
+        "hot_bytes_30s",
+        "hot_bytes_60s",
+        "cooling_probability_q15"
+      ],
+      "properties": {
+        "hot_bytes_10s": {"type": "integer", "minimum": 0},
+        "hot_bytes_30s": {"type": "integer", "minimum": 0},
+        "hot_bytes_60s": {"type": "integer", "minimum": 0},
+        "cooling_probability_q15": {"type": "integer", "minimum": 0, "maximum": 32767}
+      }
+    }
+  }
+}
diff --git a/tools/parp/intra_app_prediction/tests/test_model_pipeline.py b/tools/parp/intra_app_prediction/tests/test_model_pipeline.py
index 7ec1c115b..e9b6db3b2 100644
--- a/tools/parp/intra_app_prediction/tests/test_model_pipeline.py
+++ b/tools/parp/intra_app_prediction/tests/test_model_pipeline.py
@@ -1,4 +1,4 @@
-import tempfile
+import json
 import unittest
 from pathlib import Path
 
@@ -66,5 +66,20 @@ class EvaluationTests(unittest.TestCase):
         self.assertEqual(metrics["false_hot"], 1.0)
 
 
+class PredictionSchemaTests(unittest.TestCase):
+    def test_prediction_schema_requires_observe_only_contract(self):
+        path = Path(__file__).parents[1] / "prediction_schema.json"
+        schema = json.loads(path.read_text())
+        self.assertIn("kernel_write", schema["required"])
+        self.assertEqual(schema["properties"]["kernel_write"]["const"], False)
+        segment = schema["properties"]["file_segments"]["items"]
+        for field in ("dev_major", "dev_minor", "inode", "file_version",
+                      "partition_generation", "probability_10s_q15",
+                      "probability_30s_q15", "probability_60s_q15"):
+            self.assertIn(field, segment["required"])
+        self.assertEqual(segment["properties"]["confidence_q15"]["maximum"],
+                         32767)
+
+
 if __name__ == "__main__":
     unittest.main()
-- 
