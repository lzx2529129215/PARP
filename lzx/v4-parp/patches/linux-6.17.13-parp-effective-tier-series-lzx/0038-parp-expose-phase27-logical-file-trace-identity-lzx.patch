@@ -101,25 +131,49 @@ TRACE_EVENT(parp_region_evidence,
 	),
 	TP_fast_assign(
 		__entry->sample_id = event->sample_id;
+		__entry->sample_timestamp_ns = event->sample_timestamp_ns;
 		__entry->pid = event->pid;
 		__entry->tgid = event->tgid;
