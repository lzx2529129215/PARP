-			split ? PARP_ALIGN_SPLIT_EXACT : PARP_ALIGN_EXACT,
-			observation.key.relative_start_pages,
-			observation.key.nr_pages, sample->nr_accesses, sample->age,
-			observation.identity_confidence_q15, observation.flags);
+		trace_parp_region_evidence(&(struct parp_region_trace) {
