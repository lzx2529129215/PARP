+		.proposed_nr_to_scan = decision->proposed_nr_to_scan,
+		.applied_nr_to_scan = decision->applied_nr_to_scan,
+		.multiplier_q15 = decision->multiplier_q15,
+		.pressure_level = input.pressure,
