From 77d8817f08ac9ca96c372fa1192faa97948804b4 Mon Sep 17 00:00:00 2001
From: Codex PARP Reproduction <codex@localhost>
Date: Wed, 5 Aug 2026 16:19:27 +0800
Subject: [PATCH 118/123] parp: make effective-tier trace strings safe

---
 include/trace/events/parp.h                   | 33 ++++++++-----------
 .../parp/effective_tier/tests/test_phase_e.py | 18 ++++++++++
 2 files changed, 32 insertions(+), 19 deletions(-)

diff --git a/include/trace/events/parp.h b/include/trace/events/parp.h
index 67661edce..8c769f9c1 100644
--- a/include/trace/events/parp.h
+++ b/include/trace/events/parp.h
@@ -386,11 +386,11 @@ TRACE_EVENT(parp_effective_tier_decision,
 		__field(u32, expected_model_version)
 		__field(u32, feature_schema_version)
 		__field(u32, pressure_policy_version)
-		__array(char, model_type, PARP_TIER_TRACE_MODEL_TYPE_LEN)
-		__array(char, model_checksum, PARP_TIER_TRACE_CHECKSUM_LEN)
-		__array(char, model_provenance, PARP_TIER_TRACE_PROVENANCE_LEN)
-		__array(char, pressure_policy_provenance,
-			PARP_TIER_TRACE_PRESSURE_PROVENANCE_LEN)
+		__string(model_type, event->model_type) /* #lzx */
+		__string(model_checksum, event->model_checksum) /* #lzx */
+		__string(model_provenance, event->model_provenance) /* #lzx */
+		__string(pressure_policy_provenance,
+			event->pressure_policy_provenance) /* #lzx */
 		__field(u16, consecutive_no_progress_batches) /* #lzx */
 		__field(u8, generation_index)
 		__field(u8, native_tier)
@@ -454,15 +454,10 @@ TRACE_EVENT(parp_effective_tier_decision,
 		__entry->expected_model_version = event->expected_model_version;
 		__entry->feature_schema_version = event->feature_schema_version;
 		__entry->pressure_policy_version = event->pressure_policy_version;
-		memcpy(__entry->model_type, event->model_type,
-		       sizeof(__entry->model_type));
-		memcpy(__entry->model_checksum, event->model_checksum,
-		       sizeof(__entry->model_checksum));
-		memcpy(__entry->model_provenance, event->model_provenance,
-		       sizeof(__entry->model_provenance));
-		memcpy(__entry->pressure_policy_provenance,
-		       event->pressure_policy_provenance,
-		       sizeof(__entry->pressure_policy_provenance));
+		__assign_str(model_type); /* #lzx */
+		__assign_str(model_checksum); /* #lzx */
+		__assign_str(model_provenance); /* #lzx */
+		__assign_str(pressure_policy_provenance); /* #lzx */
 		__entry->consecutive_no_progress_batches =
 			event->consecutive_no_progress_batches; /* #lzx */
 		__entry->generation_index = event->generation_index;
@@ -496,10 +491,10 @@ TRACE_EVENT(parp_effective_tier_decision,
 		  __entry->page_type, __entry->source_seq,
 		  __entry->generation_index, __entry->native_tier,
 		  __entry->native_tier_idx, __entry->special_native_protect,
-		  __entry->mode, __entry->model_type, __entry->model_version,
-		  __entry->expected_model_version,
-		  __entry->feature_schema_version, __entry->model_checksum,
-		  __entry->model_provenance, __entry->model_valid,
+		__entry->mode, __get_str(model_type), __entry->model_version, /* #lzx */
+		__entry->expected_model_version,
+		__entry->feature_schema_version, __get_str(model_checksum), /* #lzx */
+		__get_str(model_provenance), __entry->model_valid, /* #lzx */
 		  __entry->features_valid,
 		  __entry->native_protect, __entry->effective_protect,
 		  __entry->actual_tier_protect, __entry->reuse_score,
@@ -527,7 +522,7 @@ TRACE_EVENT(parp_effective_tier_decision,
 		  __entry->fixed_effective_protect,
 		  __entry->pressure_aware_effective_protect,
 		  __entry->pressure_policy_version,
-		  __entry->pressure_policy_provenance,
+		__get_str(pressure_policy_provenance), /* #lzx */
 		  __entry->pressure_bypass_reason) /* #lzx */
 );
 
diff --git a/tools/parp/effective_tier/tests/test_phase_e.py b/tools/parp/effective_tier/tests/test_phase_e.py
index 6424cfb6c..73ba0651b 100644
--- a/tools/parp/effective_tier/tests/test_phase_e.py
+++ b/tools/parp/effective_tier/tests/test_phase_e.py
@@ -3,6 +3,7 @@
 from __future__ import annotations
 
 import json
+import re  #lzx
 import tempfile
 import unittest
 from copy import deepcopy
@@ -1107,5 +1108,22 @@ class PhaseEPlanTests(unittest.TestCase):
                 self.assertIsInstance(value, dict)
 
 
+class EffectiveTierTraceSourceTests(unittest.TestCase):  #lzx
+    def test_decision_strings_are_tracefs_owned(self):  #lzx
+        header = (HERE.parents[2] / "include" / "trace" / "events" /
+                  "parp.h").read_text(encoding="utf-8")  #lzx
+        decision = header.split("TRACE_EVENT(parp_effective_tier_decision,", 1)[1]  #lzx
+        decision = decision.split("TRACE_EVENT(parp_effective_tier_access,", 1)[0]  #lzx
+        for field in ("model_type", "model_checksum", "model_provenance",
+                      "pressure_policy_provenance"):  #lzx
+            with self.subTest(field=field):  #lzx
+                self.assertRegex(  #lzx
+                    decision, rf"__string\({field},\s*event->{field}\)")  #lzx
+                self.assertIn(f"__assign_str({field});", decision)  #lzx
+                self.assertIn(f"__get_str({field})", decision)  #lzx
+                self.assertNotRegex(  #lzx
+                    decision, rf"__array\(char,\s*{field},")  #lzx
+
+
 if __name__ == "__main__":
     unittest.main()
-- 
