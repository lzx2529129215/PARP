Subject: [PATCH 051/123] fix: render authorization gate table

---
 tools/parp/phase28/gate_report.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tools/parp/phase28/gate_report.py b/tools/parp/phase28/gate_report.py
index c5fd57e63..280fa9d8b 100644
--- a/tools/parp/phase28/gate_report.py
+++ b/tools/parp/phase28/gate_report.py
@@ -174,7 +174,8 @@ def run(args):
     for item in report["items"]:
         value = json.dumps(item["value"], ensure_ascii=False, sort_keys=True) if isinstance(item["value"], (dict, list)) else str(item["value"])
         value = value.replace("\n", "<br>").replace("|", "\\|")
-        lines.append("| {index} | {name} | {status} | {value} |".format(value=value, **item))
+        lines.append("| %s | %s | %s | %s |" % (
+            item["index"], item["name"], item["status"], value))
     lines.extend([
         "", "## 继续执行", "",
         "关闭正在运行的 WPS 和文件管理器窗口后，在终端执行：", "",
