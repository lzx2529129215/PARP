+static __always_inline void parp_lru_lock_irq(spinlock_t *lock,
+		struct parp_tier_lock_measurement *measurement)
+{
+#ifdef CONFIG_PREEMPT_RT
+	/* A spinlock_t may sleep on RT, so preserve the native primitive. */
+	parp_effective_tier_lock_start(measurement);
+	spin_lock_irq(lock);
+#else
+	local_irq_disable();
+	parp_effective_tier_lock_start(measurement);
+	measurement->irq_disabled_measured = true;
+	spin_lock(lock);
+#endif
+	parp_effective_tier_lock_acquired(measurement);
+}
+
+static __always_inline void parp_lru_unlock_irq(spinlock_t *lock,
+		struct parp_tier_lock_measurement *measurement)
+{
+	parp_effective_tier_lock_releasing(measurement);
+#ifdef CONFIG_PREEMPT_RT
+	spin_unlock_irq(lock);
+#else
+	spin_unlock(lock);
+	parp_effective_tier_lock_unlocked(measurement);
+	local_irq_enable();
+	return;
+#endif
+	parp_effective_tier_lock_unlocked(measurement);
+}
