{
  "description": "Perf_WPS_0060：在 WPS 表格中完成数值筛选、文本筛选、排序、复制插入列、公式填充、新建工作表、全表字体修改、滚动和首尾跳转，并保存可验证结果。",
  "variables": {
    "WPS_EXCEL_SOURCE": "${PROJECT_ROOT}/samples/wps/spreadsheet_0060.xlsx",
    "WPS_EXCEL_FILE": "${PROJECT_ROOT}/outputs/wps/spreadsheet_0060_result.xlsx",
    "EXCEL_FILTER_NUMBER": "0",
    "EXCEL_FILTER_KEYWORD": "key",
    "EXCEL_FONT_NAME": "Noto Serif CJK SC",
    "EXCEL_LOAD_SECONDS": "15"
  },
  "actions": [
    {"type": "shell", "command": "pkill -x wpsoffice 2>/dev/null || true; pkill -x et 2>/dev/null || true; sleep 3; mkdir -p \"${PROJECT_ROOT}/outputs/wps\" \"${PROJECT_ROOT}/outputs/runtime_monitor\" && cp \"${WPS_EXCEL_SOURCE}\" \"${WPS_EXCEL_FILE}\" && fc-match 'Noto Serif CJK SC' | grep -q 'Noto Serif CJK SC' && rm -f \"${PROJECT_ROOT}/outputs/wps/spreadsheet_0060_numeric_filtered.xlsx\" \"${PROJECT_ROOT}/outputs/wps/spreadsheet_0060_text_filtered.xlsx\" \"${PROJECT_ROOT}/outputs/runtime_monitor/0060_\"*.xwd", "label": "WPS_EXCEL_PREPARE_FIXTURE_AND_SONGTI_FONT"},
    {"type": "assert_file", "path": "${WPS_EXCEL_SOURCE}", "label": "WPS_REQUIRE_EXCEL_SOURCE"},
    {"type": "assert_file", "path": "${WPS_EXCEL_FILE}", "label": "WPS_REQUIRE_EXCEL_WORKING_COPY"},

    {"type": "launch", "name": "et", "command": "et", "label": "WPS_EXCEL_S1_LAUNCH"},
    {"type": "wait_window", "name": "wps", "class": "wpsoffice", "timeout": 45, "label": "WPS_EXCEL_WAIT_HOME"},
    {"type": "window_state", "name": "wps", "class": "wpsoffice", "state": "maximize", "label": "WPS_EXCEL_MAXIMIZE_HOME"},
    {"type": "wait", "seconds": 4},
    {"type": "open_file", "path": "${WPS_EXCEL_FILE}", "name": "wps", "class": "wpsoffice", "shortcut": "ctrl+o", "wait_before": 2, "wait_after": 3, "label": "WPS_EXCEL_S2_OPEN_FILE"},
    {"type": "wait", "seconds": "${EXCEL_LOAD_SECONDS}"},
    {"type": "wait_window", "name": "wps", "title": "spreadsheet_0060_result", "timeout": 45, "label": "WPS_EXCEL_S2_ASSERT_WORKBOOK_WINDOW"},
    {"type": "window_state", "name": "wps", "class": "et|wpsoffice", "state": "maximize", "label": "WPS_EXCEL_MAXIMIZE_DOCUMENT"},
    {"type": "wait", "seconds": 3},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0060_initial.xwd\"", "label": "WPS_EXCEL_CAPTURE_INITIAL"},
    {"type": "click", "x": 150, "y": 257, "label": "WPS_EXCEL_ENABLE_FILTER_SELECT_HEADER"},
    {"type": "key", "key": "ctrl+shift+l", "name": "wps", "label": "WPS_EXCEL_ENABLE_FILTER_DROPDOWNS"},
    {"type": "wait", "seconds": 2},

    {"type": "click", "x": 213, "y": 257, "label": "WPS_EXCEL_S3_SELECT_NUMERIC_COLUMN"},
    {"type": "key", "key": "alt+Down", "name": "wps", "label": "WPS_EXCEL_S3_OPEN_NUMERIC_FILTER"},
    {"type": "wait", "seconds": 1},
    {"type": "click", "x": 518, "y": 331, "label": "WPS_EXCEL_S3_NUMBER_FILTER_MENU"},
    {"type": "click", "x": 520, "y": 487, "label": "WPS_EXCEL_S3_GREATER_EQUAL_CONDITION"},
    {"type": "wait", "seconds": 1},
    {"type": "click", "x": 750, "y": 376, "label": "WPS_EXCEL_S3_NUMERIC_VALUE_BOX"},
    {"type": "paste_text", "text": "${EXCEL_FILTER_NUMBER}", "name": "wps", "label": "WPS_EXCEL_S3_NUMERIC_VALUE"},
    {"type": "click", "x": 840, "y": 509, "label": "WPS_EXCEL_S3_APPLY_NUMERIC_FILTER"},
    {"type": "wait", "seconds": 4},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0060_numeric_filtered.xwd\"", "label": "WPS_EXCEL_CAPTURE_NUMERIC_FILTER"},
    {"type": "key", "key": "ctrl+s", "name": "wps", "label": "WPS_EXCEL_SAVE_NUMERIC_FILTER"},
    {"type": "wait", "seconds": 5},
    {"type": "shell", "command": "cp \"${WPS_EXCEL_FILE}\" \"${PROJECT_ROOT}/outputs/wps/spreadsheet_0060_numeric_filtered.xlsx\"", "label": "WPS_EXCEL_CHECKPOINT_NUMERIC_FILTER"},
    {"type": "key", "key": "alt+Down", "name": "wps", "label": "WPS_EXCEL_S3_REOPEN_NUMERIC_FILTER"},
    {"type": "wait", "seconds": 1},
    {"type": "click", "x": 595, "y": 331, "label": "WPS_EXCEL_S3_CANCEL_NUMERIC_FILTER"},
    {"type": "wait", "seconds": 2},

    {"type": "click", "x": 350, "y": 257, "label": "WPS_EXCEL_S4_SELECT_TEXT_COLUMN"},
    {"type": "key", "key": "alt+Down", "name": "wps", "label": "WPS_EXCEL_S4_OPEN_TEXT_FILTER"},
    {"type": "wait", "seconds": 1},
    {"type": "click", "x": 718, "y": 331, "label": "WPS_EXCEL_S4_TEXT_FILTER_MENU"},
    {"type": "click", "x": 713, "y": 526, "label": "WPS_EXCEL_S4_CONTAINS_CONDITION"},
    {"type": "wait", "seconds": 1},
    {"type": "click", "x": 750, "y": 376, "label": "WPS_EXCEL_S4_TEXT_VALUE_BOX"},
    {"type": "paste_text", "text": "${EXCEL_FILTER_KEYWORD}", "name": "wps", "label": "WPS_EXCEL_S4_TEXT_VALUE"},
    {"type": "click", "x": 840, "y": 509, "label": "WPS_EXCEL_S4_APPLY_TEXT_FILTER"},
    {"type": "wait", "seconds": 4},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0060_text_filtered.xwd\"", "label": "WPS_EXCEL_CAPTURE_TEXT_FILTER"},
    {"type": "key", "key": "ctrl+s", "name": "wps", "label": "WPS_EXCEL_SAVE_TEXT_FILTER"},
    {"type": "wait", "seconds": 2},
    {"type": "shell", "command": "cp \"${WPS_EXCEL_FILE}\" \"${PROJECT_ROOT}/outputs/wps/spreadsheet_0060_text_filtered.xlsx\"", "label": "WPS_EXCEL_CHECKPOINT_TEXT_FILTER"},
    {"type": "key", "key": "alt+Down", "name": "wps", "label": "WPS_EXCEL_S4_REOPEN_TEXT_FILTER"},
    {"type": "wait", "seconds": 1},
    {"type": "click", "x": 795, "y": 331, "label": "WPS_EXCEL_S4_CANCEL_TEXT_FILTER"},
    {"type": "wait", "seconds": 2},

    {"type": "click", "x": 213, "y": 257, "label": "WPS_EXCEL_S5_SELECT_SORT_COLUMN"},
    {"type": "key", "key": "alt+Down", "name": "wps", "label": "WPS_EXCEL_S5_OPEN_SORT_MENU"},
    {"type": "wait", "seconds": 1},
    {"type": "click", "x": 310, "y": 292, "label": "WPS_EXCEL_S5_SORT_ASCENDING"},
    {"type": "wait", "seconds": 5},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0060_sorted.xwd\"", "label": "WPS_EXCEL_CAPTURE_SORTED"},

    {"type": "click", "x": 1082, "y": 230, "label": "WPS_EXCEL_S6_SELECT_COLUMN_10"},
    {"type": "key", "key": "ctrl+c", "name": "wps", "label": "WPS_EXCEL_S6_COPY_COLUMN_10"},
    {"type": "key", "key": "ctrl+plus", "name": "wps", "label": "WPS_EXCEL_S6_INSERT_COPIED_COLUMN"},
    {"type": "wait", "seconds": 3},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0060_copied_column.xwd\"", "label": "WPS_EXCEL_CAPTURE_COPIED_COLUMN"},

    {"type": "goto_cell", "method": "name_box", "name": "wps", "class": "et|wpsoffice", "reference": "L1", "label": "WPS_EXCEL_S7_SELECT_FORMULA_COLUMN"},
    {"type": "key", "key": "ctrl+space", "name": "wps", "label": "WPS_EXCEL_S7_SELECT_ENTIRE_FORMULA_COLUMN"},
    {"type": "key", "key": "ctrl+plus", "name": "wps", "label": "WPS_EXCEL_S7_INSERT_BLANK_COLUMN"},
    {"type": "goto_cell", "method": "name_box", "name": "wps", "class": "et|wpsoffice", "reference": "L1", "label": "WPS_EXCEL_S7_FORMULA_HEADER_CELL"},
    {"type": "paste_text", "text": "两列之和", "name": "wps", "label": "WPS_EXCEL_S7_FORMULA_HEADER"},
    {"type": "goto_cell", "method": "name_box", "name": "wps", "class": "et|wpsoffice", "reference": "L2", "label": "WPS_EXCEL_S7_FIRST_FORMULA_CELL"},
    {"type": "paste_text", "text": "=A2+B2", "name": "wps", "label": "WPS_EXCEL_S7_ENTER_SUM_FORMULA"},
    {"type": "goto_cell", "method": "name_box", "name": "wps", "class": "et|wpsoffice", "reference": "L2:L81", "label": "WPS_EXCEL_S7_SELECT_FORMULA_RANGE"},
    {"type": "key", "key": "ctrl+d", "name": "wps", "label": "WPS_EXCEL_S7_FILL_FORMULA_DOWN"},
    {"type": "key", "key": "ctrl+s", "name": "wps", "label": "WPS_EXCEL_S7_SAVE_FORMULAS"},
    {"type": "wait", "seconds": 3},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0060_formula_filled.xwd\"", "label": "WPS_EXCEL_CAPTURE_FORMULA_FILLED"},

    {"type": "key", "key": "shift+F11", "name": "wps", "label": "WPS_EXCEL_S8_NEW_SHEET"},
    {"type": "key", "key": "ctrl+Page_Down", "name": "wps", "label": "WPS_EXCEL_S8_RETURN_ORIGINAL_SHEET"},
    {"type": "key", "key": "ctrl+a", "repeat": 2, "name": "wps", "label": "WPS_EXCEL_S8_SELECT_ALL_ORIGINAL"},
    {"type": "key", "key": "ctrl+c", "name": "wps", "label": "WPS_EXCEL_S8_COPY_ORIGINAL"},
    {"type": "key", "key": "ctrl+Page_Up", "name": "wps", "label": "WPS_EXCEL_S8_RETURN_NEW_SHEET"},
    {"type": "key", "key": "ctrl+v", "name": "wps", "label": "WPS_EXCEL_S8_PASTE_TO_NEW_SHEET"},
    {"type": "wait", "seconds": 4},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0060_new_sheet_pasted.xwd\"", "label": "WPS_EXCEL_CAPTURE_NEW_SHEET_PASTED"},

    {"type": "key", "key": "ctrl+a", "repeat": 2, "name": "wps", "label": "WPS_EXCEL_S9_SELECT_ALL_NEW_SHEET"},
    {"type": "click", "x": 320, "y": 124, "label": "WPS_EXCEL_S9_FONT_NAME_BOX"},
    {"type": "key", "key": "ctrl+a", "name": "wps"},
    {"type": "paste_text", "text": "${EXCEL_FONT_NAME}", "name": "wps", "label": "WPS_EXCEL_S9_FONT_NAME"},
    {"type": "key", "key": "Return", "name": "wps", "label": "WPS_EXCEL_S9_APPLY_FONT_NAME"},
    {"type": "wait", "seconds": 2},
    {"type": "click", "x": 420, "y": 124, "label": "WPS_EXCEL_S9_FONT_SIZE_BOX"},
    {"type": "key", "key": "ctrl+a", "name": "wps"},
    {"type": "paste_text", "text": "14", "name": "wps", "label": "WPS_EXCEL_S9_FONT_SIZE"},
    {"type": "key", "key": "Return", "name": "wps", "label": "WPS_EXCEL_S9_APPLY_FONT_SIZE"},
    {"type": "key", "key": "ctrl+s", "name": "wps", "label": "WPS_EXCEL_S9_SAVE_FONT"},
    {"type": "wait", "seconds": 4},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0060_font_14.xwd\"", "label": "WPS_EXCEL_CAPTURE_FONT_14"},

    {"type": "goto_cell", "method": "name_box", "name": "wps", "class": "et|wpsoffice", "reference": "A1", "label": "WPS_EXCEL_SCROLL_START_CELL"},
    {"type": "scroll", "name": "wps", "class": "et|wpsoffice", "direction": "down", "amount": 3, "label": "WPS_EXCEL_S10_SCROLL_DOWN_3"},
    {"type": "wait", "seconds": 2},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0060_scrolled_down.xwd\"", "label": "WPS_EXCEL_CAPTURE_SCROLLED_DOWN"},
    {"type": "scroll", "name": "wps", "class": "et|wpsoffice", "direction": "up", "amount": 3, "label": "WPS_EXCEL_S10_SCROLL_UP_3"},
    {"type": "wait", "seconds": 2},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0060_scrolled_up.xwd\"", "label": "WPS_EXCEL_CAPTURE_SCROLLED_UP"},

    {"type": "key", "key": "ctrl+End", "name": "wps", "label": "WPS_EXCEL_S11_LAST_CELL"},
    {"type": "wait", "seconds": 3},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0060_last_cell.xwd\"", "label": "WPS_EXCEL_CAPTURE_LAST_CELL"},
    {"type": "key", "key": "ctrl+Home", "name": "wps", "label": "WPS_EXCEL_S12_FIRST_CELL"},
    {"type": "wait", "seconds": 3},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0060_first_cell.xwd\"", "label": "WPS_EXCEL_CAPTURE_FIRST_CELL"},

    {"type": "window_state", "name": "wps", "class": "et|wpsoffice", "state": "maximize", "label": "WPS_EXCEL_S13_MAXIMIZE"},
    {"type": "wait", "seconds": 10, "label": "WPS_EXCEL_S13_WAIT_10_SECONDS"},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0060_maximized.xwd\"", "label": "WPS_EXCEL_CAPTURE_MAXIMIZED"},
    {"type": "key", "key": "ctrl+w", "name": "wps", "label": "WPS_EXCEL_S14_CLOSE_TAB"},
    {"type": "wait", "seconds": 4},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0060_tab_closed.xwd\"", "label": "WPS_EXCEL_CAPTURE_TAB_CLOSED"},
    {"type": "close", "name": "et", "class": "et|wpsoffice", "process_names": ["wpsoffice", "et"], "path_contains": ["/opt/kingsoft/wps-office"], "force_after_seconds": 3, "label": "WPS_EXCEL_S15_CLOSE_WPS"}
  ]
}
