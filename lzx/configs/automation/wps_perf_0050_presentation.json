{
  "description": "Perf_WPS_0050：固定5页开始，放映5页并返回首页，退出后按S7/S8/S9新增3页，完成图片缩放和WPS原生视频播放，再删除3页恢复为5页。",
  "variables": {
    "WPS_PPT_SOURCE": "${PROJECT_ROOT}/samples/wps/presentation_200m.pptx",
    "WPS_PPT_FILE": "${PROJECT_ROOT}/outputs/wps/presentation_0050_ui.pptx",
    "WPS_PPT_BASE_SNAPSHOT": "${PROJECT_ROOT}/outputs/wps/presentation_0050_base_five.pptx",
    "WPS_PPT_CHECKPOINT": "${PROJECT_ROOT}/outputs/wps/presentation_0050_with_three_added.pptx",
    "WPS_PPT_CHECKPOINT_FILENAME": "presentation_0050_with_three_added.pptx",
    "WPS_PPT_FINAL_FILENAME": "presentation_0050_ui.pptx",
    "WPS_IMAGE_FILE": "${PROJECT_ROOT}/samples/wps/visible_paste_test.png",
    "WPS_VIDEO_FILE": "${PROJECT_ROOT}/samples/wps/video_5s_test.mp4",
    "WPS_PPT_LOAD_SECONDS": "15",
    "PPT_NAV_X": "0.10",
    "PPT_NAV_LAST_Y": "0.88"
  },
  "actions": [
    {"type": "shell", "command": "mkdir -p \"${PROJECT_ROOT}/outputs/wps\" \"${PROJECT_ROOT}/outputs/runtime_monitor\" && rm -f \"${WPS_PPT_FILE}\" \"${WPS_PPT_BASE_SNAPSHOT}\" \"${WPS_PPT_CHECKPOINT}\" \"${PROJECT_ROOT}/outputs/runtime_monitor/0050_\"*.xwd && python3 \"${PROJECT_ROOT}/automation/insert_video_into_ppt.py\" --prepare-base \"${WPS_PPT_SOURCE}\" --output \"${WPS_PPT_FILE}\" --slide-count 5 && cp \"${WPS_PPT_FILE}\" \"${WPS_PPT_BASE_SNAPSHOT}\"", "label": "WPS_PPT_PREPARE_EXACTLY_FIVE_BASE_SLIDES"},
    {"type": "assert_file", "path": "${WPS_PPT_FILE}", "label": "WPS_REQUIRE_FIVE_SLIDE_PPT"},
    {"type": "assert_file", "path": "${WPS_PPT_BASE_SNAPSHOT}", "label": "WPS_REQUIRE_FIVE_SLIDE_BASE_SNAPSHOT"},
    {"type": "assert_file", "path": "${WPS_IMAGE_FILE}", "label": "WPS_REQUIRE_IMAGE_SAMPLE"},
    {"type": "assert_file", "path": "${WPS_VIDEO_FILE}", "label": "WPS_REQUIRE_VIDEO_SAMPLE"},

    {"type": "launch", "name": "wpp", "command": "wpp", "label": "WPS_PPT_S1_LAUNCH"},
    {"type": "wait_window", "name": "wps", "class": "wpp|wpsoffice", "timeout": 45, "label": "WPS_PPT_WAIT_HOME"},
    {"type": "shell", "command": "wmctrl -r :ACTIVE: -b add,maximized_vert,maximized_horz", "label": "WPS_PPT_MAXIMIZE_HOME"},
    {"type": "wait", "seconds": 4},
    {"type": "open_file", "path": "${WPS_PPT_FILE}", "name": "wps", "class": "wpp|wpsoffice", "shortcut": "ctrl+o", "wait_before": 2, "wait_after": 3, "label": "WPS_PPT_S2_OPEN_FILE"},
    {"type": "wait", "seconds": "${WPS_PPT_LOAD_SECONDS}", "label": "WPS_PPT_S2_OPEN_FIVE_SLIDES"},
    {"type": "wait_window", "name": "wps", "title": "presentation_0050_ui", "timeout": 45, "label": "WPS_PPT_ASSERT_DOCUMENT_WINDOW"},
    {"type": "shell", "command": "wmctrl -r :ACTIVE: -b add,maximized_vert,maximized_horz", "label": "WPS_PPT_MAXIMIZE_EDITOR"},
    {"type": "shell", "command": "xdotool mousemove 1260 780 && xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0050_initial_five.xwd\"", "label": "WPS_PPT_CAPTURE_INITIAL_FIVE"},
    {"type": "click", "x": 180, "y": 245, "label": "WPS_PPT_FOCUS_SLIDE_LIST_BEFORE_SHOW"},
    {"type": "key", "key": "ctrl+Home", "name": "wps", "label": "WPS_PPT_SELECT_FIRST_SLIDE_BEFORE_SHOW"},

    {"type": "key", "key": "F5", "name": "wps", "label": "WPS_PPT_S3_SLIDESHOW_START"},
    {"type": "wait", "seconds": 3, "label": "WPS_PPT_SHOW_SLIDE_1"},
    {"type": "key", "key": "Right", "name": "wps", "label": "WPS_PPT_SHOW_SLIDE_2"},
    {"type": "wait", "seconds": 1},
    {"type": "key", "key": "Right", "name": "wps", "label": "WPS_PPT_SHOW_SLIDE_3"},
    {"type": "wait", "seconds": 1},
    {"type": "key", "key": "Right", "name": "wps", "label": "WPS_PPT_SHOW_SLIDE_4"},
    {"type": "wait", "seconds": 1},
    {"type": "key", "key": "Right", "name": "wps", "label": "WPS_PPT_SHOW_SLIDE_5"},
    {"type": "wait", "seconds": 2},
    {"type": "key", "key": "Left", "name": "wps", "label": "WPS_PPT_RETURN_SLIDE_4"},
    {"type": "wait", "seconds": 1},
    {"type": "key", "key": "Left", "name": "wps", "label": "WPS_PPT_RETURN_SLIDE_3"},
    {"type": "wait", "seconds": 1},
    {"type": "key", "key": "Left", "name": "wps", "label": "WPS_PPT_RETURN_SLIDE_2"},
    {"type": "wait", "seconds": 1},
    {"type": "key", "key": "Left", "name": "wps", "label": "WPS_PPT_RETURN_HOME_SLIDE"},
    {"type": "wait", "seconds": 2},
    {"type": "key", "key": "Escape", "name": "wps", "label": "WPS_PPT_S4_EXIT_SLIDESHOW"},
    {"type": "wait", "seconds": 3},
    {"type": "shell", "command": "wmctrl -r :ACTIVE: -b add,maximized_vert,maximized_horz", "label": "WPS_PPT_REMAXIMIZE_AFTER_SLIDESHOW"},
    {"type": "wait", "seconds": 2},

    {"type": "shell", "command": "xdotool mousemove 800 450 click 4 click 4 click 4", "label": "WPS_PPT_S5_BODY_SCROLL_UP_3"},
    {"type": "shell", "command": "xdotool mousemove 800 450 click 5 click 5 click 5", "label": "WPS_PPT_S5_BODY_SCROLL_DOWN_3"},
    {"type": "click", "x": 180, "y": 425, "label": "WPS_PPT_S6_NAVIGATION_FOCUS"},
    {"type": "key", "key": "ctrl+End", "name": "wps", "label": "WPS_PPT_S6_SELECT_LAST_SLIDE"},

    {"type": "key", "key": "ctrl+c", "name": "wps", "label": "WPS_PPT_S7_COPY_LAST_SLIDE"},
    {"type": "key", "key": "ctrl+v", "name": "wps", "label": "WPS_PPT_S7_DUPLICATE_LAST_SLIDE"},
    {"type": "wait", "seconds": 2},

    {"type": "key", "key": "ctrl+m", "name": "wps", "label": "WPS_PPT_S8_NEW_IMAGE_SLIDE"},
    {"type": "wait", "seconds": 2},
    {"type": "click", "x": 510, "y": 82, "label": "WPS_PPT_S8_OPEN_INSERT_TAB"},
    {"type": "click", "x": 312, "y": 126, "label": "WPS_PPT_S8_OPEN_IMAGE_MENU"},
    {"type": "click", "x": 355, "y": 194, "label": "WPS_PPT_S8_CHOOSE_LOCAL_IMAGE"},
    {"type": "dialog_path", "path": "${WPS_IMAGE_FILE}", "wait_before": 2, "wait_after": 6, "label": "WPS_PPT_S8_INSERT_IMAGE"},
    {"type": "wait", "seconds": 5},
    {"type": "shell", "command": "xdotool mousemove 1260 780 && xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0050_image_inserted.xwd\"", "label": "WPS_PPT_CAPTURE_IMAGE_INSERTED"},
    {"type": "click", "x": 750, "y": 450, "label": "WPS_PPT_S8_SELECT_IMAGE_FOR_RESIZE"},
    {"type": "wait", "seconds": 1},
    {"type": "drag", "x1": 1196, "y1": 700, "x2": 900, "y2": 520, "duration_ms": 1500, "label": "WPS_PPT_S8_SHRINK_IMAGE_VISIBLE"},
    {"type": "wait", "seconds": 3},
    {"type": "shell", "command": "xdotool mousemove 1260 780 && xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0050_image_small.xwd\"", "label": "WPS_PPT_CAPTURE_IMAGE_SMALL"},
    {"type": "drag", "x1": 900, "y1": 520, "x2": 1180, "y2": 680, "duration_ms": 1500, "label": "WPS_PPT_S8_ENLARGE_IMAGE_VISIBLE"},
    {"type": "wait", "seconds": 3},
    {"type": "shell", "command": "xdotool mousemove 1260 780 && xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0050_image_large.xwd\"", "label": "WPS_PPT_CAPTURE_IMAGE_LARGE"},

    {"type": "key", "key": "ctrl+m", "name": "wps", "label": "WPS_PPT_S9_NEW_VIDEO_SLIDE"},
    {"type": "wait", "seconds": 2},
    {"type": "click", "x": 510, "y": 82, "label": "WPS_PPT_S9_OPEN_INSERT_TAB_FOR_VIDEO"},
    {"type": "click", "x": 657, "y": 126, "label": "WPS_PPT_S9_OPEN_VIDEO_DIALOG"},
    {"type": "dialog_path", "path": "${WPS_VIDEO_FILE}", "wait_before": 2, "wait_after": 8, "label": "WPS_PPT_S9_INSERT_VIDEO"},
    {"type": "wait", "seconds": 8},
    {"type": "shell", "command": "xdotool mousemove 1260 780 && xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0050_video_inserted.xwd\"", "label": "WPS_PPT_CAPTURE_VIDEO_INSERTED"},
    {"type": "click", "x": 448, "y": 82, "label": "WPS_PPT_S9_OPEN_INSERT_TAB_FOR_RECTANGLE"},
    {"type": "click", "x": 356, "y": 126, "label": "WPS_PPT_S9_OPEN_SHAPE_MENU"},
    {"type": "click", "x": 357, "y": 286, "label": "WPS_PPT_S9_SELECT_RECTANGLE"},
    {"type": "drag", "x1": 950, "y1": 560, "x2": 1050, "y2": 620, "duration_ms": 1000, "label": "WPS_PPT_S9_DRAW_RECTANGLE"},
    {"type": "wait", "seconds": 2},
    {"type": "drag", "x1": 1049, "y1": 621, "x2": 1165, "y2": 680, "duration_ms": 1200, "label": "WPS_PPT_S9_RESIZE_RECTANGLE"},
    {"type": "wait", "seconds": 2},
    {"type": "shell", "command": "xdotool mousemove 1260 780 && xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0050_video_and_rectangle.xwd\"", "label": "WPS_PPT_CAPTURE_VIDEO_AND_RECTANGLE"},

    {"type": "key", "key": "Escape", "name": "wps", "label": "WPS_PPT_S11_CLEAR_OBJECT_SELECTION"},
    {"type": "click", "x": 123, "y": 82, "label": "WPS_PPT_S11_FILE_MENU"},
    {"type": "wait", "seconds": 3},
    {"type": "click", "x": 160, "y": 263, "label": "WPS_PPT_S11_SAVE_WITH_THREE_ADDED"},
    {"type": "wait", "seconds": 3},
    {"type": "click", "x": 305, "y": 638, "label": "WPS_PPT_S11_ORIGINAL_LOCATION"},
    {"type": "wait", "seconds": 2},
    {"type": "click", "x": 700, "y": 560, "label": "WPS_PPT_S11_FILENAME_BOX"},
    {"type": "key", "key": "ctrl+a", "name": "wps"},
    {"type": "paste_text", "text": "${WPS_PPT_CHECKPOINT_FILENAME}", "name": "wps"},
    {"type": "click", "x": 1012, "y": 640, "label": "WPS_PPT_S11_SAVE_CONFIRM"},
    {"type": "wait", "seconds": 8},
    {"type": "assert_file", "path": "${WPS_PPT_CHECKPOINT}", "label": "WPS_PPT_CHECKPOINT_EIGHT_SLIDES"},
    {"type": "shell", "command": "python3 \"${PROJECT_ROOT}/automation/verify_0050_pptx.py\" \"${WPS_PPT_CHECKPOINT}\" --slides 8 --require-image --require-video --require-rectangle-on-last", "label": "WPS_PPT_VERIFY_EIGHT_SLIDE_STRUCTURE"},

    {"type": "click", "x": 952, "y": 785, "label": "WPS_PPT_S12_PLAY_CURRENT_VIDEO_SLIDE"},
    {"type": "wait", "seconds": 6},
    {"type": "shell", "command": "xdotool mousemove 640 730 && xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0050_video_show_ready.xwd\"", "label": "WPS_PPT_CAPTURE_VIDEO_SHOW_READY"},
    {"type": "click", "x": 640, "y": 380, "label": "WPS_PPT_NATIVE_VIDEO_PLAY"},
    {"type": "wait", "seconds": 1},
    {"type": "shell", "command": "xdotool mousemove 640 730 && xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0050_video_t1.xwd\"", "label": "WPS_PPT_CAPTURE_VIDEO_T1"},
    {"type": "wait", "seconds": 3},
    {"type": "shell", "command": "xdotool mousemove 640 730 && xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0050_video_t4.xwd\"", "label": "WPS_PPT_CAPTURE_VIDEO_T4"},
    {"type": "wait", "seconds": 2},
    {"type": "key", "key": "Escape", "name": "wps", "label": "WPS_PPT_STOP_NATIVE_VIDEO"},
    {"type": "wait", "seconds": 1},
    {"type": "key", "key": "Escape", "name": "wps", "label": "WPS_PPT_EXIT_VIDEO_SLIDESHOW"},
    {"type": "wait", "seconds": 4},
    {"type": "shell", "command": "xdotool mousemove 1260 780 && xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0050_returned_to_editor.xwd\"", "label": "WPS_PPT_CAPTURE_RETURNED_TO_EDITOR"},

    {"type": "shell", "command": "xdotool mousemove 1260 780 && xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0050_before_delete.xwd\"", "label": "WPS_PPT_CAPTURE_EIGHT_BEFORE_DELETE"},
    {"type": "click", "x": 180, "y": 715, "label": "WPS_PPT_FOCUS_LAST_THUMBNAIL"},
    {"type": "key", "key": "ctrl+End", "name": "wps", "label": "WPS_PPT_SELECT_LAST_NEW_SLIDE"},
    {"type": "key", "key": "Delete", "name": "wps", "label": "WPS_PPT_DELETE_NEW_SLIDE_1"},
    {"type": "wait", "seconds": 2},
    {"type": "key", "key": "Delete", "name": "wps", "label": "WPS_PPT_DELETE_NEW_SLIDE_2"},
    {"type": "wait", "seconds": 2},
    {"type": "key", "key": "Delete", "name": "wps", "label": "WPS_PPT_DELETE_NEW_SLIDE_3"},
    {"type": "wait", "seconds": 3},
    {"type": "shell", "command": "xdotool mousemove 1260 780 && xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0050_after_delete.xwd\"", "label": "WPS_PPT_CAPTURE_FIVE_AFTER_DELETE"},

    {"type": "shell", "command": "rm -f \"${WPS_PPT_FILE}\"", "label": "WPS_PPT_PREPARE_FINAL_SAVE_PATH"},
    {"type": "key", "key": "Escape", "name": "wps", "label": "WPS_PPT_S14_CLEAR_SELECTION"},
    {"type": "click", "x": 123, "y": 82, "label": "WPS_PPT_S14_FILE_MENU"},
    {"type": "wait", "seconds": 3},
    {"type": "click", "x": 160, "y": 263, "label": "WPS_PPT_S14_SAVE_AFTER_DELETE"},
    {"type": "wait", "seconds": 3},
    {"type": "click", "x": 305, "y": 638, "label": "WPS_PPT_S14_ORIGINAL_LOCATION"},
    {"type": "wait", "seconds": 2},
    {"type": "click", "x": 700, "y": 560, "label": "WPS_PPT_S14_FILENAME_BOX"},
    {"type": "key", "key": "ctrl+a", "name": "wps"},
    {"type": "paste_text", "text": "${WPS_PPT_FINAL_FILENAME}", "name": "wps"},
    {"type": "click", "x": 1012, "y": 640, "label": "WPS_PPT_S14_SAVE_CONFIRM"},
    {"type": "wait", "seconds": 8},
    {"type": "assert_file", "path": "${WPS_PPT_FILE}", "label": "WPS_PPT_VERIFY_FINAL_FILE"},
    {"type": "shell", "command": "python3 \"${PROJECT_ROOT}/automation/verify_0050_pptx.py\" \"${WPS_PPT_FILE}\" --slides 5", "label": "WPS_PPT_VERIFY_FINAL_FIVE_SLIDES"},
    {"type": "shell", "command": "wmctrl -r :ACTIVE: -b add,maximized_vert,maximized_horz", "label": "WPS_PPT_S16_MAXIMIZE"},
    {"type": "wait", "seconds": 10, "label": "WPS_PPT_S16_WAIT_10_SECONDS"},
    {"type": "key", "key": "ctrl+w", "name": "wps", "label": "WPS_PPT_S17_CLOSE_DOCUMENT_TAB"},
    {"type": "wait", "seconds": 2},
    {"type": "close", "name": "wpp", "class": "wpp|wpsoffice", "process_names": ["wpsoffice", "wpp"], "path_contains": ["/opt/kingsoft/wps-office"], "force_after_seconds": 3, "label": "WPS_CLOSE"}
  ]
}
