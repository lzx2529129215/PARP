{
  "description": "Perf_WPS_0020 新建并保存 Writer、Presentation 和 Spreadsheets 文档。",
  "variables": {
    "WPS_NEW_WORD_OUTPUT": "${PROJECT_ROOT}/outputs/wps/new_word.docx",
    "WPS_NEW_PPT_OUTPUT": "${PROJECT_ROOT}/outputs/wps/new_presentation.pptx",
    "WPS_NEW_EXCEL_OUTPUT": "${PROJECT_ROOT}/outputs/wps/new_spreadsheet.xlsx",
    "WPS_PPT_BODY_X": "0.55",
    "WPS_PPT_BODY_Y": "0.56"
  },
  "actions": [
    {"type": "launch", "name": "wps_writer", "command": "wps", "label": "WPS_WRITER_LAUNCH"},
    {"type": "wait_window", "name": "wps", "class": "wps|wpsoffice", "timeout": 20},
    {"type": "wait", "seconds": 20, "label": "WPS_WORD_HOME_READY"},
    {"type": "click", "x": 270, "y": 158, "label": "WPS_HOME_NEW_WORD"},
    {"type": "wait", "seconds": 18},
    {"type": "click", "x": 460, "y": 289, "label": "WPS_NEW_WORD"},
    {"type": "wait", "seconds": 18},
    {"type": "click", "x": 590, "y": 397, "label": "WPS_WORD_BLANK_DOCUMENT"},
    {"type": "wait", "seconds": 10},
    {"type": "paste_text", "text": "今天是加倍努力的一天", "name": "wps", "label": "WPS_WORD_TITLE"},
    {"type": "key", "key": "Return"},
    {"type": "paste_text", "text": "今天的工作从明确目标开始。我们会认真分析任务，合理安排时间，持续检查结果，在遇到问题时及时记录并寻找解决办法。通过稳定的积累和不断复盘，每一步努力都会转化为可靠的进步。", "repeat": 8, "separator": "\n", "name": "wps", "label": "WPS_WORD_BODY_500_CHARS"},
    {"type": "save_as", "name": "wps", "class": "wps|wpsoffice", "path": "${WPS_NEW_WORD_OUTPUT}", "menu_click": true, "location_shortcut": "", "confirm_count": 2, "wait_after": 4, "label": "WPS_WORD_SAVE"},
    {"type": "window_state", "name": "wps", "class": "wps|wpsoffice", "state": "maximize", "label": "WPS_WORD_MAXIMIZE_BEFORE_CLOSE"},
    {"type": "key", "key": "ctrl+w", "name": "wps", "label": "WPS_WORD_TAB_CLOSE"},
    {"type": "close", "name": "wps_writer", "class": "wps|wpsoffice", "process_names": ["wpsoffice", "wps"], "path_contains": ["/opt/kingsoft/wps-office"], "force_after_seconds": 3, "label": "WPS_WORD_CLOSE"},
    {"type": "wait", "seconds": 2},

    {"type": "launch", "name": "wps_presentation", "command": "wpp", "label": "WPS_PRESENTATION_LAUNCH"},
    {"type": "wait_window", "name": "wps", "class": "wpp|wps|wpsoffice", "timeout": 20},
    {"type": "wait", "seconds": 20, "label": "WPS_PPT_HOME_READY"},
    {"type": "click", "x": 270, "y": 158, "label": "WPS_HOME_NEW_PPT"},
    {"type": "wait", "seconds": 18},
    {"type": "click", "x": 534, "y": 289, "label": "WPS_NEW_PPT"},
    {"type": "wait", "seconds": 18},
    {"type": "click", "x": 590, "y": 397, "label": "WPS_PPT_BLANK_DOCUMENT"},
    {"type": "wait", "seconds": 10},
    {"type": "click_window", "name": "wps", "class": "wpp|wps|wpsoffice", "x_ratio": "${WPS_PPT_BODY_X}", "y_ratio": "${WPS_PPT_BODY_Y}", "label": "WPS_PPT_BODY_FOCUS"},
    {"type": "paste_text", "text": "保持专注能够让复杂任务逐渐清晰。每一次尝试都会带来新的经验，我们根据结果持续调整方法，把计划落实到行动中，并用耐心完成每一个细节。", "repeat": 3, "separator": "", "name": "wps", "label": "WPS_PPT_TEXT_150_CHARS"},
    {"type": "save_as", "name": "wps", "class": "wpp|wps|wpsoffice", "path": "${WPS_NEW_PPT_OUTPUT}", "menu_click": true, "location_shortcut": "", "confirm_count": 2, "wait_after": 4, "label": "WPS_PPT_SAVE"},
    {"type": "window_state", "name": "wps", "class": "wpp|wps|wpsoffice", "state": "maximize", "label": "WPS_PPT_MAXIMIZE_BEFORE_CLOSE"},
    {"type": "key", "key": "ctrl+w", "name": "wps", "label": "WPS_PPT_TAB_CLOSE"},
    {"type": "close", "name": "wps_presentation", "class": "wpp|wps|wpsoffice", "process_names": ["wpsoffice", "wpp"], "path_contains": ["/opt/kingsoft/wps-office"], "force_after_seconds": 3, "label": "WPS_PPT_CLOSE"},
    {"type": "wait", "seconds": 2},

    {"type": "launch", "name": "wps_spreadsheet", "command": "et", "label": "WPS_SPREADSHEET_LAUNCH"},
    {"type": "wait_window", "name": "wps", "class": "et|wps|wpsoffice", "timeout": 20},
    {"type": "wait", "seconds": 20, "label": "WPS_EXCEL_HOME_READY"},
    {"type": "click", "x": 270, "y": 158, "label": "WPS_HOME_NEW_EXCEL"},
    {"type": "wait", "seconds": 18},
    {"type": "click", "x": 608, "y": 289, "label": "WPS_NEW_EXCEL"},
    {"type": "wait", "seconds": 18},
    {"type": "click", "x": 590, "y": 397, "label": "WPS_EXCEL_BLANK_DOCUMENT"},
    {"type": "wait", "seconds": 10},
    {"type": "paste_text", "text": "第一行测试字符\n第二行测试字符", "name": "wps", "label": "WPS_EXCEL_TWO_ROWS"},
    {"type": "save_as", "name": "wps", "class": "et|wps|wpsoffice", "path": "${WPS_NEW_EXCEL_OUTPUT}", "menu_click": true, "location_shortcut": "", "confirm_count": 2, "wait_after": 4, "label": "WPS_EXCEL_SAVE"},
    {"type": "window_state", "name": "wps", "class": "et|wps|wpsoffice", "state": "maximize", "label": "WPS_EXCEL_MAXIMIZE_BEFORE_CLOSE"},
    {"type": "wait", "seconds": 2},
    {"type": "close", "name": "wps_spreadsheet", "class": "et|wps|wpsoffice", "process_names": ["wpsoffice", "wps", "wpp", "et", "wpspdf"], "path_contains": ["/opt/kingsoft/wps-office"], "force_after_seconds": 3, "label": "WPS_CLOSE"}
  ]
}
