# Run scripts/capture_gui_session_env.sh in a terminal opened inside the VM desktop.
# It creates .env.vm.local automatically. These values are examples only.
DISPLAY=:0
XAUTHORITY=/home/YOUR_USER/.Xauthority
XDG_RUNTIME_DIR=/run/user/1000
DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
XDG_SESSION_TYPE=x11
