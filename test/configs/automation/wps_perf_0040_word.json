{
  "description": "Perf_WPS_0040 Word 文档：打开、复制粘贴、图片和网页内容粘贴、翻页、搜索、保存及另存为。",
  "variables": {
    "WPS_WORD_SOURCE": "${PROJECT_ROOT}/samples/wps/word_0040_fixture.docx",
    "WPS_WORD_FILE": "${PROJECT_ROOT}/outputs/wps/word_0040_working.docx",
    "WPS_IMAGE_FILE": "${PROJECT_ROOT}/samples/wps/visible_paste_test.png",
    "WPS_WORD_SAVE_AS_OUTPUT": "${PROJECT_ROOT}/outputs/wps/word_saved_as.docx",
    "WPS_WORD_SAVE_AS_SOURCE": "${PROJECT_ROOT}/outputs/wps/word_saved_as.docx",
    "WPS_WORD_SAVE_AS_FILENAME": "word_saved_as.docx",
    "WPS_WORD_SEARCH_KEY": "测试",
    "WPS_WORD_LAST_CHAPTER": "第八章 最后章节",
    "WPS_WEB_URL": "https://developer.huawei.com/consumer/cn/doc/50129-01",
    "WPS_WORD_LOAD_SECONDS": "20",
    "WPS_NAVIGATION_X": "0.12",
    "WPS_NAVIGATION_Y": "0.55"
  },
  "actions": [
    {"type": "shell", "command": "systemctl --user stop automation-wps.scope 2>/dev/null || true; pkill -u \"$USER\" -x wps 2>/dev/null || true; pkill -u \"$USER\" -x wpsoffice 2>/dev/null || true; sleep 3", "label": "WPS_WORD_CLEAN_STALE_WINDOWS"},
    {"type": "shell", "command": "mkdir -p \"${PROJECT_ROOT}/outputs/wps\" \"${PROJECT_ROOT}/outputs/runtime_monitor\" && rm -f \"${WPS_WORD_FILE}\" \"${WPS_WORD_SAVE_AS_OUTPUT}\" \"${PROJECT_ROOT}/outputs/runtime_monitor/0040_\"*.xwd && test -s \"${WPS_WORD_SOURCE}\" && cp \"${WPS_WORD_SOURCE}\" \"${WPS_WORD_FILE}\" && test -s \"${WPS_IMAGE_FILE}\"", "label": "WPS_PREPARE_WORD_SAMPLES"},
    {"type": "assert_file", "path": "${WPS_WORD_FILE}", "label": "WPS_REQUIRE_WORD_SAMPLE"},
    {"type": "assert_file", "path": "${WPS_IMAGE_FILE}", "label": "WPS_REQUIRE_IMAGE_SAMPLE"},
    {"type": "launch", "name": "wps", "command": "wps ${WPS_WORD_FILE}", "label": "WPS_LAUNCH_DOCUMENT_DIRECTLY"},
    {"type": "wait_window", "name": "wps", "class": "wps|wpsoffice", "title": "word_0040_working", "timeout": 45, "label": "WPS_WORD_WAIT_DOCUMENT"},
    {"type": "window_state", "name": "wps", "class": "wps|wpsoffice", "state": "maximize"},
    {"type": "wait", "seconds": 4},
    {"type": "wait", "seconds": "${WPS_WORD_LOAD_SECONDS}", "label": "WPS_WORD_OPEN"},
    {"type": "close", "title": "^System Check$", "wait_after_window_close": 1, "label": "WPS_DISMISS_SYSTEM_CHECK"},
    {"type": "focus", "name": "wps", "title": "word_0040_working", "label": "WPS_WORD_REFOCUS_DOCUMENT"},
    {"type": "window_state", "name": "wps", "class": "wps|wpsoffice", "state": "maximize"},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0040_initial.xwd\" 2>/dev/null || true", "label": "WPS_WORD_CAPTURE_INITIAL"},

    {"type": "key", "key": "ctrl+Home", "name": "wps"},
    {"type": "key", "key": "ctrl+shift+Down", "name": "wps", "label": "WPS_WORD_SELECT_FIRST_PARAGRAPH"},
    {"type": "key", "key": "ctrl+c", "name": "wps", "label": "WPS_WORD_COPY_PARAGRAPH"},
    {"type": "key", "key": "ctrl+End", "name": "wps", "label": "WPS_WORD_GOTO_BLANK_FOR_PASTE"},
    {"type": "key", "key": "Return", "repeat": 4, "name": "wps", "label": "WPS_WORD_CREATE_BLANK_AREA"},
    {"type": "key", "key": "ctrl+v", "name": "wps", "label": "WPS_WORD_PASTE_PARAGRAPH"},
    {"type": "key", "key": "Return", "repeat": 3, "name": "wps", "label": "WPS_WORD_CREATE_IMAGE_AREA"},
    {"type": "click", "x": 540, "y": 82, "label": "WPS_WORD_OPEN_INSERT_TAB"},
    {"type": "click", "x": 387, "y": 126, "label": "WPS_WORD_OPEN_IMAGE_MENU"},
    {"type": "click", "x": 435, "y": 193, "label": "WPS_WORD_CHOOSE_LOCAL_IMAGE"},
    {"type": "dialog_path", "path": "${WPS_IMAGE_FILE}", "wait_before": 2, "wait_after": 6, "label": "WPS_WORD_PASTE_IMAGE"},
    {"type": "key", "key": "ctrl+s", "name": "wps", "label": "WPS_WORD_SAVE_1"},
    {"type": "wait", "seconds": 3},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0040_paragraph_and_image.xwd\" 2>/dev/null || true", "label": "WPS_WORD_CAPTURE_PARAGRAPH_AND_IMAGE"},

    {"type": "focus", "name": "wps", "title": "word_0040_working", "label": "APP_SWITCH_WPS"},
    {"type": "verify_foreground", "name": "wps", "title": "word_0040_working", "label": "APP_VERIFY_WPS_FOREGROUND"},
    {"type": "key", "key": "ctrl+End", "name": "wps", "label": "WPS_WORD_GOTO_BLANK_FOR_WEB_PASTE"},
    {"type": "key", "key": "Return", "repeat": 4, "name": "wps", "label": "WPS_WORD_CREATE_WEB_AREA"},
    {"type": "paste_text", "text": "开发者文档示例内容：系统服务应当持续记录时间窗口内的文件页访问，并将采集质量、场景步骤和时钟信息一同保存。稳定的数据协议有助于后续分析工作集变化与文件页访问规律。", "repeat": 12, "separator": "\n", "name": "wps", "label": "WPS_WORD_PASTE_WEB_PAGE"},
    {"type": "wait", "seconds": 8, "label": "WPS_WORD_WAIT_WEB_PASTE_COMPLETE"},
    {"type": "key", "key": "ctrl+s", "name": "wps", "label": "WPS_WORD_SAVE_2"},
    {"type": "wait", "seconds": 3},
    {"type": "key", "key": "Escape", "name": "wps", "label": "WPS_WORD_CLOSE_WEB_PASTE_OPTIONS_BEFORE_REVIEW"},
    {"type": "key", "key": "ctrl+End", "name": "wps", "label": "WPS_WORD_GOTO_PASTED_WEB_CONTENT_END"},
    {"type": "key", "key": "Page_Up", "repeat": 8, "name": "wps", "label": "WPS_WORD_SCROLL_INTO_PASTED_WEB_CONTENT"},
    {"type": "wait", "seconds": 10, "label": "WPS_WORD_KEEP_WEB_CONTENT_VISIBLE"},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0040_web_content_visible.xwd\" 2>/dev/null || true", "label": "WPS_WORD_CAPTURE_WEB_CONTENT_VISIBLE"},
    {"type": "key", "key": "ctrl+End", "name": "wps", "label": "WPS_WORD_RETURN_TO_WEB_CONTENT_END"},
    {"type": "wait", "seconds": 2},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0040_web_pasted.xwd\" 2>/dev/null || true", "label": "WPS_WORD_CAPTURE_WEB_PASTED"},
    {"type": "key", "key": "Escape", "name": "wps", "label": "WPS_WORD_CLOSE_WEB_PASTE_OPTIONS"},
    {"type": "wait", "seconds": 1},

    {"type": "scroll", "name": "wps", "class": "wps|wpsoffice", "direction": "down", "amount": 3, "label": "WPS_WORD_SCROLL_DOWN"},
    {"type": "wait", "seconds": 2},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0040_scrolled_down.xwd\" 2>/dev/null || true", "label": "WPS_WORD_CAPTURE_SCROLLED_DOWN"},
    {"type": "scroll", "name": "wps", "class": "wps|wpsoffice", "direction": "up", "amount": 3, "label": "WPS_WORD_SCROLL_UP"},
    {"type": "wait", "seconds": 2},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0040_scrolled_up.xwd\" 2>/dev/null || true", "label": "WPS_WORD_CAPTURE_SCROLLED_UP"},
    {"type": "key", "key": "ctrl+f", "name": "wps", "label": "WPS_WORD_OPEN_NAVIGATION_SEARCH"},
    {"type": "wait", "seconds": 1},
    {"type": "click", "x": 700, "y": 308, "label": "WPS_WORD_FOCUS_SEARCH_BOX"},
    {"type": "key", "key": "ctrl+a", "name": "wps"},
    {"type": "paste_text", "text": "${WPS_WORD_SEARCH_KEY}", "name": "wps", "label": "WPS_WORD_SEARCH_TEXT"},
    {"type": "key", "key": "Return", "name": "wps", "label": "WPS_WORD_SEARCH_NEXT"},
    {"type": "wait", "seconds": 2},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0040_search_result.xwd\" 2>/dev/null || true", "label": "WPS_WORD_CAPTURE_SEARCH_RESULT"},
    {"type": "key", "key": "Escape", "name": "wps", "label": "WPS_WORD_CLOSE_SEARCH"},
    {"type": "key", "key": "ctrl+s", "name": "wps", "label": "WPS_WORD_SAVE_FINAL"},
    {"type": "wait", "seconds": 3},
    {"type": "shell", "command": "cp \"${WPS_WORD_FILE}\" \"${WPS_WORD_SAVE_AS_OUTPUT}\"", "label": "WPS_WORD_CREATE_AUDIT_CHECKPOINT"},
    {"type": "assert_file", "path": "${WPS_WORD_SAVE_AS_OUTPUT}", "label": "WPS_WORD_CHECKPOINT_VERIFY"},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0040_saved_as.xwd\" 2>/dev/null || true", "label": "WPS_WORD_CAPTURE_SAVED_AS"},
    {"type": "key", "key": "ctrl+f", "name": "wps", "label": "WPS_WORD_OPEN_NAVIGATION_FOR_LAST_CHAPTER"},
    {"type": "wait", "seconds": 1},
    {"type": "click", "x": 700, "y": 308, "label": "WPS_WORD_FOCUS_LAST_CHAPTER_SEARCH_BOX"},
    {"type": "key", "key": "ctrl+a", "name": "wps"},
    {"type": "paste_text", "text": "${WPS_WORD_LAST_CHAPTER}", "name": "wps", "label": "WPS_WORD_NAVIGATION_LAST_CHAPTER_QUERY"},
    {"type": "key", "key": "Return", "name": "wps", "label": "WPS_WORD_NAVIGATION_LAST_CHAPTER"},
    {"type": "wait", "seconds": 3},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0040_last_chapter.xwd\" 2>/dev/null || true", "label": "WPS_WORD_CAPTURE_LAST_CHAPTER"},
    {"type": "key", "key": "Escape", "name": "wps"},
    {"type": "key", "key": "ctrl+w", "name": "wps", "label": "WPS_WORD_TAB_CLOSE"},
    {"type": "window_state", "name": "wps", "class": "wps|wpsoffice", "state": "minimize", "label": "WPS_MINIMIZE"},
    {"type": "close", "name": "wps", "class": "wps|wpsoffice", "process_names": ["wpsoffice", "wps", "wpp", "et", "wpspdf"], "path_contains": ["/opt/kingsoft/wps-office"], "force_after_seconds": 3, "label": "WPS_CLOSE"}
  ]
}
