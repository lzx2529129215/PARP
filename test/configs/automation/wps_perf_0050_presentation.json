{
  "description": "Perf_WPS_0050：加载固定5页演示文稿，正向和反向放映全部页面，在编辑视图中导航，执行最小化、恢复、最大化并保存。",
  "variables": {
    "WPS_PPT_SOURCE": "${PROJECT_ROOT}/samples/wps/presentation_200m.pptx",
    "WPS_PPT_FILE": "${PROJECT_ROOT}/outputs/wps/presentation_0050_ui.pptx",
    "WPS_PPT_LOAD_SECONDS": "15"
  },
  "actions": [
    {"type": "shell", "command": "mkdir -p \"${PROJECT_ROOT}/outputs/wps\" \"${PROJECT_ROOT}/outputs/runtime_monitor\" && rm -f \"${WPS_PPT_FILE}\" \"${PROJECT_ROOT}/outputs/runtime_monitor/0050_\"*.xwd && python3 \"${PROJECT_ROOT}/automation/insert_video_into_ppt.py\" --prepare-base \"${WPS_PPT_SOURCE}\" --output \"${WPS_PPT_FILE}\" --slide-count 5", "label": "WPS_PPT_PREPARE_FIVE_SLIDES"},
    {"type": "assert_file", "path": "${WPS_PPT_FILE}", "label": "WPS_REQUIRE_FIVE_SLIDE_PPT"},
    {"type": "shell", "command": "python3 \"${PROJECT_ROOT}/automation/verify_0050_pptx.py\" \"${WPS_PPT_FILE}\" --slides 5", "label": "WPS_PPT_VERIFY_INPUT_STRUCTURE"},

    {"type": "launch", "name": "wpp", "command": "wpp ${WPS_PPT_FILE}", "label": "WPS_PPT_LAUNCH_DOCUMENT_DIRECTLY"},
    {"type": "wait_window", "name": "wps", "class": "wpp|wpsoffice", "title": "presentation_0050_ui", "timeout": 45, "label": "WPS_PPT_WAIT_DOCUMENT"},
    {"type": "wait", "seconds": "${WPS_PPT_LOAD_SECONDS}", "label": "WPS_PPT_LOAD_FIVE_SLIDES"},
    {"type": "close", "title": "^System Check$", "wait_after_window_close": 1, "label": "WPS_DISMISS_SYSTEM_CHECK"},
    {"type": "focus", "name": "wps", "title": "presentation_0050_ui", "label": "WPS_PPT_FOCUS_DOCUMENT"},
    {"type": "window_state", "name": "wps", "title": "presentation_0050_ui", "state": "maximize", "label": "WPS_PPT_MAXIMIZE_EDITOR"},
    {"type": "shell", "command": "xwd -silent -root -out \"${PROJECT_ROOT}/outputs/runtime_monitor/0050_initial_five.xwd\" 2>/dev/null || true", "label": "WPS_PPT_CAPTURE_INITIAL_FIVE"},

    {"type": "key", "key": "ctrl+Home", "name": "wps", "label": "WPS_PPT_SELECT_FIRST_SLIDE"},
    {"type": "key", "key": "F5", "name": "wps", "label": "WPS_PPT_SLIDESHOW_START"},
    {"type": "wait", "seconds": 3, "label": "WPS_PPT_SHOW_SLIDE_1"},
    {"type": "key", "key": "Right", "name": "wps", "label": "WPS_PPT_SHOW_SLIDE_2"},
    {"type": "wait", "seconds": 2},
    {"type": "key", "key": "Right", "name": "wps", "label": "WPS_PPT_SHOW_SLIDE_3"},
    {"type": "wait", "seconds": 2},
    {"type": "key", "key": "Right", "name": "wps", "label": "WPS_PPT_SHOW_SLIDE_4"},
    {"type": "wait", "seconds": 2},
    {"type": "key", "key": "Right", "name": "wps", "label": "WPS_PPT_SHOW_SLIDE_5"},
    {"type": "wait", "seconds": 3},
    {"type": "key", "key": "Left", "name": "wps", "label": "WPS_PPT_RETURN_SLIDE_4"},
    {"type": "wait", "seconds": 2},
    {"type": "key", "key": "Left", "name": "wps", "label": "WPS_PPT_RETURN_SLIDE_3"},
    {"type": "wait", "seconds": 2},
    {"type": "key", "key": "Left", "name": "wps", "label": "WPS_PPT_RETURN_SLIDE_2"},
    {"type": "wait", "seconds": 2},
    {"type": "key", "key": "Left", "name": "wps", "label": "WPS_PPT_RETURN_SLIDE_1"},
    {"type": "wait", "seconds": 3},
    {"type": "key", "key": "Escape", "name": "wps", "label": "WPS_PPT_EXIT_SLIDESHOW"},
    {"type": "wait", "seconds": 4},

    {"type": "focus", "name": "wps", "title": "presentation_0050_ui", "label": "WPS_PPT_REFOCUS_EDITOR"},
    {"type": "key", "key": "ctrl+End", "name": "wps", "label": "WPS_PPT_EDITOR_LAST_SLIDE"},
    {"type": "wait", "seconds": 3},
    {"type": "key", "key": "ctrl+Home", "name": "wps", "label": "WPS_PPT_EDITOR_FIRST_SLIDE"},
    {"type": "wait", "seconds": 3},
    {"type": "window_state", "name": "wps", "title": "presentation_0050_ui", "state": "minimize", "label": "WPS_PPT_MINIMIZE"},
    {"type": "wait", "seconds": 3},
    {"type": "window_state", "name": "wps", "title": "presentation_0050_ui", "state": "restore", "label": "WPS_PPT_RESTORE"},
    {"type": "window_state", "name": "wps", "title": "presentation_0050_ui", "state": "maximize", "label": "WPS_PPT_MAXIMIZE"},
    {"type": "wait", "seconds": 10, "label": "WPS_PPT_MAXIMIZED_WAIT"},
    {"type": "key", "key": "ctrl+s", "name": "wps", "label": "WPS_PPT_SAVE"},
    {"type": "wait", "seconds": 4},
    {"type": "assert_file", "path": "${WPS_PPT_FILE}", "label": "WPS_PPT_VERIFY_SAVED_FILE"},
    {"type": "shell", "command": "python3 \"${PROJECT_ROOT}/automation/verify_0050_pptx.py\" \"${WPS_PPT_FILE}\" --slides 5", "label": "WPS_PPT_VERIFY_FINAL_STRUCTURE"},
    {"type": "key", "key": "ctrl+w", "name": "wps", "label": "WPS_PPT_CLOSE_DOCUMENT_TAB"},
    {"type": "wait", "seconds": 2},
    {"type": "close", "name": "wpp", "class": "wpp|wpsoffice", "process_names": ["wpsoffice", "wpp"], "path_contains": ["/opt/kingsoft/wps-office"], "force_after_seconds": 3, "label": "WPS_CLOSE"}
  ]
}
