Linux6.17/

# Python/test caches are local generated artifacts.  # lzx-note
__pycache__/
*.py[cod]
.pytest_cache/

# Experiment captures can contain multi-gigabyte traces.  Keep the runners,
# configurations, and curated Markdown reports in Git, not raw output.  # lzx-note
/test/outputs/

# R8-LLM pins these machine-local artifacts by SHA-256 in its JSON config.
# Do not put the multi-gigabyte GGUF or compiled llama.cpp tree in Git.  # lzx-note
/test/tools/llama.cpp/
/test/models/r8/*.gguf

# The boot-time monitor continuously writes bounded/rotated runtime captures;
# those captures remain machine-local.  # lzx-note
/lzx/service/outputs/
