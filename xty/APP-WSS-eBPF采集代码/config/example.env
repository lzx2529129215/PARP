# Copy to a private .env file or export before optional WPS automation.
# Large sample documents are deliberately not included in this repository.
WPS_SAMPLES_DIR=/path/to/wps-samples
PHASE9_PPT=/path/to/wps-samples/presentation.pptx
PHASE9_EXCEL=/path/to/wps-samples/workbook.xlsx
PHASE9_WORD=/path/to/wps-samples/document.docx
PHASE9_IMAGE=/path/to/wps-samples/image.png
PHASE9_WORD_SAVE=./runs/wps_word_saved.docx

# GUI variables are installation-specific.  Export values from the active GUI
# session rather than copying a UID- or display-specific value from another host.
DISPLAY=
XAUTHORITY=
XDG_RUNTIME_DIR=
DBUS_SESSION_BUS_ADDRESS=
